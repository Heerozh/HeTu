#: hetu/headless.py:83
#, python-brace-format
msgid ""
"实例 {instance} 里不存在组件表 {comp_name}：请先启动 HeTu 服务器建表（或检查 instance / 组件名 / "
"后端配置是否指向同一个数据库）"
msgstr ""
"لا يوجد جدول المكوّن {comp_name} في المثيل {instance}: يُرجى تشغيل خادم HeTu"
" أولاً لإنشاء الجدول (أو تحقق من أن المثيل / اسم المكوّن / إعدادات Backend "
"تشير إلى قاعدة البيانات نفسها)"

#: hetu/headless.py:102
#, python-brace-format
msgid "组件 {comp_name} 的本地定义与服务器表结构不一致（服务器 -> 本地）：{diff}"
msgstr ""
"التعريف المحلي للمكوّن {comp_name} غير مطابق لبنية الجدول على الخادم (الخادم"
" -> المحلي): {diff}"

#: hetu/headless.py:119
#, python-brace-format
msgid ""
"组件 {comp_name} 的 cluster_id 已由 {old_id} 变为 {new_id}（服务器已迁簇），请重新 connect"
msgstr ""
"تغيّر cluster_id الخاص بالمكوّن {comp_name} من {old_id} إلى {new_id} (تم نقل"
" الكتلة على الخادم)، يُرجى إعادة connect"

#: hetu/headless.py:248
#, python-brace-format
msgid ""
"组件 {name} 未在本事务声明（或不是 connect 时认下的那个类），请在 client.session(...) "
"里加上；已声明：{declared}"
msgstr ""
"المكوّن {name} غير مُصرَّح به في هذه المعاملة (أو ليس الفئة التي تم اعتمادها"
" عند connect)، يُرجى إضافته في client.session(...)؛ المُصرَّح به: {declared}"

#: hetu/headless.py:295 hetu/headless.py:316
#, python-brace-format
msgid "组件 {name} 重复声明"
msgstr "تم التصريح بالمكوّن {name} أكثر من مرة"

#: hetu/headless.py:309
msgid "components 不能为空：至少声明一个组件"
msgstr "لا يمكن أن تكون components فارغة: يجب التصريح بمكوّن واحد على الأقل"

#: hetu/headless.py:330
#, python-brace-format
msgid "⚠️ [🧩Headless] 组件 {name} 的默认值与服务器不同（只影响本进程 new_row 的填充值）：{diff}"
msgstr ""
"⚠️ [🧩Headless] القيمة الافتراضية للمكوّن {name} تختلف عن الخادم (تؤثر فقط "
"على قيمة التعبئة لـ new_row في هذه العملية): {diff}"

#: hetu/headless.py:337
#, python-brace-format
msgid "[🧩Headless] 实例 {instance} 组件表 {name} → cluster {cid}"
msgstr "[🧩Headless] جدول المكوّن {name} في المثيل {instance} → cluster {cid}"

#: hetu/headless.py:370
#, python-brace-format
msgid "组件 {name} 未在 connect(components=...) 里声明；已声明：{declared}"
msgstr ""
"المكوّن {name} غير مُصرَّح به في connect(components=...)؛ المُصرَّح به: "
"{declared}"

#: hetu/headless.py:376
#, python-brace-format
msgid ""
"组件 {name} 是按名字声明的，其类来自服务器 meta，请用 client.table('{name}').comp_cls 而不是本地类"
msgstr ""
"المكوّن {name} مُصرَّح به بالاسم، وفئته تأتي من meta على الخادم، يُرجى "
"استخدام client.table('{name}').comp_cls بدلاً من الفئة المحلية"

#: hetu/headless.py:394
msgid "session() 至少要声明一个组件"
msgstr "يجب التصريح بمكوّن واحد على الأقل في session()"

#: hetu/headless.py:401
#, python-brace-format
msgid "同一事务的组件必须同簇（簇由服务器 System 的引用关系决定，跨簇请拆成两个事务）：{detail}"
msgstr ""
"يجب أن تنتمي مكوّنات المعاملة نفسها إلى الكتلة نفسها (تُحدَّد الكتلة حسب "
"علاقات الإشارة في System على الخادم، وإذا كانت عبر كتل مختلفة فيُرجى تقسيمها"
" إلى معاملتين): {detail}"

#: hetu/local.py:86
msgid "库里没有这张表：先用当前代码启动一次服务器（会建新表）"
msgstr ""
"لا يوجد هذا الجدول في قاعدة البيانات: شغّل الخادم مرة واحدة باستخدام الشيفرة"
" الحالية (سيُنشئ جدولًا جديدًا)"

#: hetu/local.py:89
msgid "本地代码与库里的表结构 / 簇不一致：先 hetu upgrade，或用与线上一致的代码版本运行"
msgstr ""
"الشيفرة المحلية لا تتوافق مع بنية الجداول / العناقيد في قاعدة البيانات: نفّذ"
" hetu upgrade أولًا، أو شغّل باستخدام إصدار الشيفرة المطابق للإنتاج"

#: hetu/local.py:93
#, python-brace-format
msgid "组件 {comp_name} 的表状态为 {status}，{hint}"
msgstr "حالة جدول Component ‏{comp_name} هي {status}، {hint}"

#: hetu/local.py:117
#, python-brace-format
msgid ""
"System {system} 是 USER 权限：生产里只有已登录连接能调，请指定玩家 id（hetu call 用 --as <uid>，代码里传 "
"caller=）"
msgstr ""
"System ‏{system} ذو صلاحية USER: في الإنتاج لا يمكن استدعاؤه إلا من اتصال "
"مسجّل الدخول، لذا حدّد معرّف اللاعب (في hetu call استخدم --as <uid>، وفي "
"الشيفرة مرّر caller=)"

#: hetu/cli/build.py:46 hetu/local.py:128
#, python-brace-format
msgid "无法加载app文件 {app_file}"
msgstr "تعذر تحميل ملف التطبيق {app_file}"

#: hetu/local.py:376
#, python-brace-format
msgid "找不到 Component：{comp}（是否在 components 中引用过？）"
msgstr ""
"تعذّر العثور على Component: {comp} (هل سبق الإشارة إليه في components؟)"

#: hetu/local.py:397
#, python-brace-format
msgid "{comp} 中不存在匹配 {query} 的行"
msgstr "لا توجد في {comp} صفوف تطابق {query}"

#: hetu/local.py:443
#, python-brace-format
msgid "{comp} 组件没有叫 {name} 的字段"
msgstr "لا يحتوي Component ‏{comp} على حقل باسم {name}"

#: hetu/local.py:448
msgid "_version 由引擎管理，insert 时不能设置"
msgstr "_version يديره المحرّك، ولا يمكن تعيينه عند insert"

#: hetu/local.py:509
#, python-brace-format
msgid "库文件不存在：{path}（服务器还没在这个库上启动过，或配置路径不对）"
msgstr ""
"ملف قاعدة البيانات غير موجود: {path} (لم يُشغَّل الخادم على قاعدة البيانات "
"هذه بعد، أو أن مسار الإعداد غير صحيح)"

#: hetu/cli/base.py:238 hetu/local.py:562
#, python-brace-format
msgid "实例 {instance} 不在配置的 INSTANCES 里：{instances}"
msgstr "المثيل {instance} غير موجود في INSTANCES المُهيّأة: {instances}"

#: hetu/manager.py:57
#, python-brace-format
msgid "Backend {backend}未找到"
msgstr "الخلفية {backend} غير موجودة"

#: hetu/manager.py:104
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表结构需要迁移Schema。"
msgstr "⚠️  تحتاج بنية جدول المكون {comp_name} إلى ترحيل Schema."

#: hetu/manager.py:111
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表需要迁移到新集群。"
msgstr "⚠️  يحتاج جدول المكون {comp_name} إلى الترحيل إلى المجموعة الجديدة."

#: hetu/webext.py:91
#, python-brace-format
msgid "define_route的uri必须以'/'开头，你的：{uri}"
msgstr "يجب أن يبدأ uri الخاص بـ define_route بـ '/'، لديك: {uri}"

#: hetu/webext.py:96
#, python-brace-format
msgid "define_route的uri不能占用HeTu保留的'{prefix}'路径（客户端SDK的WebSocket入口），你的：{uri}"
msgstr ""
"لا يمكن لـ uri الخاص بـ define_route أن يشغل المسار '{prefix}' المحجوز لـ "
"HeTu (نقطة دخول WebSocket الخاصة بحزمة SDK للعميل)، لديك: {uri}"

#: hetu/cli/__init__.py:70
msgid "河图数据库"
msgstr "قاعدة بيانات Hetu"

#: hetu/cli/__init__.py:75
msgid "执行操作"
msgstr "تنفيذ العملية"

#: hetu/cli/__init__.py:103
#, python-brace-format
msgid "无法识别的参数：{extras}"
msgstr "وسائط غير معروفة: {extras}"

#: hetu/cli/base.py:46
msgid "Boolean value expected."
msgstr "قيمة منطقية متوقعة."

#: hetu/cli/base.py:69
#, python-brace-format
msgid ""
"SQL 后端已移除，PostgreSQL / MariaDB 不再支持：'{scheme}'。开发用 sqlite:///<库文件路径>，生产用 "
"Redis"
msgstr ""
"تمت إزالة Backend الخاص بـ SQL، ولم يعد PostgreSQL / MariaDB مدعومًا: "
"'{scheme}'. للتطوير استخدم sqlite:///<مسار ملف قاعدة البيانات>، وللإنتاج "
"استخدم Redis"

#: hetu/cli/base.py:77
#, python-brace-format
msgid "不支持的数据库URL scheme: '{scheme}'。目前支持 redis/rediss/valkey/valkeys/sqlite"
msgstr ""
"مخطط URL لقاعدة البيانات غير مدعوم: '{scheme}'. المدعوم حاليًا: "
"redis/rediss/valkey/valkeys/sqlite"

#: hetu/cli/base.py:106
#, python-brace-format
msgid "⚠️ SQLite 库文件的相对路径现在按配置文件所在目录解析：{new}。旧位置（相对当前目录）{old} 有库文件，如需沿用请把它挪过去"
msgstr ""
"⚠️ يُحلّ الآن المسار النسبي لملف قاعدة بيانات SQLite بالنسبة إلى دليل ملف "
"الإعدادات: {new}. يوجد ملف قاعدة بيانات في الموقع القديم (نسبةً إلى الدليل "
"الحالي) {old}، وإن أردت الاستمرار في استخدامه فانقله إلى الموقع الجديد"

#: hetu/cli/base.py:125
#, python-brace-format
msgid "读不了配置文件 {path}：{err}"
msgstr "تعذّرت قراءة ملف الإعدادات {path}: {err}"

#: hetu/cli/base.py:128
#, python-brace-format
msgid "配置文件 {path} 不是一个映射"
msgstr "ملف الإعدادات {path} ليس mapping"

#: hetu/cli/base.py:192
#, python-brace-format
msgid "命令行参数模式缺少：{missing}（或改用 --config）"
msgstr "وسائط سطر الأوامر تفتقد: {missing} (أو استخدم --config بدلًا من ذلك)"

#: hetu/cli/base.py:223
msgid ""
"找不到配置：用 --config 指定，或设环境变量 HETU_CONFIG，或在当前目录放 config.yml；也可以用 --app-file / "
"--namespace / --instance / --db 直接给出"
msgstr ""
"لم يتم العثور على إعدادات: حدّدها عبر --config، أو عيّن متغير البيئة "
"HETU_CONFIG، أو ضع config.yml في الدليل الحالي؛ يمكنك أيضًا تقديمها مباشرة "
"عبر --app-file / --namespace / --instance / --db"

#: hetu/cli/base.py:233
msgid "配置里没有 INSTANCES"
msgstr "لا يوجد INSTANCES في الإعدادات"

#: hetu/cli/base.py:247
msgid "配置"
msgstr "الإعدادات"

#: hetu/cli/base.py:251
msgid "配置文件；不给时依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"ملف الإعدادات؛ إن لم يُعطَ فسيُبحث بالترتيب عن متغير البيئة HETU_CONFIG ثم "
"config.yml في الدليل الحالي"

#: hetu/cli/base.py:256
msgid "实例名，默认取配置里 INSTANCES 的第一个"
msgstr "اسم المثيل، الافتراضي هو أول عنصر في INSTANCES ضمن الإعدادات"

#: hetu/cli/base.py:259
msgid "（无配置文件时）河图app的py文件"
msgstr "(عند عدم وجود ملف إعدادات) ملف py لتطبيق hetu"

#: hetu/cli/base.py:262
msgid "（无配置文件时）app的namespace"
msgstr "(عند عدم وجود ملف إعدادات) namespace التطبيق"

#: hetu/cli/base.py:267
msgid "（无配置文件时）后端数据库地址"
msgstr "(عند عدم وجود ملف إعدادات) عنوان قاعدة بيانات Backend"

#: hetu/cli/build.py:22
msgid "生成客户端SDK C# 类型代码"
msgstr "إنشاء كود نوع C# لـ SDK العميل"

#: hetu/cli/build.py:26
msgid "河图app的py文件"
msgstr "ملف py لتطبيق Hetu"

#: hetu/cli/build.py:33
msgid "编译app.py中哪个namespace下的数据类型"
msgstr "أي مساحة أسماء في app.py سيتم تجميع أنواع البيانات منها"

#: hetu/cli/build.py:37
msgid "输出文件路径"
msgstr "مسار ملف الإخراج"

#: hetu/cli/build.py:59
#, python-brace-format
msgid "✅ 已生成C#代码到 {output}"
msgstr "✅ تم إنشاء كود C# في {output}"

#: hetu/cli/call.py:85
#, python-brace-format
msgid ""
"第 {n} 个参数看起来是 JSON 但解析失败（PowerShell 可能吃掉了引号），改用 --args-file 或 stdin：{raw}"
msgstr ""
"يبدو أن الوسيط رقم {n} بصيغة JSON لكن فشل تحليله (ربما أزالت PowerShell "
"علامات الاقتباس)، استخدم --args-file أو stdin بدلاً من ذلك: {raw}"

#: hetu/cli/call.py:104
#, python-brace-format
msgid "--args-file 读不了或不是合法 JSON：{err}"
msgstr "تعذّرت قراءة --args-file أو أنه ليس JSON صالحًا: {err}"

#: hetu/cli/call.py:107
msgid "--args-file 的内容必须是 JSON 数组"
msgstr "يجب أن يكون محتوى --args-file مصفوفة JSON"

#: hetu/cli/call.py:122
#, python-brace-format
msgid "--user-data 读不了或不是合法 JSON：{err}"
msgstr "تعذّرت قراءة --user-data أو أنه ليس JSON صالحًا: {err}"

#: hetu/cli/call.py:125
msgid "--user-data 必须是 JSON 对象"
msgstr "يجب أن يكون --user-data كائن JSON"

#: hetu/cli/call.py:135
#, python-brace-format
msgid "System {name} 要 {low}-{high} 个参数，给了 {n} 个"
msgstr "يتطلب System {name} من {low} إلى {high} وسيطًا، وقد أُعطي {n}"

#: hetu/cli/call.py:162
#, python-brace-format
msgid "，相近的有：{close}"
msgstr "، ومن الأسماء القريبة: {close}"

#: hetu/cli/call.py:164
#, python-brace-format
msgid "不存在的 System：{name}{hint}（hetu call --list 查看全部）"
msgstr "System غير موجود: {name}{hint} (اعرض الكل عبر hetu call --list)"

#: hetu/cli/call.py:293
#, python-brace-format
msgid ""
"System {name} 超过 {timeout} 秒没结束，已中止。若超时发生在提交途中，提交可能已经生效：writes 里 committed 为"
" unknown 的那次，请直接查数据确认"
msgstr ""
"لم ينتهِ System {name} خلال {timeout} ثانية، وقد أُوقف. إذا حدثت المهلة "
"أثناء الإرسال فقد يكون الإرسال قد نُفّذ فعلاً: راجع البيانات مباشرةً للتأكد "
"من الإرسال الذي قيمته committed هي unknown في writes"

#: hetu/cli/call.py:303
#, python-brace-format
msgid "System 留下 {n} 个后台任务，CLI 退出时已取消（在服务器里它们会继续跑）"
msgstr ""
"ترك System عدد {n} من المهام الخلفية، وقد أُلغيت عند خروج CLI (لكنها ستستمر "
"في العمل داخل الخادم)"

#: hetu/cli/call.py:333
msgid "--args-file 与位置参数不能同时给"
msgstr "لا يمكن تمرير --args-file والوسائط الموضعية في الوقت نفسه"

#: hetu/cli/call.py:348
#, python-brace-format
msgid "生产端点不会放行这个身份（caller={caller}，group={group}）调用 {permission} 权限的 System"
msgstr ""
"لن تسمح نقطة النهاية الإنتاجية لهذه الهوية (caller={caller}، group={group}) "
"باستدعاء System يملك صلاحية {permission}"

#: hetu/cli/call.py:359
#, python-brace-format
msgid "System {name} 读了 ctx.caller，而当前 caller 是推断出来的 0；要以玩家身份跑请用 --as <uid>"
msgstr ""
"قرأ System {name} القيمة ctx.caller، لكن caller الحالي هو 0 المُستنتج؛ "
"لتشغيله بهوية لاعب استخدم --as <uid>"

#: hetu/cli/call.py:441
msgid ""
"在本进程里直连后端调用一个 System（不经服务器），stdout 输出一行 JSON。调试用：写入与 System "
"走同一条提交路径，在线客户端照常收到推送"
msgstr ""
"استدعاء System مباشرةً عبر Backend داخل هذه العملية (دون المرور بالخادم)، "
"وإخراج سطر JSON واحد إلى stdout. لأغراض التصحيح: تمر الكتابة عبر مسار "
"الإرسال نفسه الذي يسلكه System، ويتلقى العملاء المتصلون التحديثات كالمعتاد"

#: hetu/cli/call.py:449
msgid "列出全部 System（参数、权限、引用的组件、文档第一行），不连数据库"
msgstr ""
"سرد كل System (الوسائط، والصلاحيات، وComponent المشار إليها، وأول سطر من "
"التوثيق) دون الاتصال بقاعدة البيانات"

#: hetu/cli/call.py:451
msgid "身份"
msgstr "الهوية"

#: hetu/cli/call.py:458
msgid ""
"以这个玩家 id 调用（ctx.caller）。USER 权限的 System 必须给；不给时按权限推断：ADMIN/GM/内部 System 用 "
"admin，EVERYBODY 用 guest"
msgstr ""
"الاستدعاء بمعرّف اللاعب هذا (ctx.caller). يجب تمريره لـ System ذي صلاحية "
"USER؛ وعند عدم تمريره يُستنتج وفق الصلاحية: admin لـ ADMIN/GM/System "
"الداخلي، وguest لـ EVERYBODY"

#: hetu/cli/call.py:465
msgid "ctx.group，如 gm / admin；给了 --as 时默认 guest"
msgstr "ctx.group، مثل gm / admin؛ وعند تمرير --as يكون الافتراضي guest"

#: hetu/cli/call.py:470
msgid "ctx.user_data（登录时写进去的数据 CLI 不知道，需要时手动给）"
msgstr ""
"ctx.user_data (البيانات المكتوبة عند تسجيل الدخول لا يعرفها CLI، فمرّرها "
"يدويًا عند الحاجة)"

#: hetu/cli/call.py:476
msgid "从文件读参数（一个 JSON 数组），- 为 stdin；避开 PowerShell 的引号问题"
msgstr ""
"قراءة الوسائط من ملف (مصفوفة JSON)، و- تعني stdin؛ لتجنّب مشكلات علامات "
"الاقتباس في PowerShell"

#: hetu/cli/call.py:482
msgid "调用锁 uuid（call_lock 的 System），同一 uuid 只执行一次"
msgstr ""
"uuid قفل الاستدعاء (System الخاص بـ call_lock)، فلا يُنفَّذ الـ uuid نفسه "
"إلا مرة واحدة"

#: hetu/cli/call.py:487
msgid "照常执行但不提交，输出它会写什么（写集）"
msgstr "التنفيذ كالمعتاد دون إرسال، مع إخراج ما سيكتبه (مجموعة الكتابة)"

#: hetu/cli/call.py:494
msgid "System 调用的超时秒数，默认 30，0 为不限"
msgstr "عدد ثواني المهلة لاستدعاء System، الافتراضي 30، و0 يعني بلا حد"

#: hetu/cli/call.py:501 hetu/cli/data.py:398 hetu/cli/shell.py:364
msgid "stderr 上多打日志：-v 为 INFO，-vv 为 DEBUG"
msgstr "طباعة سجلات أكثر على stderr: -v يعني INFO، و-vv يعني DEBUG"

#: hetu/cli/call.py:503
msgid "System 名"
msgstr "اسم System"

#: hetu/cli/call.py:508
msgid "参数：按 JSON 解析，解析不了当字符串；- 开头的放在 -- 后面"
msgstr ""
"الوسائط: تُحلَّل بصيغة JSON، وما يتعذّر تحليله يُعامل كنص؛ وما يبدأ بـ - "
"يوضع بعد --"

#: hetu/cli/call.py:518
msgid "要给 System 名（hetu call --list 查看全部）"
msgstr "يجب تمرير اسم System (اعرض الكل عبر hetu call --list)"

#: hetu/cli/console.py:67
msgid ""
"本配置禁止 hetu call / shell 写入（CLI_ALLOW_WRITE: false）：加 --dry-run 看它会写什么，或在配置里设"
" CLI_ALLOW_WRITE: true"
msgstr ""
"يمنع هذا الإعداد الكتابة عبر hetu call / shell (CLI_ALLOW_WRITE: false): أضف"
" --dry-run لترى ما سيكتبه، أو اضبط CLI_ALLOW_WRITE: true في الإعداد"

#: hetu/cli/console.py:366
#, python-brace-format
msgid "审计日志写不进去：{path}（{err}）。可用配置 CLI_AUDIT_LOG 改路径"
msgstr ""
"تعذّرت كتابة سجل التدقيق: {path} ({err}). يمكنك تغيير المسار عبر إعداد "
"CLI_AUDIT_LOG"

#: hetu/cli/console.py:376
#, python-brace-format
msgid "⚠️ 审计日志写不进去：{path}（{err}）"
msgstr "⚠️ تعذّرت كتابة سجل التدقيق: {path} ({err})"

#: hetu/cli/console.py:550
msgid "DEBUG 关闭的配置（按生产库对待）上 CLI 刚刚真写入了数据；要禁止，在配置里设 CLI_ALLOW_WRITE: false"
msgstr ""
"على إعداد مُعطَّل فيه DEBUG (يُعامَل كقاعدة إنتاج) كتب CLI للتو بيانات "
"فعليًا؛ لمنع ذلك، اضبط CLI_ALLOW_WRITE: false في الإعداد"

#: hetu/cli/console.py:630
msgid "Worker ID 租约丢失（本进程卡住太久被别人接手），命令已中止"
msgstr ""
"فُقد إيجار Worker ID (علق هذا Process طويلًا فتولاه غيره)، وقد أُجهض الأمر"

#: hetu/cli/console.py:653
#, python-brace-format
msgid "⚠️ 后台任务 {task} 退出时出错：{err}"
msgstr "⚠️ خطأ عند خروج المهمة الخلفية {task}: {err}"

#: hetu/cli/console.py:659
#, python-brace-format
msgid "⚠️ {n} 个后台任务 {timeout} 秒内没有响应取消，不再等待"
msgstr ""
"⚠️ {n} من المهام الخلفية لم تستجب للإلغاء خلال {timeout} ثانية، وتم التوقف "
"عن الانتظار"

#: hetu/cli/console.py:672
#, python-brace-format
msgid "收尾释放租约 / 关闭连接时出错（不影响已经完成的操作）：{err}"
msgstr ""
"خطأ أثناء تحرير الإيجار / إغلاق الاتصال في الختام (لا يؤثر على العمليات "
"المكتملة): {err}"

#: hetu/cli/data.py:65
#, python-brace-format
msgid "值 {raw} 不能转换成列类型 {dtype}"
msgstr "لا يمكن تحويل القيمة {raw} إلى نوع العمود {dtype}"

#: hetu/cli/data.py:89
#, python-brace-format
msgid "分组值 {raw} 不能转换成列类型 {dtype}"
msgstr "لا يمكن تحويل قيمة التجميع {raw} إلى نوع العمود {dtype}"

#: hetu/cli/data.py:100 hetu/cli/data.py:282
msgid "查询要写成 FIELD=VALUE，如 owner=1001"
msgstr "يجب كتابة الاستعلام بصيغة FIELD=VALUE، مثل owner=1001"

#: hetu/cli/data.py:104
#, python-brace-format
msgid "{field} 给了不止一次"
msgstr "تم إعطاء {field} أكثر من مرة"

#: hetu/cli/data.py:122
#, python-brace-format
msgid ""
"组件 {comp} 的 {field} 不是 id 或带索引的字段，不能查；可查的有：{fields}（括号里是复合索引的分组列，查询时要一并用 "
"FIELD=VALUE 给出）"
msgstr ""
"الحقل {field} في Component {comp} ليس id ولا حقلًا مفهرسًا، لذا لا يمكن "
"الاستعلام به؛ الحقول القابلة للاستعلام هي: {fields} (ما بين الأقواس هو أعمدة"
" التجميع في الفهرس المركّب، ويجب إعطاؤها جميعًا بصيغة FIELD=VALUE عند "
"الاستعلام)"

#: hetu/cli/data.py:140
#, python-brace-format
msgid "--index {index} 要同时用 {index}=VALUE 给出查询值"
msgstr "يجب مع --index {index} إعطاء قيمة الاستعلام أيضًا بصيغة {index}=VALUE"

#: hetu/cli/data.py:157
#, python-brace-format
msgid ""
"查询条件 {keys} 对不上组件 {comp} "
"的任何索引：要么只给一个带索引的字段，要么正好给出复合索引的本字段和全部分组列；可查的有：{fields}"
msgstr ""
"شروط الاستعلام {keys} لا تطابق أي فهرس في Component {comp}: إما أن تعطي "
"حقلًا واحدًا مفهرسًا فقط، أو أن تعطي بالضبط الحقل نفسه وكل أعمدة التجميع في "
"الفهرس المركّب؛ الحقول القابلة للاستعلام هي: {fields}"

#: hetu/cli/data.py:166
#, python-brace-format
msgid "查询条件 {keys} 同时匹配了 {matched} 几个索引，请用 --index 指定"
msgstr ""
"شروط الاستعلام {keys} طابقت {matched} فهارس في آنٍ واحد، يرجى التحديد "
"باستخدام --index"

#: hetu/cli/data.py:181
#, python-brace-format
msgid "{index} 是按 {columns} 分组的复合索引，要用 FIELD=VALUE 正好给出这些分组列，收到：{keys}"
msgstr ""
"{index} هو فهرس مركّب مجمّع حسب {columns}، ويجب إعطاء أعمدة التجميع هذه "
"بالضبط بصيغة FIELD=VALUE، والمستلَم هو: {keys}"

#: hetu/cli/data.py:186
#, python-brace-format
msgid "{index} 不是复合索引，多给了 {keys}"
msgstr "{index} ليس فهرسًا مركّبًا، وقد أُعطي بالإضافة إليه {keys}"

#: hetu/cli/data.py:390
msgid "读 master（刚写完马上读时用）；默认读 servant"
msgstr ""
"القراءة من master (تُستخدم عند القراءة فور الكتابة مباشرة)؛ افتراضيًا تتم "
"القراءة من servant"

#: hetu/cli/data.py:392
msgid "只输出这些列，逗号分隔"
msgstr "إخراج هذه الأعمدة فقط، مفصولة بفواصل"

#: hetu/cli/data.py:414
msgid ""
"按 id 或带索引的字段读一行组件数据（不做 RLS），stdout 输出一行 JSON；不加载 app，schema 取自库里的表 meta"
msgstr ""
"قراءة صف واحد من بيانات Component بواسطة id أو حقل مفهرس (بدون تطبيق RLS)، "
"وإخراج سطر JSON واحد إلى stdout؛ لا يتم تحميل app، ويُؤخذ schema من meta "
"الجدول في قاعدة البيانات"

#: hetu/cli/data.py:422
msgid "列出组件、字段与索引（加载 app，不连数据库）"
msgstr "سرد Components والحقول والفهارس (يحمّل app، ولا يتصل بقاعدة البيانات)"

#: hetu/cli/data.py:427
msgid "FIELD=VALUE 同时匹配了几个复合索引时，指定按哪个索引查（其余 FIELD=VALUE 是它的分组值）"
msgstr ""
"عندما يطابق FIELD=VALUE عدة فهارس مركّبة في آنٍ واحد، حدّد أي فهرس يُستعلَم "
"به (وبقية FIELD=VALUE هي قيم التجميع الخاصة به)"

#: hetu/cli/data.py:437
msgid "一个带索引的字段，如 owner=1001；复合索引要同时给出全部分组列，如 name=abc zone=3"
msgstr ""
"حقل مفهرس واحد، مثل owner=1001؛ أما الفهرس المركّب فيجب إعطاء كل أعمدة "
"التجميع معًا، مثل name=abc zone=3"

#: hetu/cli/data.py:450
msgid "要给组件名和 FIELD=VALUE（hetu get --list 查看组件）"
msgstr ""
"يجب إعطاء اسم Component و FIELD=VALUE (استخدم hetu get --list لعرض "
"Components)"

#: hetu/cli/data.py:469
msgid ""
"按带索引的字段读一个区间的组件数据（不做 RLS），stdout 输出一行 JSON；省略 RIGHT 即精确匹配 LEFT，( / [ 前缀表示开 /"
" 闭区间"
msgstr ""
"قراءة نطاق من بيانات Component بواسطة حقل مفهرس (بدون تطبيق RLS)، وإخراج سطر"
" JSON واحد إلى stdout؛ حذف RIGHT يعني مطابقة LEFT بدقة، والبادئة ( / [ تعني "
"فترة مفتوحة / مغلقة"

#: hetu/cli/data.py:478
msgid "最多返回多少行，默认 10，-1 为不限"
msgstr "الحد الأقصى لعدد الصفوف المُعادة، الافتراضي 10، و -1 تعني بلا حد"

#: hetu/cli/data.py:480
msgid "降序"
msgstr "ترتيب تنازلي"

#: hetu/cli/data.py:486
msgid "复合索引的分组值，每个分组列给一次，如 --group zone=3"
msgstr ""
"قيمة تجميع للفهرس المركّب، تُعطى مرة واحدة لكل عمود تجميع، مثل --group "
"zone=3"

#: hetu/cli/init.py:325
msgid "❌ 未找到 uv 命令，请先安装 uv：https://docs.astral.sh/uv/"
msgstr ""
"❌ لم يتم العثور على أمر uv، يرجى تثبيت uv أولاً: https://docs.astral.sh/uv/"

#: hetu/cli/init.py:329
#, python-brace-format
msgid "❌ uv {cmd} 执行失败（退出码 {code}）"
msgstr "❌ فشل تنفيذ uv {cmd} (رمز الخروج {code})"

#: hetu/cli/init.py:355
#, python-brace-format
msgid "ℹ️  {path} 已存在，跳过"
msgstr "ℹ️  {path} موجود بالفعل، تم التخطي"

#: hetu/cli/init.py:359
#, python-brace-format
msgid "✅ 已创建 {path}"
msgstr "✅ تم إنشاء {path}"

#: hetu/cli/init.py:374
msgid "ℹ️  pyproject.toml 已注册 build/dev 命令，跳过"
msgstr "ℹ️  pyproject.toml سجّل أوامر build/dev، تم التخطي"

#: hetu/cli/init.py:377
msgid "⚠️  pyproject.toml 已有 build/dev 命令定义，跳过注册，请手动检查"
msgstr ""
"⚠️  يوجد بالفعل تعريف لأوامر build/dev في pyproject.toml، تم تخطي التسجيل، "
"يرجى الفحص يدويًا"

#: hetu/cli/init.py:391
msgid "✅ 已在 pyproject.toml 注册 build/dev 命令"
msgstr "✅ تم تسجيل أوامر build/dev في pyproject.toml"

#: hetu/cli/init.py:401
#, python-brace-format
msgid "✅ 已将 {entry} 加入 .gitignore"
msgstr "✅ تمت إضافة {entry} إلى .gitignore"

#: hetu/cli/init.py:411
msgid "初始化一个新的河图项目"
msgstr "تهيئة مشروع hetu جديد"

#: hetu/cli/init.py:416
msgid "项目目录名，省略则在当前目录初始化"
msgstr "اسم دليل المشروع، إذا تم حذفه فسيتم التهيئة في الدليل الحالي"

#: hetu/cli/init.py:421
msgid "项目使用的 Python 版本"
msgstr "نسخة Python المستخدمة في المشروع"

#: hetu/cli/init.py:431
msgid "ℹ️  检测到 pyproject.toml，跳过 uv init"
msgstr "ℹ️  تم اكتشاف pyproject.toml، تخطي uv init"

#: hetu/cli/init.py:504
msgid "ℹ️  config.yml 已存在，跳过"
msgstr "ℹ️  config.yml موجود بالفعل، تخطي"

#: hetu/cli/init.py:508
msgid "✅ 已创建 config.yml"
msgstr "✅ تم إنشاء config.yml"

#: hetu/cli/init.py:521
msgid "ℹ️  hetudb 已在依赖中，跳过 uv add"
msgstr "ℹ️  hetudb موجود بالفعل في التبعيات، تخطي uv add"

#: hetu/cli/init.py:527
msgid "🎉 项目已就绪！下一步："
msgstr "🎉 المشروع جاهز! الخطوة التالية:"

#: hetu/cli/init.py:531
msgid "# 强制迁移并启动开发服务器（含客户端代码生成）"
msgstr "# فرض الترحيل وبدء خادم التطوير (مع توليد كود العميل)"

#: hetu/cli/init.py:533
msgid "# 仅生成客户端 C# 组件代码"
msgstr "# توليد كود Component بلغة C# للعميل فقط"

#: hetu/cli/init.py:534
msgid "# 仅启动服务"
msgstr "# بدء الخدمة فقط"

#: hetu/cli/init.py:536
msgid "提示：默认使用 SQLite 调试数据库，文件会自动创建，无需额外服务。"
msgstr ""
"تلميح: يتم استخدام قاعدة بيانات SQLite للتصحيح بشكل افتراضي، سيتم إنشاء "
"الملف تلقائيًا دون الحاجة إلى خدمة إضافية."

#: hetu/cli/init.py:537
msgid "      生产环境请在 config.yml 的 BACKENDS 中改用 Redis。"
msgstr ""
"      في بيئة الإنتاج، يُرجى استخدام Redis في BACKENDS داخل config.yml."

#: hetu/cli/init.py:540
#, python-brace-format
msgid "      uv run build 需在 .env.test 设置 {env} 指向客户端工程输出路径。"
msgstr ""
"      يتطلب uv run build ضبط {env} في .env.test للإشارة إلى مسار إخراج مشروع"
" العميل."

#: hetu/cli/init.py:544
#, python-brace-format
msgid "      已写入 .claude/skills/{name}/，供编码 AI 了解 HeTu 用法。"
msgstr ""
"      تمت الكتابة إلى .claude/skills/{name}/، لكي يتعرّف الذكاء الاصطناعي "
"البرمجي على استخدام HeTu."

#: hetu/cli/migrate.py:37
msgid ""
"在数据库执行Schema升级脚本,如果没有则创建，如果无变更则跳过。同时还会进行临时表的清空。应该在CI/CD流程中，每次启动服务器前执行一次。"
msgstr ""
"تنفيذ سكربت ترقية مخطط قاعدة البيانات، وإنشاؤه إذا لم يكن موجودًا، وتخطيه "
"إذا لم يكن هناك تغيير. كما سيتم إفراغ الجداول المؤقتة. يجب تنفيذ هذا مرة "
"واحدة قبل تشغيل الخادم في كل عملية CI/CD."

#: hetu/cli/migrate.py:44 hetu/cli/start.py:95
msgid "后端数据库地址，默认 redis://127.0.0.1:6379/0"
msgstr "عنوان قاعدة بيانات Backend، الافتراضي redis://127.0.0.1:6379/0"

#: hetu/cli/migrate.py:48
msgid "河图app的py文件，默认 app.py"
msgstr "ملف py لتطبيق hetu، الافتراضي app.py"

#: hetu/cli/migrate.py:54 hetu/cli/start.py:84
msgid "启动app.py中哪个namespace下的System"
msgstr "أي System ضمن namespace في app.py لتشغيله"

#: hetu/cli/migrate.py:57 hetu/cli/start.py:87
msgid "实例名称，每个实例是一个副本"
msgstr "اسم المثيل، كل مثيل هو نسخة مكررة"

#: hetu/cli/migrate.py:63
msgid "通过yml配置文件读取后端数据库地址。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"قراءة عنوان قاعدة بيانات Backend من ملف تهيئة yml. عند عدم توفيره وعدم "
"استخدام معاملات سطر الأوامر، يتم البحث بالترتيب عن متغير البيئة HETU_CONFIG "
"ثم config.yml في الدليل الحالي"

#: hetu/cli/migrate.py:72
msgid "自动确认数据备份提示"
msgstr "تأكيد تلقائي لرسالة نسخ البيانات الاحتياطية"

#: hetu/cli/migrate.py:78
msgid "强制执行升级迁移，丢弃无法迁移的数据。请勿在生产环境使用此选项！"
msgstr ""
"فرض ترقية الهجرة، مع تجاهل البيانات التي لا يمكن نقلها. لا تستخدم هذا الخيار"
" في بيئة الإنتاج!"

#: hetu/cli/migrate.py:85
msgid "跳过重建索引。默认每次升级都按行数据重建持久组件的索引、修掉索引残留，数据量大时较慢"
msgstr ""
"تخطي إعادة بناء الفهارس. افتراضيًا في كل ترقية تُعاد بناء فهارس Component "
"الدائم وفق بيانات الصفوف، وتُصلَح بقايا الفهارس، وهو أبطأ عند كثرة البيانات"

#: hetu/cli/migrate.py:121
#, python-brace-format
msgid ""
"❌ 检测到还有服务器在运行（持有 Worker ID "
"租约：{ids}），请先停服再升级：迁移、清空易失表、重建索引在服务器运行时执行都会写坏数据。服务器是异常退出的，等租约过期（最多 {ttl} "
"秒）后再试。"
msgstr ""
"❌ تم اكتشاف خوادم لا تزال قيد التشغيل (تحتفظ باستئجار Worker ID: {ids})، "
"يرجى إيقاف الخادم أولًا ثم الترقية: تنفيذ الهجرة وإفراغ الجداول المتطايرة "
"وإعادة بناء الفهارس أثناء عمل الخادم جميعها ستُفسد البيانات. إن كان الخادم "
"قد خرج بصورة غير طبيعية، فانتظر انتهاء مدة الاستئجار (بحد أقصى {ttl} ثانية) "
"ثم أعد المحاولة."

#: hetu/cli/migrate.py:129
#, python-brace-format
msgid "   其中 {ids} 是 hetu call / shell 进程，等它们结束即可（异常退出的最多 {ttl} 秒过期）。"
msgstr ""
"   حيث {ids} هي عمليات hetu call / shell، ما عليك سوى انتظار انتهائها (تنتهي"
" بصورة غير طبيعية خلال {ttl} ثانية كحد أقصى)."

#: hetu/cli/migrate.py:147
msgid "⚠️  升级数据库表结构可能会导致数据丢失，请确保已备份数据。确认继续请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️   قد يؤدي ترقية هيكل جداول قاعدة البيانات إلى فقدان البيانات، يرجى التأكد"
" من نسخ البيانات احتياطيًا. للتأكيد والمتابعة أدخل y ، للإلغاء أدخل أي مفتاح"
" آخر ثم اضغط Enter:"

#: hetu/cli/migrate.py:152 hetu/cli/migrate.py:179
msgid "❌  升级迁移已取消。"
msgstr "❌   تم إلغاء ترقية الهجرة."

#: hetu/cli/migrate.py:169
msgid "❗ Component有数据删除或类型变更，请修改自动生成的迁移脚本，手动处理这些属性。或使用--drop-data参数直接丢弃这些属性。"
msgstr ""
"❗ هناك حذف بيانات أو تغيير نوع في Component، يرجى تعديل سكربت الهجرة المُنشأ"
" تلقائيًا ومعالجة هذه الخصائص يدويًا. أو استخدم المعامل --drop-data لتجاهل "
"هذه الخصائص مباشرة."

#: hetu/cli/migrate.py:176
msgid "⚠️  确认强制迁移请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️   لتأكيد فرض الهجرة أدخل y ، للإلغاء أدخل أي مفتاح آخر ثم اضغط Enter:"

#: hetu/cli/migrate.py:183
#, python-brace-format
msgid "⚠️  正在强制迁移 {instance_name} 服所有表结构，可能会丢失数据..."
msgstr ""
"⚠️   جاري فرض هجرة جميع هياكل الجداول لخادم {instance_name}، قد يؤدي ذلك إلى"
" فقدان البيانات..."

#: hetu/cli/migrate.py:191
#, python-brace-format
msgid "🧹 正在清除 {instance_name} 服易失数据..."
msgstr "🧹 جاري تنظيف البيانات المتطايرة لخادم {instance_name}..."

#: hetu/cli/migrate.py:199
#, python-brace-format
msgid "🔧 正在重建 {instance_name} 服的索引..."
msgstr "🔧 جاري إعادة بناء فهارس خادم {instance_name}..."

#: hetu/cli/migrate.py:206
#, python-brace-format
msgid "✅  {instance_name} 服升级迁移完成！"
msgstr "✅  اكتملت ترقية وهجرة خادم {instance_name}!"

#: hetu/cli/migrate.py:210
msgid "🎉  恭喜！所有数据库表结构均已升级完成！"
msgstr "🎉  مبروك! تمت ترقية جميع هياكل جداول قاعدة البيانات بنجاح!"

#: hetu/cli/shell.py:70
msgid "call 留给以后的 Endpoint 路径（与 Sandbox.call 同义），跑 System 请用 call_system"
msgstr ""
"call محجوز لمسارات Endpoint لاحقًا (مرادف لـ Sandbox.call)، ولتشغيل System "
"استخدم call_system"

#: hetu/cli/shell.py:189
msgid "KeyboardInterrupt（Ctrl+D 退出 shell）"
msgstr "KeyboardInterrupt (Ctrl+D للخروج من shell)"

#: hetu/cli/shell.py:229
msgid ""
"HeTu shell：预置 app / client / call_system / get / must_get / insert / upsert "
"/ show，range 用 app.range；支持顶层 await，Ctrl+D 退出"
msgstr ""
"HeTu shell: يوفّر مسبقًا app / client / call_system / get / must_get / "
"insert / upsert / show، ولـ range استخدم app.range؛ يدعم await على المستوى "
"الأعلى، وCtrl+D للخروج"

#: hetu/cli/shell.py:270
msgid "没有要执行的代码：用 -c CODE、脚本文件，或从 stdin 传入；在终端里直接运行 hetu shell 进交互模式"
msgstr ""
"لا يوجد كود لتنفيذه: استخدم -c CODE، أو ملف سكربت، أو مرّره عبر stdin؛ شغّل "
"hetu shell مباشرة في الطرفية للدخول إلى الوضع التفاعلي"

#: hetu/cli/shell.py:318
#, python-brace-format
msgid "⚠️ shell 退出时取消了 {n} 个还在跑的后台任务"
msgstr "⚠️ عند خروج shell أُلغيت {n} من المهام الخلفية التي كانت لا تزال تعمل"

#: hetu/cli/shell.py:348
msgid ""
"进程内连上后端的 Python shell：预置 call_system / get / must_get / insert / upsert / "
"show 与 app.range，支持顶层 await"
msgstr ""
"Python shell داخل العملية يتصل بـ Backend: يوفّر مسبقًا call_system / get / "
"must_get / insert / upsert / show وapp.range، ويدعم await على المستوى الأعلى"

#: hetu/cli/shell.py:353
msgid "执行这段代码"
msgstr "تنفيذ هذا الكود"

#: hetu/cli/shell.py:357
msgid "执行但不提交任何写入"
msgstr "تنفيذ دون تأكيد أي عمليات كتابة"

#: hetu/cli/shell.py:370
msgid "要执行的脚本，- 为 stdin；都不给且 stdin 是终端时进交互模式"
msgstr ""
"السكربت المراد تنفيذه، و- تعني stdin؛ إذا لم يُعطَ أي منهما وكان stdin "
"طرفية، يُدخل الوضع التفاعلي"

#: hetu/cli/start.py:73
msgid "启动河图服务"
msgstr "تشغيل خدمة Hetu"

#: hetu/cli/start.py:75
msgid "通过命令行启动参数"
msgstr "عبر معلمات سطر الأوامر"

#: hetu/cli/start.py:78
msgid "河图app的py文件，默认 /app/app.py"
msgstr "ملف py لتطبيق Hetu، الافتراضي /app/app.py"

#: hetu/cli/start.py:90
msgid "监听的Websocket端口"
msgstr "منفذ Websocket للاستماع"

#: hetu/cli/start.py:100
msgid "工作进程数，可设为 CPU * 1.2，-1为按CPU核心数自动"
msgstr ""
"عدد عمليات العمل، يمكن ضبطه على CPU * 1.2، وتعني -1 الضبط التلقائي حسب عدد "
"أنوية CPU"

#: hetu/cli/start.py:109
#, python-format
msgid ""
"开启debug模式，这会启动代码热更新，并显示更多的log信息。如果设置为2，则对框架内核也启用debug模式，会开启Python协程的Debug模式，速度慢90%%。"
msgstr ""
"تفعيل وضع التصحيح، سيؤدي هذا إلى تشغيل التحديث الساخن للكود وعرض المزيد من "
"معلومات السجل. إذا تم ضبطه على 2، فسيتم تفعيل وضع التصحيح لنواة الإطار "
"أيضًا، مما يؤدي إلى تفعيل وضع تصحيح Python للمهام المتعاونة، مما يبطئ السرعة"
" بنسبة 90٪."

#: hetu/cli/start.py:119
msgid "证书目录，如果不设置则使用不安全的连接。不建议这里设置，请外加一层反向https代理。填入auto会生成自签https证书。"
msgstr ""
"دليل الشهادات، إذا لم يتم تعيينه فسيتم استخدام اتصال غير آمن. لا ينصح "
"بالتعيين هنا، يرجى إضافة طبقة وكيل عكسي https خارجية. سيؤدي إدخال 'auto' إلى"
" إنشاء شهادة https ذاتية التوقيع."

#: hetu/cli/start.py:127
msgid "默认crypto层的auth_key，用于握手签名校验。留空则不启用。"
msgstr ""
"مفتاح المصادقة الافتراضي لطبقة التشفير، يستخدم للتحقق من توقيع المصافحة. "
"اتركه فارغًا لتعطيله."

#: hetu/cli/start.py:135
msgid ""
"配置文件模板见CONFIG_TEMPLATE.yml。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"قالب ملف التكوين موجود في CONFIG_TEMPLATE.yml. إذا لم يُقدَّم ولم تُستخدم "
"معلمات سطر الأوامر، فسيتم البحث بالترتيب في متغير البيئة HETU_CONFIG ثم "
"config.yml في الدليل الحالي"

#: hetu/cli/start.py:170
msgid "--app_file是必须参数，或者用--config"
msgstr "--app_file معلمة إلزامية، أو استخدم --config"

#: hetu/cli/start.py:173
msgid "--namespace是必须参数，或者用--config"
msgstr "--namespace معلمة إلزامية، أو استخدم --config"

#: hetu/cli/start.py:176
msgid "--instance是必须参数，或者用--config"
msgstr "--instance معلمة إلزامية، أو استخدم --config"

#: hetu/cli/start.py:235
#, python-brace-format
msgid "ℹ️ {name}, {mode}, {workers} 个工作进程, 管理进程 pid: {pid}"
msgstr "ℹ️ {name}, {mode}, {workers} عمليات عمل, معرف عملية الإدارة: {pid}"

#: hetu/cli/start.py:243
#, python-brace-format
msgid "ℹ️ Python {version} 平台 {platform}"
msgstr "ℹ️ Python {version} منصة {platform}"

#: hetu/cli/start.py:248
#, python-brace-format
msgid "📡 监听地址： http{s}://{host}:{port}"
msgstr "📡 عنوان الاستماع: http{s}://{host}:{port}"

#: hetu/cli/start.py:254
#, python-brace-format
msgid "ℹ️ 消息流协议：json -> {layers} -> Network"
msgstr "ℹ️ بروتوكول تدفق الرسائل: json -> {layers} -> الشبكة"

#: hetu/cli/start.py:270
#, python-brace-format
msgid "🔑 auth_key: {key}"
msgstr "🔑 auth_key: {key}"

#: hetu/cli/start.py:272
msgid "🔑 auth_key 未设置 ⚠️ 任意 key 都能连接"
msgstr "🔑 auth_key غير معيّن ⚠️ أي مفتاح يمكنه الاتصال"

#: hetu/cli/start.py:276
msgid "⚠️⚠️⚠️ 深度Debug模式开启  ⚠️⚠️⚠️   此模式下Python协程慢90%"
msgstr ""
"⚠️⚠️⚠️ تم تفعيل وضع التصحيح العميق ⚠️⚠️⚠️   المهام المتعاونة لـ Python أبطأ "
"بنسبة 90٪ في هذا الوضع"

#: hetu/cli/start.py:303
#, python-brace-format
msgid "❌ 服务器启动失败，已中止，未对外提供服务：{err}"
msgstr "❌ فشل تشغيل الخادم، وتم إجهاضه، ولم يتم تقديم الخدمة للخارج: {err}"

#: hetu/cli/start.py:311
msgid "端口可能被系统 excludedportrange 禁用了，请用管理员执行：net stop winnatnet start winnat"
msgstr ""
"قد يكون المنفذ معطلاً بواسطة نطاق المنافذ المستبعدة (excludedportrange) في "
"النظام، يرجى التشغيل كمسؤول: net stop winnatnet start winnat"

#: hetu/common/slowlog.py:72
#, python-brace-format
msgid ""
"⚠️ [📞慢日志] 系统 {name} 执行时间 {elapsed}秒，事务冲突次数 {retry}，平均时间 {avg_time}秒\n"
"{table}"
msgstr ""
"⚠️ [📞 سجل بطيء] النظام {name} وقت التنفيذ {elapsed} ثانية، عدد تعارضات المعاملات {retry}، متوسط الوقت {avg_time} ثانية\n"
"{table}"

#: hetu/common/slowlog.py:99
msgid "系统"
msgstr "النظام"

#: hetu/common/slowlog.py:99
msgid "平均时间"
msgstr "متوسط الوقت"

#: hetu/common/slowlog.py:99
msgid "平均冲突次数"
msgstr "متوسط عدد التعارضات"

#: hetu/common/snowflake_id.py:119
#, python-brace-format
msgid "Worker ID不能大于{max}或小于0"
msgstr "معرف العامل لا يمكن أن يكون أكبر من {max} أو أقل من 0"

#: hetu/common/snowflake_id.py:137
#, python-brace-format
msgid "[❄️ID] 雪花ID生成器初始化完成，Worker ID: {worker_id}, last_timestamp: {ts}"
msgstr ""
"[❄️ID] تم تهيئة مولد معرفات Snowflake، معرف العامل: {worker_id}, "
"last_timestamp: {ts}"

#: hetu/common/snowflake_id.py:170
#, python-brace-format
msgid ""
"[❄️ID] Worker ID {worker_id} 的租约已超出安全期 {overdue:.1f} "
"秒，拒绝发号以防产生重复ID。通常意味着本进程长时间卡住或后端连不上，Worker 会在下一次续约时重启"
msgstr ""
"[❄️ID] تجاوز عقد إيجار معرف العامل {worker_id} فترة الأمان بمقدار "
"{overdue:.1f} ثانية، وتم رفض إصدار المعرف لمنع تكرار المعرفات. يعني ذلك "
"عادةً أن هذه العملية عالقة لفترة طويلة أو يتعذر الاتصال بـ Backend، وسيُعاد "
"تشغيل العامل عند التجديد التالي."

#: hetu/common/snowflake_id.py:181
msgid "SnowflakeID 未初始化，请先调用 init() 方法。"
msgstr "SnowflakeID غير مهيأ، يرجى استدعاء طريقة init() أولاً."

#: hetu/common/snowflake_id.py:191
#, python-brace-format
msgid "[❄️ID] 时钟回拨了 {ms} 毫秒。"
msgstr "[❄️ID] تمت إعادة ضبط الساعة بمقدار {ms} مللي ثانية."

#: hetu/common/snowflake_id.py:226 hetu/common/snowflake_id.py:242
msgid "[❄️ID] 每毫秒只能生成有限的ID，需要休眠 1 ms"
msgstr ""
"[❄️ID] يمكن إنشاء عدد محدود من المعرفات في كل مللي ثانية، يجب الانتظار لمدة "
"1 مللي ثانية"

#: hetu/common/yamlloader.py:66
#, python-brace-format, python-format
msgid "环境变量 ${%s} 未设置且无默认值，如需空值请用 ${%s:-}"
msgstr ""
"متغير البيئة ${%s} غير مُعيَّن وليس له قيمة افتراضية، إذا أردت قيمة فارغة "
"فاستخدم ${%s:-}"

#: hetu/data/component.py:417
#, python-brace-format
msgid "{cname}.{pname}不是字符串属性（dtype={d}）"
msgstr "{cname}.{pname} ليست خاصية سلسلة نصية（dtype={d}）"

#: hetu/data/component.py:501
msgid "Component重复定义"
msgstr "تكرار تعريف المكون (Component)"

#: hetu/data/component.py:634
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是Python关键字。"
msgstr ""
"خطأ في تعريف خاصية {cname}.{fname}، لا يمكن أن يكون اسم الخاصية كلمة مفتاحية"
" في Python."

#: hetu/data/component.py:640
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是C#关键字。"
msgstr ""
"خطأ في تعريف خاصية {cname}.{fname}، لا يمكن أن يكون اسم الخاصية كلمة مفتاحية"
" في C#."

#: hetu/data/component.py:648
#, python-brace-format
msgid ""
"{cname}.{fname}属性定义出错，属性名不能和numpy行数据的属性同名，否则row.{fname}读到的是numpy的属性而不是字段值，请换个名字。"
msgstr ""
"خطأ في تعريف الخاصية {cname}.{fname}، لا يمكن أن يكون اسم الخاصية مطابقًا "
"لاسم خاصية في بيانات صف numpy، وإلا فإن row.{fname} سيقرأ خاصية numpy بدلاً "
"من قيمة الحقل، يُرجى تغيير الاسم."

#: hetu/data/component.py:654
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不能为0长度。str类型请用'<U8'方式定义"
msgstr ""
"لا يمكن أن يكون dtype الخاصية {cname}.{fname} بطول صفر. بالنسبة لنوع str، "
"يُرجى تعريفه باستخدام '<U8'."

#: hetu/data/component.py:657
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不支持void类型"
msgstr "نوع void غير مدعوم لـ dtype الخاصية {cname}.{fname}."

#: hetu/data/component.py:668
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为unique时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] عند تعيين الخاصية {cname}.{fname} كـ unique، لا يمكن تعيين "
"index إلى False."

#: hetu/data/component.py:678
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了groupby（复合索引），point_sub用不上已忽略：按组订阅本来就只被本组的写入叫醒。"
msgstr ""
"⚠️ [🛠️Define] تم تعيين groupby (فهرس مركّب) للخاصية {cname}.{fname}، وقد تم "
"تجاهله لأنه غير مستخدم في point_sub: فالاشتراك حسب المجموعة لا يُنبَّه أصلًا"
" إلا بالكتابة في المجموعة نفسها."

#: hetu/data/component.py:690
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了commit_seq，point_sub用不上已忽略：号要到提交时才有，发不出值频道。"
msgstr ""
"⚠️ [🛠️Define] تم تعيين commit_seq للخاصية {cname}.{fname}، وقد تم تجاهله "
"لأنه غير مستخدم في point_sub: فالرقم لا يتوفر إلا عند الإيداع (commit)، لذا "
"لا يمكن إرسال قناة القيمة."

#: hetu/data/component.py:698
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了commit_seq时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] عند تعيين commit_seq للخاصية {cname}.{fname}، لا يمكن تعيين "
"index إلى False."

#: hetu/data/component.py:707
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为point_sub时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] عند تعيين الخاصية {cname}.{fname} إلى point_sub، لا يمكن تعيين"
" index إلى False."

#: hetu/data/component.py:716
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了groupby时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] عند تعيين groupby للخاصية {cname}.{fname}، لا يمكن تعيين index"
" إلى False."

#: hetu/data/component.py:725
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，hidden属性不能同时设置point_sub：客户端不能按hidden属性订阅。"
msgstr ""
"خطأ في تعريف الخاصية {cname}.{fname}، لا يمكن تعيين point_sub مع الخاصية "
"hidden في الوقت نفسه: لا يمكن للعميل الاشتراك حسب الخاصية hidden."

#: hetu/data/component.py:731
#, python-brace-format
msgid ""
"{cname}.{fname}默认值不能为None。所有属性都要有默认值，因为数据接口统一用c like "
"struct实现，强类型struct不接受NULL/None值。"
msgstr ""
"لا يمكن أن تكون القيمة الافتراضية للخاصية {cname}.{fname} هي None. يجب أن "
"يكون لكل خاصية قيمة افتراضية، لأن واجهات البيانات تُنفذ بشكل موحد باستخدام "
"struct شبيه بـ C، ولا تقبل struct ذات النوع القوي قيم NULL/None."

#: hetu/data/component.py:742
#, python-brace-format
msgid ""
"{cname}.{fname}的default值：{default_type}({default_value})和属性dtype({dtype})不匹配"
msgstr ""
"قيمة default للخاصية {cname}.{fname}: {default_type}({default_value}) لا "
"تتطابق مع dtype الخاصية ({dtype})."

#: hetu/data/component.py:756
#, python-brace-format
msgid "{cname}权限为OWNER时，不能设置rls_compare参数"
msgstr "عندما تكون صلاحية {cname} هي OWNER، لا يمكن تعيين معلمة rls_compare."

#: hetu/data/component.py:759
#, python-brace-format
msgid "{cname}权限为OWNER时，必须有owner属性"
msgstr "عندما تكون صلاحية {cname} هي OWNER، يجب أن تحتوي على خاصية owner."

#: hetu/data/component.py:766
#, python-brace-format
msgid "{cname}的owner属性必需是numeric数字(int, np.int64, ...)类型"
msgstr ""
"يجب أن تكون خاصية owner لـ {cname} من النوع الرقمي (int, np.int64, ...)."

#: hetu/data/component.py:772
#, python-brace-format
msgid "{cname}权限为RLS时，必须通过rls_compare参数定义行级权限逻辑"
msgstr ""
"عندما تكون صلاحية {cname} هي RLS، يجب تعريف منطق صلاحية مستوى الصف من خلال "
"معلمة rls_compare."

#: hetu/data/component.py:775
#, python-brace-format
msgid "{cname}.rls_compare参数必须全部是字符串类型"
msgstr ""
"يجب أن تكون جميع معلمات {cname}.rls_compare من نوع السلسلة النصية (string)."

#: hetu/data/component.py:778
#, python-brace-format
msgid "{cname}.rls_compare参数必须只有3个元素)"
msgstr "يجب أن تحتوي معلمة {cname}.rls_compare على 3 عناصر فقط."

#: hetu/data/component.py:782
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但operator模块没有{method}方法"
msgstr ""
"الصلاحية لـ {cname} هي RLS: {rls_compare}، لكن وحدة operator لا تحتوي على "
"طريقة {method}."

#: hetu/data/component.py:786
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但表没有定义{prop}属性"
msgstr ""
"الصلاحية لـ {cname} هي RLS: {rls_compare}، لكن الجدول لم يُعرّف الخاصية "
"{prop}."

#: hetu/data/component.py:803
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列必须是本组件的字段名，不能是id、_version：{col!r}"
msgstr ""
"خطأ في تعريف groupby للخاصية {cname}.{fname}، يجب أن يكون عمود التجميع اسم "
"حقل في هذا المكون، ولا يمكن أن يكون id أو _version: {col!r}"

#: hetu/data/component.py:809
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，不能按自己分组"
msgstr ""
"خطأ في تعريف groupby للخاصية {cname}.{fname}، لا يمكن التجميع حسب الخاصية "
"نفسها"

#: hetu/data/component.py:816
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，组件没有字段`{col}`"
msgstr ""
"خطأ في تعريف groupby للخاصية {cname}.{fname}، لا يحتوي المكون على الحقل "
"`{col}`"

#: hetu/data/component.py:822
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列`{col}`重复了"
msgstr ""
"خطأ في تعريف groupby للخاصية {cname}.{fname}، عمود التجميع `{col}` مكرر"

#: hetu/data/component.py:830
#, python-brace-format
msgid ""
"{cname}.{fname}的groupby定义出错，分组列`{col}`只能是整数、str、bytes类型，不能是{dtype}：浮点按等值分组没有意义，NaN、-0.0"
" 的相等也说不清"
msgstr ""
"خطأ في تعريف groupby للخاصية {cname}.{fname}، يمكن أن يكون عمود التجميع "
"`{col}` من نوع عدد صحيح أو str أو bytes فقط، ولا يمكن أن يكون {dtype}: "
"فالتجميع حسب القيم المتساوية للأعداد العشرية لا معنى له، كما أن تساوي NaN "
"و-0.0 غير محدّد"

#: hetu/data/component.py:842
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，{dtype}类型不能建索引"
msgstr ""
"خطأ في تعريف الخاصية {cname}.{fname}، لا يمكن إنشاء فهرس للنوع {dtype}"

#: hetu/data/component.py:855
#, python-brace-format
msgid "{cname}定义出错，最多只能有一个commit_seq字段：{fields}"
msgstr ""
"خطأ في تعريف {cname}، يمكن أن يوجد حقل commit_seq واحد على الأكثر: {fields}"

#: hetu/data/component.py:866
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的类型只能是np.int64，不能是{dtype}"
msgstr ""
"خطأ في تعريف الخاصية {cname}.{fname}، يمكن أن يكون نوع commit_seq هو "
"np.int64 فقط، ولا يمكن أن يكون {dtype}"

#: hetu/data/component.py:875
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的default必须是0：0表示还没发号，号从1开始"
msgstr ""
"خطأ في تعريف الخاصية {cname}.{fname}، يجب أن تكون قيمة default لـ commit_seq"
" هي 0: فالقيمة 0 تعني أنه لم يُمنح رقم بعد، والأرقام تبدأ من 1"

#: hetu/data/component.py:884
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq不能同时设置unique：组内唯一由发号保证"
msgstr ""
"خطأ في تعريف الخاصية {cname}.{fname}، لا يمكن تعيين unique مع commit_seq في "
"الوقت نفسه: فالتفرد داخل المجموعة مضمون بمنح الأرقام"

#: hetu/data/component.py:894
#, python-brace-format
msgid "{cname}.{other}的groupby定义出错，commit_seq字段`{fname}`不能当分组列：它的号要到提交时才有"
msgstr ""
"خطأ في تعريف groupby للخاصية {cname}.{other}، لا يمكن استخدام حقل commit_seq"
" `{fname}` كعمود تجميع: فرقمه لا يتوفر إلا عند الإيداع (commit)"

#: hetu/data/component.py:912
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq字段不能用作行级权限的判定列"
msgstr ""
"خطأ في تعريف الخاصية {cname}.{fname}، لا يمكن استخدام حقل commit_seq كعمود "
"تحديد لصلاحية مستوى الصف"

#: hetu/data/component.py:921
#, python-brace-format
msgid "组件名({name})是C#关键字，请refactor。"
msgstr ""
"اسم المكون ({name}) هو كلمة مفتاحية في C#، يُرجى إعادة الهيكلة (refactor)."

#: hetu/data/component.py:934
#, python-brace-format
msgid "{cls_name}.{name}不是Property类型"
msgstr "{cls_name}.{name} ليس من نوع Property."

#: hetu/data/component.py:944
#, python-brace-format
msgid ""
"{cls_name}.{name}属性未定义type hint。请使用以下形式，{name}: type = property_field(...)"
msgstr ""
"الخاصية {cls_name}.{name} لم تُعرّف type hint. يُرجى استخدام الصيغة التالية:"
" {name}: type = property_field(...)"

#: hetu/data/component.py:949
#, python-brace-format
msgid "{cls_name}至少要有1个Property成员"
msgstr "يجب أن يحتوي {cls_name} على عضو Property واحد على الأقل."

#: hetu/data/component.py:957
#, python-brace-format
msgid "{cls_name}.id是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}.id هو مفتاح أساسي مدمج محجوز، ولا يمكن إعادة تعريفه من الخارج."

#: hetu/data/component.py:960
#, python-brace-format
msgid "{cls_name}._version是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}._version هو مفتاح أساسي مدمج محجوز، ولا يمكن إعادة تعريفه من "
"الخارج."

#: hetu/data/component.py:969
#, python-brace-format
msgid "{cls_name}必须继承于BaseComponent"
msgstr "يجب أن يرث {cls_name} من BaseComponent."

#: hetu/data/component.py:977
#, python-brace-format
msgid "{cls_name}权限定义出错，Component不能用GM权限：GM只用于System/Endpoint的调用权限"
msgstr ""
"خطأ في تعريف الصلاحية لـ {cls_name}، لا يمكن استخدام صلاحية GM مع Component:"
" فـ GM يُستخدم فقط لصلاحية استدعاء System/Endpoint"

#: hetu/data/migration.py:39
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 发现自定义迁移脚本 {file}，将调用脚本进行迁移..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] تم العثور على برنامج ترحيل مخصص "
"{file}، سيتم استدعاء البرنامج للترحيل..."

#: hetu/data/migration.py:92
#, python-brace-format
msgid ""
"  ➖ [💾MIGRATION][{comp_name}组件] 缺少迁移脚本，生成默认迁移脚本 "
"{script_path}，请根据需要修改脚本内容后再执行迁移操作..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] برنامج الترحيل مفقود، جارٍ إنشاء "
"البرنامج الافتراضي {script_path}، يرجى تعديل محتوى البرنامج حسب الحاجة قبل "
"تنفيذ الترحيل..."

#: hetu/data/migration.py:212
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 执行upgrade迁移：{module}"
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] جارٍ تنفيذ upgrade الترحيل: {module}"

#: hetu/data/migration.py:218
#, python-brace-format
msgid "  ✔️ [💾MIGRATION][{comp_name}组件] Schema升级迁移完成，共处理{count}行"
msgstr ""
"  ✔️ [💾MIGRATION][{comp_name} Component] تم الانتهاء من ترقية Schema "
"الترحيل، تمت معالجة {count} صف إجمالاً"

#: hetu/data/migration.py:230
#, python-brace-format
msgid ""
"[💾MIGRATION][{comp_name}组件] "
"数据已经按新定义搬完，但重建索引失败：{error}。在修好之前服务器会拒绝启动：请直接修改表里的数据（比如用 TableMaintenance 的 "
"upsert_row 给重复的号重新编号），再跑一次 hetu upgrade，它会按当前定义直接重建索引"
msgstr ""
"[💾MIGRATION][{comp_name} Component] تم نقل البيانات وفقًا للتعريف الجديد، "
"لكن إعادة بناء الفهرس فشلت: {error}. سيرفض الخادم بدء التشغيل حتى يتم إصلاح "
"ذلك: يرجى تعديل البيانات في الجدول مباشرةً (مثلًا باستخدام upsert_row من "
"TableMaintenance لإعادة ترقيم الأرقام المكررة)، ثم تشغيل hetu upgrade مرة "
"أخرى، وسيعيد بناء الفهرس مباشرةً وفقًا للتعريف الحالي"

#: hetu/data/migration.py:237
#, python-brace-format
msgid "  ✔️ [💾MIGRATION][{comp_name}组件] 已重建Index"
msgstr "  ✔️ [💾MIGRATION][{comp_name} Component] تم إعادة بناء الفهرس"

#: hetu/data/sub.py:55
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] {comp_name} 按 id 点查询的范围订阅会订整个 id "
"索引的频道：这张表每次插入、删除都会叫醒它重跑比对。按 id 订单行请用行订阅（服务端 subscribe_get，客户端 WatchRow）"
msgstr ""
"⚠️ [📡Subscription] الاشتراك النطاقي للاستعلام النقطي بالمعرّف id في "
"{comp_name} يشترك في قناة الفهرس id بأكمله: كل إدراج أو حذف في هذا الجدول "
"سيوقظه لإعادة تشغيل المطابقة. لصفوف المعرّف استخدم اشتراك الصفوف (من جهة "
"الخادم subscribe_get، ومن جهة العميل WatchRow)"

#: hetu/data/sub.py:63
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] {comp_name}.{index_name} 没有声明 "
"point_sub，点查询订阅退化为区间订阅：该索引上任何写入都会叫醒它重跑比对。需要高效点订阅请在 property_field 里加 "
"point_sub=True"
msgstr ""
"⚠️ [📡Subscription] {comp_name}.{index_name} لم يعلن عن point_sub، لذا يتحول "
"اشتراك الاستعلام النقطي إلى اشتراك نطاقي: أي كتابة على هذا الفهرس ستوقظه "
"لإعادة تشغيل المطابقة. للحصول على اشتراك نقطي فعّال أضف point_sub=True في "
"property_field"

#: hetu/data/sub.py:405
#, python-brace-format
