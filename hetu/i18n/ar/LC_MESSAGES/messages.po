#: hetu/data/backend/redis_model.py:1450
#, python-brace-format
msgid "{comp_name}.{field} 是 commit_seq 列：不能改它，有号的行也不能改分组列（id={row_id}）"
msgstr ""
"{comp_name}.{field} هو عمود commit_seq: لا يمكن تعديله، كما لا يمكن تعديل "
"أعمدة التجميع للصفوف التي لها رقم (id={row_id})"

#: hetu/data/backend/redis_model.py:1589
#, python-brace-format
msgid "提交序号列发号失败，本次提交没有写入：{resp}"
msgstr "فشل إصدار رقم التسلسل، ولم تتم كتابة هذه العملية: {resp}"

#: hetu/data/backend/redis_model.py:1591
#, python-brace-format
msgid "未知的提交错误：{resp}"
msgstr "خطأ إرسال غير معروف: {resp}"

#: hetu/data/backend/redis_model.py:1622
msgid "从节点不允许提交事务"
msgstr "لا يُسمح للعقدة التابعة (Slave) بإرسال المعاملات"

#: hetu/data/backend/redis_model.py:1647
msgid "direct_set 至少要写一个字段"
msgstr "يجب على direct_set كتابة حقل واحد على الأقل"

#: hetu/data/backend/redis_model.py:1652
#, python-brace-format
msgid "索引字段`{prop}`不允许用direct_set修改"
msgstr "لا يُسمح بتعديل حقل الفهرس `{prop}` باستخدام direct_set"

#: hetu/data/backend/redis_model.py:1656
#, python-brace-format
msgid "Component `{comp_name}` 没有字段`{prop}`"
msgstr "المكون `{comp_name}` لا يحتوي على الحقل `{prop}`"

#: hetu/data/backend/repo.py:211
#, python-brace-format
msgid "row id({row_id})在session中未寻到，更新操作必须有旧数据。"
msgstr ""
"لم يتم العثور على معرف الصف ({row_id}) في الجلسة، عملية التحديث تتطلب بيانات"
" قديمة."

#: hetu/data/backend/repo.py:215 hetu/data/backend/repo.py:913
#, python-brace-format
msgid "session中已存在该row id({row_id})，插入操作必须没有旧数据。"
msgstr ""
"معرف الصف ({row_id}) موجود بالفعل في الجلسة، عملية الإدراج يجب ألا تحتوي على"
" بيانات قديمة."

#: hetu/data/backend/repo.py:327 hetu/data/backend/repo.py:598
#, python-brace-format
msgid "{comp_name} 的查询：kwargs 写法里分组值直接写成 字段=值，不要再给 _group"
msgstr ""
"استعلام {comp_name}: في صيغة kwargs تُكتب قيم التجميع مباشرةً بصيغة 字段=值، "
"دون إعطاء _group مرة أخرى"

#: hetu/data/backend/repo.py:342
#, python-brace-format
msgid "{comp_name} 的查询条件 {keys} 对不上任何索引：要么只给一个有索引的字段，要么正好给出复合索引的本字段和全部分组列"
msgstr ""
"شروط استعلام {comp_name} ‏{keys} لا تطابق أي فهرس: إما أن تعطي حقلًا واحدًا "
"مفهرسًا فقط، أو أن تعطي بالضبط حقل الفهرس المركّب هذا وجميع أعمدة التجميع"

#: hetu/data/backend/repo.py:350
#, python-brace-format
msgid "{comp_name} 的 upsert 条件 {keys} 同时匹配了 {matched} 几个 unique 索引，无法区分"
msgstr ""
"شروط upsert لـ {comp_name} ‏{keys} طابقت في الوقت نفسه {matched} من الفهارس "
"الفريدة (unique)، ولا يمكن التمييز بينها"

#: hetu/data/backend/repo.py:358
#, python-brace-format
msgid ""
"{comp_name} 的查询条件 {keys} 同时匹配了 {matched} 几个索引，请用 index_name、_group 参数指定"
msgstr ""
"شروط استعلام {comp_name} ‏{keys} طابقت في الوقت نفسه {matched} من الفهارس، "
"يرجى التحديد باستخدام المعاملين index_name و_group"

#: hetu/data/backend/repo.py:586
#, python-brace-format
msgid "range 的 kwargs 写法要有且只有一个 字段=(下界, 上界)，其余是复合索引的分组值，收到：{keys}"
msgstr ""
"يجب أن تحتوي صيغة kwargs لـ range على حقل واحد فقط بالشكل 字段=(الحد الأدنى, "
"الحد الأعلى)، والباقي قيم تجميع الفهرس المركّب، تم استلام: {keys}"

#: hetu/data/backend/repo.py:604
msgid "不使用kwargs形式时，index_name不能为空"
msgstr "عند عدم استخدام صيغة kwargs، لا يمكن أن يكون index_name فارغًا"

#: hetu/data/backend/repo.py:605
msgid "不使用kwargs形式时，left不能为空"
msgstr "عند عدم استخدام صيغة kwargs، لا يمكن أن يكون left فارغًا"

#: hetu/data/backend/repo.py:886
#, python-brace-format
msgid "{comp_name}.{field} 是提交序号列（commit_seq），号由提交时发，insert 时必须是 0，收到：{value}"
msgstr ""
"{comp_name}.{field} هو عمود رقم الإيداع (commit_seq)، يُمنح الرقم عند "
"الإيداع، ويجب أن يكون 0 عند insert، تم استلام: {value}"

#: hetu/data/backend/repo.py:897
#, python-brace-format
msgid ""
"{comp_name} 的 insert 行 id 为 0：本 Session 不发雪花号，请用 new_row(id_=...) 显式给出非零 id"
msgstr ""
"معرّف صف الإدراج لـ {comp_name} هو 0: هذه الجلسة لا تُصدر معرّفات snowflake،"
" يرجى استخدام new_row(id_=...) لتحديد معرّف غير صفري بشكل صريح"

#: hetu/data/backend/repo.py:906
#, python-brace-format
msgid ""
"{comp_name} 的行 id={row_id} 已在本事务中删除，不能再用同一个 id insert；要改这行请直接 update，不要先删再插"
msgstr ""
"الصف id={row_id} في {comp_name} قد حُذف بالفعل في هذه المعاملة، ولا يمكن "
"الإدراج بالمعرّف نفسه مرة أخرى؛ لتعديل هذا الصف استخدم update مباشرةً، لا "
"تحذف ثم تُدرج"

#: hetu/data/backend/repo.py:981
#, python-brace-format
msgid "{comp_name}.{field} 是提交序号列（commit_seq），号由提交时发，不能修改"
msgstr ""
"{comp_name}.{field} هو عمود رقم الإيداع (commit_seq)، يُمنح الرقم عند "
"الإيداع، ولا يمكن تعديله"

#: hetu/data/backend/repo.py:994
#, python-brace-format
msgid ""
"{comp_name}.{cols} 是提交序号列 {field} 的分组列，这一行已经有号（{seq}），不能改分组列：搬到别的组会和那一组的号重复"
msgstr ""
"{comp_name}.{cols} هي أعمدة التجميع لعمود رقم الإيداع {field}، هذا الصف لديه"
" رقم بالفعل ({seq})، ولا يمكن تغيير أعمدة التجميع: نقلُه إلى مجموعة أخرى "
"سيؤدي إلى تكرار الرقم مع تلك المجموعة"

#: hetu/data/backend/repo.py:1034
#, python-brace-format
msgid "upsert只能用于unique索引，{comp_name}组件的{index_name}不是unique索引"
msgstr ""
"يمكن استخدام upsert فقط مع الفهارس الفريدة، فهرس {index_name} للمكون "
"{comp_name} ليس فريدًا"

#: hetu/data/backend/repo.py:1094
#, python-brace-format
msgid ""
"{comp_name}.{index_name}={value} 不存在：本 Session 不发雪花号，upsert 只允许命中已有行，或改用 "
"upsert(id=...) 显式给出 id"
msgstr ""
"{comp_name}.{index_name}={value} غير موجود: هذه الجلسة لا تُصدر معرّفات "
"snowflake، يُسمح لـ upsert فقط بمطابقة الصفوف الموجودة، أو استخدم "
"upsert(id=...) لتحديد المعرّف صراحةً"

#: hetu/data/backend/repo.py:1109
#, python-brace-format
msgid ""
"upsert 的锚定值超过了 {comp_name}.{index_name} 的列宽 "
"{max_len}：{value}。新行存进去会被截断，之后拿这个值查不到它"
msgstr ""
"قيمة الارتكاز في upsert تتجاوز عرض العمود {max_len} لـ "
"{comp_name}.{index_name}: {value}. الصف الجديد سيُقتطع عند تخزينه، ولن يمكن "
"العثور عليه لاحقًا بهذه القيمة"

#: hetu/data/backend/session.py:237
msgid "事务超过最大重试次数。"
msgstr "تجاوزت المعاملة الحد الأقصى لعدد محاولات إعادة المحاولة."

#: hetu/data/backend/snowflake_lease.py:85
msgid "⌚ [📡Server] Worker ID分配失败，可能是反复宕机导致Worker ID分配满了，等待1秒后重试..."
msgstr ""
"⌚ [📡الخادم] فشل تخصيص معرف العامل، ربما بسبب تعطل متكرر أدى إلى استنفاد "
"معرفات العاملين، جاري إعادة المحاولة بعد ثانية واحدة..."

#: hetu/data/backend/snowflake_lease.py:105
#: hetu/data/backend/snowflake_lease.py:159
#, python-brace-format
msgid "[❄️ID] 写入时间戳高水位失败，将重试: {err}"
msgstr ""
"[❄️ID] فشلت كتابة العلامة المائية العليا للطابع الزمني، ستتم إعادة المحاولة:"
" {err}"

#: hetu/data/backend/snowflake_lease.py:121
#, python-brace-format
msgid "❌ [📡WorkerKeeper] 续约失败，将重试: {err}"
msgstr "❌ [📡حافظ العامل] فشل التجديد، سيتم إعادة المحاولة: {err}"

#: hetu/data/backend/snowflake_lease.py:138
#, python-brace-format
msgid "❌ [📡WorkerKeeper] 续约异常，将重试: {err}"
msgstr ""
"❌ [📡حافظ العامل] حدث استثناء أثناء التجديد، ستتم إعادة المحاولة: {err}"

#: hetu/data/backend/snowflake_lease.py:174
#, python-brace-format
msgid "[❄️ID] 关服时写入时间戳高水位失败: {err}"
msgstr ""
"[❄️ID] فشلت كتابة العلامة المائية العليا للطابع الزمني عند إيقاف الخادم: "
"{err}"

#: hetu/data/backend/snowflake_lease.py:183
#, python-brace-format
msgid "[❄️ID] 释放 Worker ID 失败，等它自己过期: {err}"
msgstr "[❄️ID] فشل تحرير معرف العامل، بانتظار انتهاء صلاحيته تلقائيًا: {err}"

#: hetu/data/backend/snowflake_timestamp.py:131
#, python-brace-format
msgid "[❄️ID] 读取时间戳高水位失败，退化为固定容忍度: {err}"
msgstr ""
"[❄️ID] فشل قراءة الحد الأعلى للطابع الزمني، تم التراجع إلى تسامح ثابت: {err}"

#: hetu/data/backend/snowflake_timestamp.py:143
#, python-brace-format
msgid "[❄️ID] 记录的高水位比当前时间超前 {ms} 毫秒（上次未正常关服，或重启期间时钟回拨），已从高水位继续发号，避免ID重复"
msgstr ""
"[❄️ID] الحد الأعلى المسجّل متقدّم على الوقت الحالي بمقدار {ms} مللي ثانية "
"(لم يتم إغلاق الخادم بشكل سليم في المرة السابقة، أو حدث رجوع للساعة أثناء "
"إعادة التشغيل)، لذا تم الاستمرار في توليد المعرّفات من الحد الأعلى لتجنّب "
"تكرار ID"

#: hetu/data/backend/snowflake_timestamp.py:208
#, python-brace-format
msgid "[❄️ID] 补建时间戳高水位行失败（下个周期会重试）: {err}"
msgstr ""
"[❄️ID] فشل إنشاء صف الحد الأعلى للطابع الزمني (ستتم إعادة المحاولة في الدورة"
" التالية): {err}"

#: hetu/data/backend/worker_keeper.py:101
#, python-brace-format
msgid "Worker序号 {worker_id} 超出雪花ID上限 {max}"
msgstr "رقم Worker {worker_id} يتجاوز الحد الأقصى لمعرف Snowflake {max}"

#: hetu/data/backend/worker_keeper.py:108
#, python-brace-format
msgid ""
"[❄️ID] [开发模式] 使用本机进程序号作为 Worker ID: {worker_id}。此模式只保证单机内不重复，多机部署请改用 Redis "
"后端"
msgstr ""
"[❄️ID] [وضع التطوير] استخدام رقم العملية المحلي كـ Worker ID: {worker_id}. "
"يضمن هذا الوضع عدم التكرار داخل جهاز واحد فقط؛ عند النشر على عدة أجهزة يُرجى"
" استخدام Redis Backend"

#: hetu/data/backend/redis/worker_keeper.py:179
#: hetu/data/backend/redis/worker_keeper.py:226
#: hetu/data/backend/worker_keeper.py:183
#, python-brace-format
msgid "[❄️ID] 成功获取 Worker ID: {worker_id}, 进程码: {node_id}"
msgstr ""
"[❄️ID] تم الحصول على معرف العامل بنجاح: {worker_id}, رمز العملية: {node_id}"

#: hetu/data/backend/worker_keeper.py:189
#, python-brace-format
msgid "并发的 hetu call / shell 进程太多：SQLite 上预留给它们的 {count} 个 Worker ID 都被占用了"
msgstr ""
"عدد كبير جدًا من عمليات hetu call / shell المتزامنة: جميع معرّفات Worker ID "
"المحجوزة لها في SQLite والبالغ عددها {count} مشغولة بالفعل"

#: hetu/data/backend/worker_keeper.py:200
#, python-brace-format
msgid ""
"[❄️ID] 续约 Worker ID {worker_id} 失败: "
"租约已不属于本进程（可能因本进程长时间卡住导致租约过期后被其他实例接手），继续发号会产生重复雪花ID"
msgstr ""
"[❄️ID] فشل تجديد Worker ID {worker_id}: لم يعد الـ lease مملوكًا لهذه "
"العملية (قد يكون ذلك بسبب بقاء هذه العملية معلّقة لفترة طويلة، مما أدى إلى "
"انتهاء صلاحية الـ lease وتولّي نسخة أخرى له)، والاستمرار في إصدار الأرقام "
"سيؤدي إلى تكرار معرّفات Snowflake"

#: hetu/data/backend/worker_keeper.py:205
msgid "Worker ID 续约失败"
msgstr "فشل تجديد Worker ID"

#: hetu/data/backend/redis/worker_keeper.py:250
#: hetu/data/backend/worker_keeper.py:219
#, python-brace-format
msgid "[❄️ID] 释放 Worker ID: {worker_id}"
msgstr "[❄️ID] تحرير معرف العامل: {worker_id}"

#: hetu/data/backend/redis/worker_keeper.py:256
#: hetu/data/backend/worker_keeper.py:223
#, python-brace-format
msgid "[❄️ID] Worker ID {worker_id} 的租约已不属于本进程，跳过释放"
msgstr ""
"[❄️ID] عقد إيجار معرف العامل {worker_id} لم يعد ملكًا لهذه العملية، تم تخطي "
"التحرير"

#: hetu/data/backend/redis/client.py:81
msgid "Servant不允许加载Lua事务脚本，Lua事务脚本只能在Master上加载"
msgstr ""
"لا يُسمح للخادم المساعد (Servant) بتحميل نصوص معاملات Lua، يمكن تحميل نصوص "
"معاملات Lua على الخادم الرئيسي (Master) فقط"

#: hetu/data/backend/redis/client.py:84
msgid "Lua事务脚本只能在Master上加载，但当前连接池中有多个服务器"
msgstr ""
"يمكن تحميل نصوص معاملات Lua على الخادم الرئيسي (Master) فقط، ولكن هناك عدة "
"خوادم في مجموعة الاتصال الحالية"

#: hetu/data/backend/redis/client.py:120
#, python-brace-format
msgid "ℹ️ [💾Redis] master 上用不了 HSETEX（{err}），direct_set 改用同样语义的 Lua 脚本（稍慢）"
msgstr ""
"ℹ️ [💾Redis] لا يمكن استخدام HSETEX على master ({err})، لذا يتحول direct_set "
"إلى نص Lua بنفس الدلالة (أبطأ قليلًا)"

#: hetu/data/backend/redis/client.py:139
#: hetu/data/backend/sqlite/client.py:154
msgid "Backend只能在同一个coroutine中使用。检测到调用此函数的协程发生了变化"
msgstr ""
"يمكن استخدام Backend داخل نفس coroutine فقط. تم اكتشاف تغيير في coroutine "
"الذي يستدعي هذه الدالة"

#: hetu/data/backend/redis/client.py:186
msgid "必须至少指定一个数据库连接URL"
msgstr "يجب تحديد عنوان اتصال قاعدة بيانات واحد على الأقل"

#: hetu/data/backend/redis/client.py:222
#, python-brace-format
msgid "无法连接到Redis数据库：{url}"
msgstr "تعذر الاتصال بقاعدة بيانات Redis: {url}"

#: hetu/data/backend/redis/client.py:231
#, python-brace-format
msgid ""
"Redis数据库 {url} 不支持 HELLO 命令（RESP3 握手）。通常是前面挂了不支持 RESP3 的代理层，请在 url 后追加 "
"?protocol=2 降级到 RESP2，master 和 servants 都要加。"
msgstr ""
"قاعدة بيانات Redis {url} لا تدعم أمر HELLO (مصافحة RESP3). عادةً يكون السبب "
"وجود طبقة proxy لا تدعم RESP3 أمامها، يرجى إضافة ?protocol=2 بعد url للتراجع"
" إلى RESP2، ويجب إضافتها لكل من master وservants."

#: hetu/data/backend/redis/client.py:237
#, python-brace-format
msgid "连接Redis数据库 {url} 时服务端返回错误：{error}"
msgstr "أعاد الخادم خطأً عند الاتصال بقاعدة بيانات Redis {url}: {error}"

#: hetu/data/backend/redis/client.py:338
#, python-brace-format
msgid ""
"⚠️ [💾Redis] 无权限调用数据库{url}的config_set命令，数据订阅将不起效。可手动设置配置文件：notify-keyspace-"
"events={keyspace}"
msgstr ""
"⚠️ [💾Redis] لا توجد صلاحية لاستدعاء أمر config_set لقاعدة البيانات {url}، لن"
" يعمل الاشتراك في البيانات. يمكن تعيين ملف الإعدادات يدويًا: notify-"
"keyspace-events={keyspace}"

#: hetu/data/backend/redis/client.py:366
msgid "is_synced只能在master上调用"
msgstr "يمكن استدعاء is_synced على الخادم الرئيسي (Master) فقط"

#: hetu/data/backend/redis/client.py:545
msgid "lua_commit脚本没有初始化，请先调用 post_configure"
msgstr "لم يتم تهيئة نص lua_commit، يرجى استدعاء post_configure أولاً"

#: hetu/data/backend/redis/client.py:595
#: hetu/data/backend/sqlite/client.py:324
msgid "消息队列只能挂在同类后端的连接上"
msgstr "لا يمكن ربط قائمة انتظار الرسائل إلا باتصالات Backend من النوع نفسه"

#: hetu/data/backend/redis/mq.py:110
#, python-brace-format
msgid "⚠️ [💾Redis] 取消订阅 {count} 个频道失败：{err}"
msgstr "⚠️ [💾Redis] فشل إلغاء الاشتراك في {count} قناة: {err}"

#: hetu/data/backend/redis/mq.py:129
#, python-brace-format
msgid "🔔 [💾Redis] 收到订阅更新通知: {channel_name}"
msgstr "🔔 [💾Redis] تم استلام إشعار تحديث الاشتراك: {channel_name}"

#: hetu/data/backend/redis/mq.py:153
#, python-brace-format
msgid ""
"⚠️ [💾Redis] pubsub 连接断了，{count} 个频道在恢复前收不到通知：挂了多个副本的订阅换到别的副本重订，其余的等它重连后重订、补读"
msgstr ""
"⚠️ [💾Redis] انقطع اتصال pubsub، ولن تتلقى {count} قناة إشعارات قبل "
"الاستعادة: الاشتراكات الموزعة على عدة نسخ يُعاد الاشتراك فيها على نسخ أخرى، "
