msgstr "🔗 [⚙️Future] تم تحرير {deleted} من call lock المنتهية الصلاحية"

#: hetu/system/future.py:660
#, python-brace-format
msgid "⚠️ [⚙️Future] Task执行异常，将再次重试：{exc}"
msgstr "⚠️ [⚙️Future] استثناء في تنفيذ Task، ستتم إعادة المحاولة: {exc}"

#: hetu/system/lock.py:94
#, python-brace-format
msgid "🔗 [⚙️Future] 释放了 {comp_name} 的 {deleted} 条过期数据"
msgstr ""
"🔗 [⚙️Future] تم تحرير {deleted} من البيانات المنتهية الصلاحية لـ {comp_name}"

#: hetu/system/startup.py:88
