#: hetu/headless.py:83
#, python-brace-format
msgid ""
"实例 {instance} 里不存在组件表 {comp_name}：请先启动 HeTu 服务器建表（或检查 instance / 组件名 / "
"后端配置是否指向同一个数据库）"
msgstr ""
"В экземпляре {instance} отсутствует таблица Component {comp_name}: сначала "
"запустите сервер HeTu для создания таблиц (или проверьте, что экземпляр / "
"имя Component / конфигурация Backend указывают на одну и ту же базу данных)"

#: hetu/headless.py:102
#, python-brace-format
msgid "组件 {comp_name} 的本地定义与服务器表结构不一致（服务器 -> 本地）：{diff}"
msgstr ""
"Локальное определение Component {comp_name} не соответствует структуре "
"таблицы на сервере (сервер -> локально): {diff}"

#: hetu/headless.py:119
#, python-brace-format
msgid ""
"组件 {comp_name} 的 cluster_id 已由 {old_id} 变为 {new_id}（服务器已迁簇），请重新 connect"
msgstr ""
"cluster_id у Component {comp_name} изменился с {old_id} на {new_id} (сервер "
"перенёс кластер), пожалуйста, выполните connect заново"

#: hetu/headless.py:248
#, python-brace-format
msgid ""
"组件 {name} 未在本事务声明（或不是 connect 时认下的那个类），请在 client.session(...) "
"里加上；已声明：{declared}"
msgstr ""
"Component {name} не объявлен в этой транзакции (или это не тот класс, "
"который был распознан при connect), добавьте его в client.session(...); "
"объявлено: {declared}"

#: hetu/headless.py:295 hetu/headless.py:316
#, python-brace-format
msgid "组件 {name} 重复声明"
msgstr "Component {name} объявлен повторно"

#: hetu/headless.py:309
msgid "components 不能为空：至少声明一个组件"
msgstr ""
"Параметр components не может быть пустым: объявите хотя бы один Component"

#: hetu/headless.py:330
#, python-brace-format
msgid "⚠️ [🧩Headless] 组件 {name} 的默认值与服务器不同（只影响本进程 new_row 的填充值）：{diff}"
msgstr ""
"⚠️ [🧩Headless] Значение по умолчанию Component {name} отличается от "
"серверного (влияет только на заполнение значений new_row в текущем "
"процессе): {diff}"

#: hetu/headless.py:337
#, python-brace-format
msgid "[🧩Headless] 实例 {instance} 组件表 {name} → cluster {cid}"
msgstr ""
"[🧩Headless] Экземпляр {instance}: таблица Component {name} → кластер {cid}"

#: hetu/headless.py:370
#, python-brace-format
msgid "组件 {name} 未在 connect(components=...) 里声明；已声明：{declared}"
msgstr ""
"Component {name} не объявлен в connect(components=...); объявлено: "
"{declared}"

#: hetu/headless.py:376
#, python-brace-format
msgid ""
"组件 {name} 是按名字声明的，其类来自服务器 meta，请用 client.table('{name}').comp_cls 而不是本地类"
msgstr ""
"Component {name} объявлен по имени, его класс получен из meta сервера; "
"используйте client.table('{name}').comp_cls вместо локального класса"

#: hetu/headless.py:394
msgid "session() 至少要声明一个组件"
msgstr "session() должен объявлять хотя бы один Component"

#: hetu/headless.py:401
#, python-brace-format
msgid "同一事务的组件必须同簇（簇由服务器 System 的引用关系决定，跨簇请拆成两个事务）：{detail}"
msgstr ""
"Components одной транзакции должны находиться в одном кластере (кластер "
"определяется ссылочными отношениями System на сервере; если кластеры "
"различаются, разделите транзакцию на две): {detail}"

#: hetu/local.py:86
msgid "库里没有这张表：先用当前代码启动一次服务器（会建新表）"
msgstr ""
"В базе нет этой таблицы: сначала запустите сервер один раз с текущим кодом "
"(таблица будет создана)"

#: hetu/local.py:89
msgid "本地代码与库里的表结构 / 簇不一致：先 hetu upgrade，或用与线上一致的代码版本运行"
msgstr ""
"Локальный код не соответствует структуре таблиц / кластеру в базе: сначала "
"выполните hetu upgrade или запускайте версию кода, совпадающую с рабочей"

#: hetu/local.py:93
#, python-brace-format
msgid "组件 {comp_name} 的表状态为 {status}，{hint}"
msgstr "Состояние таблицы Component {comp_name} — {status}, {hint}"

#: hetu/local.py:117
#, python-brace-format
msgid ""
"System {system} 是 USER 权限：生产里只有已登录连接能调，请指定玩家 id（hetu call 用 --as <uid>，代码里传 "
"caller=）"
msgstr ""
"System {system} имеет права USER: в продакшене его могут вызывать только "
"авторизованные соединения, укажите id игрока (для hetu call используйте --as"
" <uid>, в коде передайте caller=)"

#: hetu/cli/build.py:46 hetu/local.py:128
#, python-brace-format
msgid "无法加载app文件 {app_file}"
msgstr "Не удалось загрузить файл приложения {app_file}"

#: hetu/local.py:376
#, python-brace-format
msgid "找不到 Component：{comp}（是否在 components 中引用过？）"
msgstr "Component не найден: {comp} (был ли он указан в components?)"

#: hetu/local.py:397
#, python-brace-format
msgid "{comp} 中不存在匹配 {query} 的行"
msgstr "В {comp} нет строк, соответствующих {query}"

#: hetu/local.py:443
#, python-brace-format
msgid "{comp} 组件没有叫 {name} 的字段"
msgstr "У Component {comp} нет поля с именем {name}"

#: hetu/local.py:448
msgid "_version 由引擎管理，insert 时不能设置"
msgstr "_version управляется движком, его нельзя задавать при insert"

#: hetu/local.py:509
#, python-brace-format
msgid "库文件不存在：{path}（服务器还没在这个库上启动过，或配置路径不对）"
msgstr ""
"Файл базы не существует: {path} (сервер ещё не запускался на этой базе или "
"путь в конфигурации неверен)"

#: hetu/cli/base.py:238 hetu/local.py:562
#, python-brace-format
msgid "实例 {instance} 不在配置的 INSTANCES 里：{instances}"
msgstr "Экземпляр {instance} отсутствует в настроенном INSTANCES: {instances}"

#: hetu/manager.py:57
#, python-brace-format
msgid "Backend {backend}未找到"
msgstr "Бэкенд {backend} не найден"

#: hetu/manager.py:104
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表结构需要迁移Schema。"
msgstr "⚠️  Для компонента {comp_name} требуется миграция схемы таблицы."

#: hetu/manager.py:111
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表需要迁移到新集群。"
msgstr ""
"⚠️  Таблицу компонента {comp_name} необходимо перенести в новый кластер."

#: hetu/webext.py:91
#, python-brace-format
msgid "define_route的uri必须以'/'开头，你的：{uri}"
msgstr "uri в define_route должен начинаться с '/', ваш: {uri}"

#: hetu/webext.py:96
#, python-brace-format
msgid "define_route的uri不能占用HeTu保留的'{prefix}'路径（客户端SDK的WebSocket入口），你的：{uri}"
msgstr ""
"uri в define_route не может занимать зарезервированный HeTu путь '{prefix}' "
"(точка входа WebSocket клиентского SDK), ваш: {uri}"

#: hetu/cli/__init__.py:70
msgid "河图数据库"
msgstr "База данных Hetu"

#: hetu/cli/__init__.py:75
msgid "执行操作"
msgstr "Выполнить операцию"

#: hetu/cli/__init__.py:103
#, python-brace-format
msgid "无法识别的参数：{extras}"
msgstr "Нераспознанные аргументы: {extras}"

#: hetu/cli/base.py:46
msgid "Boolean value expected."
msgstr "Ожидается логическое значение."

#: hetu/cli/base.py:69
#, python-brace-format
msgid ""
"SQL 后端已移除，PostgreSQL / MariaDB 不再支持：'{scheme}'。开发用 sqlite:///<库文件路径>，生产用 "
"Redis"
msgstr ""
"SQL Backend удалён, PostgreSQL / MariaDB больше не поддерживаются: "
"'{scheme}'. Для разработки используйте sqlite:///<путь к файлу БД>, для "
"продакшена — Redis"

#: hetu/cli/base.py:77
#, python-brace-format
msgid "不支持的数据库URL scheme: '{scheme}'。目前支持 redis/rediss/valkey/valkeys/sqlite"
msgstr ""
"Неподдерживаемая схема URL базы данных: '{scheme}'. Сейчас поддерживаются "
"redis/rediss/valkey/valkeys/sqlite"

#: hetu/cli/base.py:106
#, python-brace-format
msgid "⚠️ SQLite 库文件的相对路径现在按配置文件所在目录解析：{new}。旧位置（相对当前目录）{old} 有库文件，如需沿用请把它挪过去"
msgstr ""
"⚠️ Относительный путь к файлу базы SQLite теперь разрешается относительно "
"каталога, где лежит файл конфигурации: {new}. В старом месте (относительно "
"текущего каталога) {old} есть файл базы данных; если хотите его "
"использовать, переместите его туда"

#: hetu/cli/base.py:125
#, python-brace-format
msgid "读不了配置文件 {path}：{err}"
msgstr "Не удалось прочитать файл конфигурации {path}: {err}"

#: hetu/cli/base.py:128
#, python-brace-format
msgid "配置文件 {path} 不是一个映射"
msgstr "Файл конфигурации {path} не является словарём (mapping)"

#: hetu/cli/base.py:192
#, python-brace-format
msgid "命令行参数模式缺少：{missing}（或改用 --config）"
msgstr ""
"В режиме аргументов командной строки не хватает: {missing} (или используйте "
"--config)"

#: hetu/cli/base.py:223
msgid ""
"找不到配置：用 --config 指定，或设环境变量 HETU_CONFIG，或在当前目录放 config.yml；也可以用 --app-file / "
"--namespace / --instance / --db 直接给出"
msgstr ""
"Конфигурация не найдена: укажите её через --config, или задайте переменную "
"окружения HETU_CONFIG, или положите config.yml в текущий каталог; также "
"можно задать напрямую через --app-file / --namespace / --instance / --db"

#: hetu/cli/base.py:233
msgid "配置里没有 INSTANCES"
msgstr "В конфигурации нет INSTANCES"

#: hetu/cli/base.py:247
msgid "配置"
msgstr "Конфигурация"

#: hetu/cli/base.py:251
msgid "配置文件；不给时依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Файл конфигурации; если не указан, последовательно ищутся переменная "
"окружения HETU_CONFIG и config.yml в текущем каталоге"

#: hetu/cli/base.py:256
msgid "实例名，默认取配置里 INSTANCES 的第一个"
msgstr ""
"Имя экземпляра; по умолчанию берётся первый из INSTANCES в конфигурации"

#: hetu/cli/base.py:259
msgid "（无配置文件时）河图app的py文件"
msgstr "(если нет файла конфигурации) py-файл приложения hetu"

#: hetu/cli/base.py:262
msgid "（无配置文件时）app的namespace"
msgstr "(если нет файла конфигурации) namespace приложения"

#: hetu/cli/base.py:267
msgid "（无配置文件时）后端数据库地址"
msgstr "(если нет файла конфигурации) адрес базы данных Backend"

#: hetu/cli/build.py:22
msgid "生成客户端SDK C# 类型代码"
msgstr "Сгенерировать код типов C# для клиентского SDK"

#: hetu/cli/build.py:26
msgid "河图app的py文件"
msgstr "Python-файл приложения Hetu"

#: hetu/cli/build.py:33
msgid "编译app.py中哪个namespace下的数据类型"
msgstr "Какие типы данных в namespace компилировать из app.py"

#: hetu/cli/build.py:37
msgid "输出文件路径"
msgstr "Путь к выходному файлу"

#: hetu/cli/build.py:59
#, python-brace-format
msgid "✅ 已生成C#代码到 {output}"
msgstr "✅ Код C# сгенерирован в {output}"

#: hetu/cli/call.py:85
#, python-brace-format
msgid ""
"第 {n} 个参数看起来是 JSON 但解析失败（PowerShell 可能吃掉了引号），改用 --args-file 或 stdin：{raw}"
msgstr ""
"Параметр №{n} выглядит как JSON, но разобрать его не удалось (возможно, "
"PowerShell съел кавычки); используйте --args-file или stdin: {raw}"

#: hetu/cli/call.py:104
#, python-brace-format
msgid "--args-file 读不了或不是合法 JSON：{err}"
msgstr "Не удалось прочитать --args-file или это не корректный JSON: {err}"

#: hetu/cli/call.py:107
msgid "--args-file 的内容必须是 JSON 数组"
msgstr "Содержимое --args-file должно быть JSON-массивом"

#: hetu/cli/call.py:122
#, python-brace-format
msgid "--user-data 读不了或不是合法 JSON：{err}"
msgstr "Не удалось прочитать --user-data или это не корректный JSON: {err}"

#: hetu/cli/call.py:125
msgid "--user-data 必须是 JSON 对象"
msgstr "--user-data должен быть JSON-объектом"

#: hetu/cli/call.py:135
#, python-brace-format
msgid "System {name} 要 {low}-{high} 个参数，给了 {n} 个"
msgstr "System {name} требует от {low} до {high} аргументов, а передано {n}"

#: hetu/cli/call.py:162
#, python-brace-format
msgid "，相近的有：{close}"
msgstr ", похожие: {close}"

#: hetu/cli/call.py:164
#, python-brace-format
msgid "不存在的 System：{name}{hint}（hetu call --list 查看全部）"
msgstr ""
"System не существует: {name}{hint} (hetu call --list — посмотреть все)"

#: hetu/cli/call.py:293
#, python-brace-format
msgid ""
"System {name} 超过 {timeout} 秒没结束，已中止。若超时发生在提交途中，提交可能已经生效：writes 里 committed 为"
" unknown 的那次，请直接查数据确认"
msgstr ""
"System {name} не завершился за {timeout} секунд и был прерван. Если таймаут "
"случился во время коммита, коммит мог уже примениться: тот раз в writes, где"
" committed равен unknown, — проверьте данные напрямую"

#: hetu/cli/call.py:303
#, python-brace-format
msgid "System 留下 {n} 个后台任务，CLI 退出时已取消（在服务器里它们会继续跑）"
msgstr ""
"System оставил {n} фоновых задач; при выходе CLI они были отменены (на "
"сервере они продолжили бы работу)"

#: hetu/cli/call.py:333
msgid "--args-file 与位置参数不能同时给"
msgstr "--args-file и позиционные аргументы нельзя указывать одновременно"

#: hetu/cli/call.py:348
#, python-brace-format
msgid "生产端点不会放行这个身份（caller={caller}，group={group}）调用 {permission} 权限的 System"
msgstr ""
"Продакшн-эндпоинт не пропустит эту идентичность (caller={caller}, "
"group={group}) к вызову System с разрешением {permission}"

#: hetu/cli/call.py:359
#, python-brace-format
msgid "System {name} 读了 ctx.caller，而当前 caller 是推断出来的 0；要以玩家身份跑请用 --as <uid>"
msgstr ""
"System {name} читает ctx.caller, а текущий caller — вычисленный 0; чтобы "
"запустить от имени игрока, используйте --as <uid>"

#: hetu/cli/call.py:441
msgid ""
"在本进程里直连后端调用一个 System（不经服务器），stdout 输出一行 JSON。调试用：写入与 System "
"走同一条提交路径，在线客户端照常收到推送"
msgstr ""
"Вызвать System напрямую к Backend в этом процессе (без сервера); stdout "
"выведет одну строку JSON. Для отладки: записи идут тем же путём коммита, что"
" и System, а онлайн-клиенты как обычно получают push"

#: hetu/cli/call.py:449
msgid "列出全部 System（参数、权限、引用的组件、文档第一行），不连数据库"
msgstr ""
"Перечислить все System (аргументы, разрешения, используемые Component, "
"первая строка документации), без подключения к базе данных"

#: hetu/cli/call.py:451
msgid "身份"
msgstr "Идентичность"

#: hetu/cli/call.py:458
msgid ""
"以这个玩家 id 调用（ctx.caller）。USER 权限的 System 必须给；不给时按权限推断：ADMIN/GM/内部 System 用 "
"admin，EVERYBODY 用 guest"
msgstr ""
"Вызывать от имени этого id игрока (ctx.caller). Обязательно для System с "
"разрешением USER; если не указано, выводится из разрешения: для "
"ADMIN/GM/внутренних System — admin, для EVERYBODY — guest"

#: hetu/cli/call.py:465
msgid "ctx.group，如 gm / admin；给了 --as 时默认 guest"
msgstr "ctx.group, например gm / admin; при указании --as по умолчанию guest"

#: hetu/cli/call.py:470
msgid "ctx.user_data（登录时写进去的数据 CLI 不知道，需要时手动给）"
msgstr ""
"ctx.user_data (данные, записанные при входе; CLI о них не знает, при "
"необходимости укажите вручную)"

#: hetu/cli/call.py:476
msgid "从文件读参数（一个 JSON 数组），- 为 stdin；避开 PowerShell 的引号问题"
msgstr ""
"Читать аргументы из файла (JSON-массив), - означает stdin; обходит проблемы "
"с кавычками в PowerShell"

#: hetu/cli/call.py:482
msgid "调用锁 uuid（call_lock 的 System），同一 uuid 只执行一次"
msgstr ""
"uuid блокировки вызова (System call_lock); с одним и тем же uuid выполняется"
" только один раз"

#: hetu/cli/call.py:487
msgid "照常执行但不提交，输出它会写什么（写集）"
msgstr ""
"Выполнить как обычно, но не коммитить; вывести, что оно запишет (набор "
"записей)"

#: hetu/cli/call.py:494
msgid "System 调用的超时秒数，默认 30，0 为不限"
msgstr ""
"Таймаут вызова System в секундах, по умолчанию 30, 0 — без ограничения"

#: hetu/cli/call.py:501 hetu/cli/data.py:398 hetu/cli/shell.py:364
msgid "stderr 上多打日志：-v 为 INFO，-vv 为 DEBUG"
msgstr "Больше логов в stderr: -v — INFO, -vv — DEBUG"

#: hetu/cli/call.py:503
msgid "System 名"
msgstr "Имя System"

#: hetu/cli/call.py:508
msgid "参数：按 JSON 解析，解析不了当字符串；- 开头的放在 -- 后面"
msgstr ""
"Аргументы: разбираются как JSON, если не получается — как строка; аргументы,"
" начинающиеся с -, ставьте после --"

#: hetu/cli/call.py:518
msgid "要给 System 名（hetu call --list 查看全部）"
msgstr "Нужно указать имя System (hetu call --list — посмотреть все)"

#: hetu/cli/console.py:67
msgid ""
"本配置禁止 hetu call / shell 写入（CLI_ALLOW_WRITE: false）：加 --dry-run 看它会写什么，或在配置里设"
" CLI_ALLOW_WRITE: true"
msgstr ""
"Данная конфигурация запрещает запись через hetu call / shell "
"(CLI_ALLOW_WRITE: false): добавьте --dry-run, чтобы увидеть, что будет "
"записано, или установите в конфигурации CLI_ALLOW_WRITE: true"

#: hetu/cli/console.py:366
#, python-brace-format
msgid "审计日志写不进去：{path}（{err}）。可用配置 CLI_AUDIT_LOG 改路径"
msgstr ""
"Не удаётся записать журнал аудита: {path} ({err}). Путь можно изменить в "
"конфигурации CLI_AUDIT_LOG"

#: hetu/cli/console.py:376
#, python-brace-format
msgid "⚠️ 审计日志写不进去：{path}（{err}）"
msgstr "⚠️ Не удаётся записать журнал аудита: {path} ({err})"

#: hetu/cli/console.py:550
msgid "DEBUG 关闭的配置（按生产库对待）上 CLI 刚刚真写入了数据；要禁止，在配置里设 CLI_ALLOW_WRITE: false"
msgstr ""
"CLI только что действительно записал данные в конфигурацию с отключённым "
"DEBUG (рассматривается как production-база); чтобы запретить это, установите"
" в конфигурации CLI_ALLOW_WRITE: false"

#: hetu/cli/console.py:630
msgid "Worker ID 租约丢失（本进程卡住太久被别人接手），命令已中止"
msgstr ""
"Потеряна аренда Worker ID (этот процесс слишком долго завис, и его подхватил"
" другой), команда прервана"

#: hetu/cli/console.py:653
#, python-brace-format
msgid "⚠️ 后台任务 {task} 退出时出错：{err}"
msgstr "⚠️ Ошибка при завершении фоновой задачи {task}: {err}"

#: hetu/cli/console.py:659
#, python-brace-format
msgid "⚠️ {n} 个后台任务 {timeout} 秒内没有响应取消，不再等待"
msgstr ""
"⚠️ {n} фоновых задач не отреагировали на отмену за {timeout} секунд, "
"ожидание прекращено"

#: hetu/cli/console.py:672
#, python-brace-format
msgid "收尾释放租约 / 关闭连接时出错（不影响已经完成的操作）：{err}"
msgstr ""
"Ошибка при освобождении аренды / закрытии соединения на этапе завершения (не"
" влияет на уже выполненные операции): {err}"

#: hetu/cli/data.py:65
#, python-brace-format
msgid "值 {raw} 不能转换成列类型 {dtype}"
msgstr "Значение {raw} не может быть преобразовано в тип столбца {dtype}"

#: hetu/cli/data.py:89
#, python-brace-format
msgid "分组值 {raw} 不能转换成列类型 {dtype}"
msgstr ""
"Значение группы {raw} не может быть преобразовано в тип столбца {dtype}"

#: hetu/cli/data.py:100 hetu/cli/data.py:282
msgid "查询要写成 FIELD=VALUE，如 owner=1001"
msgstr "Запрос должен быть в виде FIELD=VALUE, например owner=1001"

#: hetu/cli/data.py:104
#, python-brace-format
msgid "{field} 给了不止一次"
msgstr "{field} указан более одного раза"

#: hetu/cli/data.py:122
#, python-brace-format
msgid ""
"组件 {comp} 的 {field} 不是 id 或带索引的字段，不能查；可查的有：{fields}（括号里是复合索引的分组列，查询时要一并用 "
"FIELD=VALUE 给出）"
msgstr ""
"Поле {field} в Component {comp} не является id или индексированным полем, по"
" нему нельзя выполнять запрос; доступны для запроса: {fields} (в скобках — "
"группирующие столбцы составного индекса, при запросе их нужно указывать "
"вместе в виде FIELD=VALUE)"

#: hetu/cli/data.py:140
#, python-brace-format
msgid "--index {index} 要同时用 {index}=VALUE 给出查询值"
msgstr ""
"Для --index {index} нужно также указать значение запроса в виде "
"{index}=VALUE"

#: hetu/cli/data.py:157
#, python-brace-format
msgid ""
"查询条件 {keys} 对不上组件 {comp} "
"的任何索引：要么只给一个带索引的字段，要么正好给出复合索引的本字段和全部分组列；可查的有：{fields}"
msgstr ""
"Условия запроса {keys} не соответствуют ни одному индексу Component {comp}: "
"нужно либо указать только одно индексированное поле, либо ровно задать само "
"поле составного индекса и все его группирующие столбцы; доступны для "
"запроса: {fields}"

#: hetu/cli/data.py:166
#, python-brace-format
msgid "查询条件 {keys} 同时匹配了 {matched} 几个索引，请用 --index 指定"
msgstr ""
"Условия запроса {keys} одновременно соответствуют нескольким индексам "
"({matched}), укажите нужный с помощью --index"

#: hetu/cli/data.py:181
#, python-brace-format
msgid "{index} 是按 {columns} 分组的复合索引，要用 FIELD=VALUE 正好给出这些分组列，收到：{keys}"
msgstr ""
"{index} — это составной индекс с группировкой по {columns}; нужно ровно "
"задать эти группирующие столбцы в виде FIELD=VALUE, получено: {keys}"

#: hetu/cli/data.py:186
#, python-brace-format
msgid "{index} 不是复合索引，多给了 {keys}"
msgstr "{index} не является составным индексом, лишним указано: {keys}"

#: hetu/cli/data.py:390
msgid "读 master（刚写完马上读时用）；默认读 servant"
msgstr ""
"Читать из master (используется, когда нужно прочитать сразу после записи); "
"по умолчанию читается из servant"

#: hetu/cli/data.py:392
msgid "只输出这些列，逗号分隔"
msgstr "Выводить только эти столбцы, через запятую"

#: hetu/cli/data.py:414
msgid ""
"按 id 或带索引的字段读一行组件数据（不做 RLS），stdout 输出一行 JSON；不加载 app，schema 取自库里的表 meta"
msgstr ""
"Прочитать одну строку данных Component по id или индексированному полю (без "
"RLS), вывести одну строку JSON в stdout; app не загружается, схема берётся "
"из meta таблиц в базе"

#: hetu/cli/data.py:422
msgid "列出组件、字段与索引（加载 app，不连数据库）"
msgstr ""
"Показать список Component, полей и индексов (загружает app, не подключается "
"к базе данных)"

#: hetu/cli/data.py:427
msgid "FIELD=VALUE 同时匹配了几个复合索引时，指定按哪个索引查（其余 FIELD=VALUE 是它的分组值）"
msgstr ""
"Когда FIELD=VALUE одновременно соответствует нескольким составным индексам, "
"укажите, по какому индексу выполнять запрос (остальные FIELD=VALUE — его "
"группирующие значения)"

#: hetu/cli/data.py:437
msgid "一个带索引的字段，如 owner=1001；复合索引要同时给出全部分组列，如 name=abc zone=3"
msgstr ""
"Одно индексированное поле, например owner=1001; для составного индекса нужно"
" указать все группирующие столбцы, например name=abc zone=3"

#: hetu/cli/data.py:450
msgid "要给组件名和 FIELD=VALUE（hetu get --list 查看组件）"
msgstr ""
"Нужно указать имя Component и FIELD=VALUE (список Component: hetu get "
"--list)"

#: hetu/cli/data.py:469
msgid ""
"按带索引的字段读一个区间的组件数据（不做 RLS），stdout 输出一行 JSON；省略 RIGHT 即精确匹配 LEFT，( / [ 前缀表示开 /"
" 闭区间"
msgstr ""
"Прочитать диапазон данных Component по индексированному полю (без RLS), "
"вывести одну строку JSON в stdout; если RIGHT опущен, выполняется точное "
"совпадение с LEFT; префиксы ( и [ означают открытый и закрытый интервал"

#: hetu/cli/data.py:478
msgid "最多返回多少行，默认 10，-1 为不限"
msgstr ""
"Максимальное число возвращаемых строк, по умолчанию 10, -1 — без ограничения"

#: hetu/cli/data.py:480
msgid "降序"
msgstr "По убыванию"

#: hetu/cli/data.py:486
msgid "复合索引的分组值，每个分组列给一次，如 --group zone=3"
msgstr ""
"Группирующее значение составного индекса, по одному разу для каждого "
"группирующего столбца, например --group zone=3"

#: hetu/cli/init.py:325
msgid "❌ 未找到 uv 命令，请先安装 uv：https://docs.astral.sh/uv/"
msgstr ""
"❌ Не найдена команда uv, пожалуйста, установите uv: "
"https://docs.astral.sh/uv/"

#: hetu/cli/init.py:329
#, python-brace-format
msgid "❌ uv {cmd} 执行失败（退出码 {code}）"
msgstr "❌ Ошибка выполнения uv {cmd} (код выхода {code})"

#: hetu/cli/init.py:355
#, python-brace-format
msgid "ℹ️  {path} 已存在，跳过"
msgstr "ℹ️  {path} уже существует, пропускаем"

#: hetu/cli/init.py:359
#, python-brace-format
msgid "✅ 已创建 {path}"
msgstr "✅ Создан {path}"

#: hetu/cli/init.py:374
msgid "ℹ️  pyproject.toml 已注册 build/dev 命令，跳过"
msgstr ""
"ℹ️  В pyproject.toml уже зарегистрированы команды build/dev, пропускаем"

#: hetu/cli/init.py:377
msgid "⚠️  pyproject.toml 已有 build/dev 命令定义，跳过注册，请手动检查"
msgstr ""
"⚠️  В pyproject.toml уже есть определения команд build/dev, пропускаем "
"регистрацию, проверьте вручную"

#: hetu/cli/init.py:391
msgid "✅ 已在 pyproject.toml 注册 build/dev 命令"
msgstr "✅ Команды build/dev зарегистрированы в pyproject.toml"

#: hetu/cli/init.py:401
#, python-brace-format
msgid "✅ 已将 {entry} 加入 .gitignore"
msgstr "✅ {entry} добавлен в .gitignore"

#: hetu/cli/init.py:411
msgid "初始化一个新的河图项目"
msgstr "Инициализировать новый проект hetu"

#: hetu/cli/init.py:416
msgid "项目目录名，省略则在当前目录初始化"
msgstr ""
"Имя каталога проекта, если не указано, будет инициализирован в текущем "
"каталоге"

#: hetu/cli/init.py:421
msgid "项目使用的 Python 版本"
msgstr "Используемая версия Python для проекта"

#: hetu/cli/init.py:431
msgid "ℹ️  检测到 pyproject.toml，跳过 uv init"
msgstr "ℹ️  Обнаружен pyproject.toml, пропускаем uv init"

#: hetu/cli/init.py:504
msgid "ℹ️  config.yml 已存在，跳过"
msgstr "ℹ️  config.yml уже существует, пропускаем"

#: hetu/cli/init.py:508
msgid "✅ 已创建 config.yml"
msgstr "✅ Создан config.yml"

#: hetu/cli/init.py:521
msgid "ℹ️  hetudb 已在依赖中，跳过 uv add"
msgstr "ℹ️  hetudb уже в зависимостях, пропускаем uv add"

#: hetu/cli/init.py:527
msgid "🎉 项目已就绪！下一步："
msgstr "🎉 Проект готов! Следующие шаги:"

#: hetu/cli/init.py:531
msgid "# 强制迁移并启动开发服务器（含客户端代码生成）"
msgstr ""
"# Принудительная миграция и запуск сервера разработки (включая генерацию "
"клиентского кода)"

#: hetu/cli/init.py:533
msgid "# 仅生成客户端 C# 组件代码"
msgstr "# Только генерация кода Component на C# для клиента"

#: hetu/cli/init.py:534
msgid "# 仅启动服务"
msgstr "# Только запуск сервера"

#: hetu/cli/init.py:536
msgid "提示：默认使用 SQLite 调试数据库，文件会自动创建，无需额外服务。"
msgstr ""
"Совет: по умолчанию используется отладочная база данных SQLite, файл будет "
"создан автоматически, дополнительный сервис не требуется."

#: hetu/cli/init.py:537
msgid "      生产环境请在 config.yml 的 BACKENDS 中改用 Redis。"
msgstr ""
"      Для продакшена укажите Redis в секции BACKENDS файла config.yml."

#: hetu/cli/init.py:540
#, python-brace-format
msgid "      uv run build 需在 .env.test 设置 {env} 指向客户端工程输出路径。"
msgstr ""
"      Для uv run build необходимо задать в .env.test переменную {env}, "
"указывающую на путь вывода клиентского проекта."

#: hetu/cli/init.py:544
#, python-brace-format
msgid "      已写入 .claude/skills/{name}/，供编码 AI 了解 HeTu 用法。"
msgstr ""
"      Записано в .claude/skills/{name}/, чтобы ИИ-помощник по коду знал, как"
" использовать HeTu."

#: hetu/cli/migrate.py:37
msgid ""
"在数据库执行Schema升级脚本,如果没有则创建，如果无变更则跳过。同时还会进行临时表的清空。应该在CI/CD流程中，每次启动服务器前执行一次。"
msgstr ""
"Выполняет скрипт обновления схемы в базе данных. Если скрипта нет — создаёт,"
" если изменений нет — пропускает. Также очищает временные таблицы. Должен "
"выполняться один раз перед каждым запуском сервера в процессе CI/CD."

#: hetu/cli/migrate.py:44 hetu/cli/start.py:95
msgid "后端数据库地址，默认 redis://127.0.0.1:6379/0"
msgstr "Адрес Backend базы данных, по умолчанию redis://127.0.0.1:6379/0"

#: hetu/cli/migrate.py:48
msgid "河图app的py文件，默认 app.py"
msgstr "py-файл приложения hetu, по умолчанию app.py"

#: hetu/cli/migrate.py:54 hetu/cli/start.py:84
msgid "启动app.py中哪个namespace下的System"
msgstr "Какую System в namespace запустить из app.py"

#: hetu/cli/migrate.py:57 hetu/cli/start.py:87
msgid "实例名称，每个实例是一个副本"
msgstr "Имя экземпляра, каждый экземпляр — это реплика"

#: hetu/cli/migrate.py:63
msgid "通过yml配置文件读取后端数据库地址。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Считывает адрес Backend базы данных из yml-файла конфигурации. Если он не "
"указан и не задан параметр командной строки, последовательно ищет переменную"
" окружения HETU_CONFIG, затем config.yml в текущем каталоге"

#: hetu/cli/migrate.py:72
msgid "自动确认数据备份提示"
msgstr "Автоматически подтверждает запрос о резервном копировании данных"

#: hetu/cli/migrate.py:78
msgid "强制执行升级迁移，丢弃无法迁移的数据。请勿在生产环境使用此选项！"
msgstr ""
"Принудительно выполнить миграцию, удалив данные, которые невозможно "
"перенести. Не используйте эту опцию в рабочей среде!"

#: hetu/cli/migrate.py:85
msgid "跳过重建索引。默认每次升级都按行数据重建持久组件的索引、修掉索引残留，数据量大时较慢"
msgstr ""
"Пропустить перестроение индексов. По умолчанию при каждом обновлении индексы"
" постоянных Component перестраиваются по данным строк, а остатки индексов "
"устраняются; при большом объёме данных это медленно"

#: hetu/cli/migrate.py:121
#, python-brace-format
msgid ""
"❌ 检测到还有服务器在运行（持有 Worker ID "
"租约：{ids}），请先停服再升级：迁移、清空易失表、重建索引在服务器运行时执行都会写坏数据。服务器是异常退出的，等租约过期（最多 {ttl} "
"秒）后再试。"
msgstr ""
"❌ Обнаружены работающие серверы (держат аренду Worker ID: {ids}). Сначала "
"остановите сервер, затем обновляйте: выполнение миграции, очистки временных "
"таблиц и перестроения индексов при работающем сервере приведёт к повреждению"
" данных. Если сервер завершился аварийно, повторите попытку после истечения "
"аренды (не более {ttl} секунд)."

#: hetu/cli/migrate.py:129
#, python-brace-format
msgid "   其中 {ids} 是 hetu call / shell 进程，等它们结束即可（异常退出的最多 {ttl} 秒过期）。"
msgstr ""
"   Здесь {ids} — это процессы hetu call / shell; достаточно дождаться их "
"завершения (при аварийном завершении аренда истекает не более чем через "
"{ttl} секунд)."

#: hetu/cli/migrate.py:147
msgid "⚠️  升级数据库表结构可能会导致数据丢失，请确保已备份数据。确认继续请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Обновление структуры таблиц базы данных может привести к потере данных. "
"Убедитесь, что данные сохранены. Для подтверждения введите y, для отмены — "
"любую другую клавишу и нажмите Enter:"

#: hetu/cli/migrate.py:152 hetu/cli/migrate.py:179
msgid "❌  升级迁移已取消。"
msgstr "❌  Миграция обновления отменена."

#: hetu/cli/migrate.py:169
msgid "❗ Component有数据删除或类型变更，请修改自动生成的迁移脚本，手动处理这些属性。或使用--drop-data参数直接丢弃这些属性。"
msgstr ""
"❗ В Component произошло удаление данных или изменение типа. Измените "
"автоматически сгенерированный скрипт миграции, чтобы обработать эти свойства"
" вручную. Или используйте параметр --drop-data для их прямого удаления."

#: hetu/cli/migrate.py:176
msgid "⚠️  确认强制迁移请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Для подтверждения принудительной миграции введите y, для отмены — любую "
"другую клавишу и нажмите Enter:"

#: hetu/cli/migrate.py:183
#, python-brace-format
msgid "⚠️  正在强制迁移 {instance_name} 服所有表结构，可能会丢失数据..."
msgstr ""
"⚠️  Выполняется принудительная миграция структуры всех таблиц для сервера "
"{instance_name}, возможна потеря данных..."

#: hetu/cli/migrate.py:191
#, python-brace-format
msgid "🧹 正在清除 {instance_name} 服易失数据..."
msgstr "🧹 Очищаю временные данные для сервера {instance_name}..."

#: hetu/cli/migrate.py:199
#, python-brace-format
msgid "🔧 正在重建 {instance_name} 服的索引..."
msgstr "🔧 Перестраиваю индексы сервера {instance_name}..."

#: hetu/cli/migrate.py:206
#, python-brace-format
msgid "✅  {instance_name} 服升级迁移完成！"
msgstr "✅  Миграция обновления для сервера {instance_name} завершена!"

#: hetu/cli/migrate.py:210
msgid "🎉  恭喜！所有数据库表结构均已升级完成！"
msgstr "🎉  Поздравляем! Структура всех таблиц базы данных успешно обновлена!"

#: hetu/cli/shell.py:70
msgid "call 留给以后的 Endpoint 路径（与 Sandbox.call 同义），跑 System 请用 call_system"
msgstr ""
"call оставлен для будущих путей Endpoint (синоним Sandbox.call); для запуска"
" System используйте call_system"

#: hetu/cli/shell.py:189
msgid "KeyboardInterrupt（Ctrl+D 退出 shell）"
msgstr "KeyboardInterrupt (Ctrl+D — выход из shell)"

#: hetu/cli/shell.py:229
msgid ""
"HeTu shell：预置 app / client / call_system / get / must_get / insert / upsert "
"/ show，range 用 app.range；支持顶层 await，Ctrl+D 退出"
msgstr ""
"HeTu shell: предустановлены app / client / call_system / get / must_get / "
"insert / upsert / show, range — через app.range; поддерживается await "
"верхнего уровня, Ctrl+D — выход"

#: hetu/cli/shell.py:270
msgid "没有要执行的代码：用 -c CODE、脚本文件，或从 stdin 传入；在终端里直接运行 hetu shell 进交互模式"
msgstr ""
"Нет кода для выполнения: используйте -c CODE, файл скрипта или передайте код"
" через stdin; чтобы войти в интерактивный режим, запустите hetu shell прямо "
"в терминале"

#: hetu/cli/shell.py:318
#, python-brace-format
msgid "⚠️ shell 退出时取消了 {n} 个还在跑的后台任务"
msgstr "⚠️ При выходе из shell отменено фоновых задач: {n}"

#: hetu/cli/shell.py:348
msgid ""
"进程内连上后端的 Python shell：预置 call_system / get / must_get / insert / upsert / "
"show 与 app.range，支持顶层 await"
msgstr ""
"Python shell с подключением к Backend в том же процессе: предустановлены "
"call_system / get / must_get / insert / upsert / show и app.range, "
"поддерживается await верхнего уровня"

#: hetu/cli/shell.py:353
msgid "执行这段代码"
msgstr "Выполнить этот код"

#: hetu/cli/shell.py:357
msgid "执行但不提交任何写入"
msgstr "Выполнить без фиксации каких-либо записей"

#: hetu/cli/shell.py:370
msgid "要执行的脚本，- 为 stdin；都不给且 stdin 是终端时进交互模式"
msgstr ""
"Скрипт для выполнения, - означает stdin; если ничего не указано и stdin — "
"терминал, включается интерактивный режим"

#: hetu/cli/start.py:73
msgid "启动河图服务"
msgstr "Запуск службы Hetu"

#: hetu/cli/start.py:75
msgid "通过命令行启动参数"
msgstr "Параметры запуска через командную строку"

#: hetu/cli/start.py:78
msgid "河图app的py文件，默认 /app/app.py"
msgstr "py-файл приложения Hetu, по умолчанию /app/app.py"

#: hetu/cli/start.py:90
msgid "监听的Websocket端口"
msgstr "Порт Websocket для прослушивания"

#: hetu/cli/start.py:100
msgid "工作进程数，可设为 CPU * 1.2，-1为按CPU核心数自动"
msgstr ""
"Число рабочих процессов, можно задать как CPU * 1.2, -1 — автоматически по "
"числу ядер CPU"

#: hetu/cli/start.py:109
#, python-format
msgid ""
"开启debug模式，这会启动代码热更新，并显示更多的log信息。如果设置为2，则对框架内核也启用debug模式，会开启Python协程的Debug模式，速度慢90%%。"
msgstr ""
"Включить режим отладки (debug). Это запустит горячее обновление кода и "
"покажет больше информации в логах. Если установить значение 2, то режим "
"отладки будет включён и для ядра фреймворка, что активирует режим отладки "
"Python-корутин и замедлит работу на 90%%."

#: hetu/cli/start.py:119
msgid "证书目录，如果不设置则使用不安全的连接。不建议这里设置，请外加一层反向https代理。填入auto会生成自签https证书。"
msgstr ""
"Каталог сертификатов. Если не установлен, используется небезопасное "
"соединение. Не рекомендуется устанавливать здесь, лучше добавить внешний "
"обратный HTTPS-прокси. Ввод 'auto' сгенерирует самоподписанный HTTPS-"
"сертификат."

#: hetu/cli/start.py:127
msgid "默认crypto层的auth_key，用于握手签名校验。留空则不启用。"
msgstr ""
"Ключ аутентификации (auth_key) по умолчанию для криптографического слоя, "
"используется для проверки подписи при рукопожатии. Оставьте пустым для "
"отключения."

#: hetu/cli/start.py:135
msgid ""
"配置文件模板见CONFIG_TEMPLATE.yml。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Шаблон файла конфигурации см. в CONFIG_TEMPLATE.yml. Если он не указан и не "
"использованы параметры командной строки, последовательно ищутся переменная "
"окружения HETU_CONFIG и config.yml в текущем каталоге"

#: hetu/cli/start.py:170
msgid "--app_file是必须参数，或者用--config"
msgstr ""
"--app_file является обязательным параметром, либо используйте --config"

#: hetu/cli/start.py:173
msgid "--namespace是必须参数，或者用--config"
msgstr ""
"--namespace является обязательным параметром, либо используйте --config"

#: hetu/cli/start.py:176
msgid "--instance是必须参数，或者用--config"
msgstr ""
"--instance является обязательным параметром, либо используйте --config"

#: hetu/cli/start.py:235
#, python-brace-format
msgid "ℹ️ {name}, {mode}, {workers} 个工作进程, 管理进程 pid: {pid}"
msgstr ""
"ℹ️ {name}, {mode}, {workers} рабочих процессов, pid управляющего процесса: "
"{pid}"

#: hetu/cli/start.py:243
#, python-brace-format
msgid "ℹ️ Python {version} 平台 {platform}"
msgstr "ℹ️ Python {version}, платформа {platform}"

#: hetu/cli/start.py:248
#, python-brace-format
msgid "📡 监听地址： http{s}://{host}:{port}"
msgstr "📡 Адрес прослушивания: http{s}://{host}:{port}"

#: hetu/cli/start.py:254
#, python-brace-format
msgid "ℹ️ 消息流协议：json -> {layers} -> Network"
msgstr "ℹ️ Протокол потока сообщений: json -> {layers} -> Network"

#: hetu/cli/start.py:270
#, python-brace-format
msgid "🔑 auth_key: {key}"
msgstr "🔑 auth_key: {key}"

#: hetu/cli/start.py:272
msgid "🔑 auth_key 未设置 ⚠️ 任意 key 都能连接"
msgstr "🔑 auth_key не задан ⚠️ любой ключ может подключиться"

#: hetu/cli/start.py:276
msgid "⚠️⚠️⚠️ 深度Debug模式开启  ⚠️⚠️⚠️   此模式下Python协程慢90%"
msgstr ""
"⚠️⚠️⚠️ Включён режим глубокой отладки ⚠️⚠️⚠️   В этом режиме Python-корутины"
" работают на 90% медленнее"

#: hetu/cli/start.py:303
#, python-brace-format
msgid "❌ 服务器启动失败，已中止，未对外提供服务：{err}"
msgstr ""
"❌ Не удалось запустить сервер, работа прервана, внешние подключения не "
"обслуживаются: {err}"

#: hetu/cli/start.py:311
msgid "端口可能被系统 excludedportrange 禁用了，请用管理员执行：net stop winnatnet start winnat"
msgstr ""
"Возможно, порт заблокирован системным excludedportrange. Выполните от "
"администратора: net stop winnatnet start winnat"

#: hetu/common/slowlog.py:72
#, python-brace-format
msgid ""
"⚠️ [📞慢日志] 系统 {name} 执行时间 {elapsed}秒，事务冲突次数 {retry}，平均时间 {avg_time}秒\n"
"{table}"
msgstr ""
"⚠️ [📞 Медленный журнал] Система {name} время выполнения {elapsed} сек., количество конфликтов транзакций {retry}, среднее время {avg_time} сек.\n"
"{table}"

#: hetu/common/slowlog.py:99
msgid "系统"
msgstr "Система"

#: hetu/common/slowlog.py:99
msgid "平均时间"
msgstr "Среднее время"

#: hetu/common/slowlog.py:99
msgid "平均冲突次数"
msgstr "Среднее количество конфликтов"

#: hetu/common/snowflake_id.py:119
#, python-brace-format
msgid "Worker ID不能大于{max}或小于0"
msgstr "Worker ID не может быть больше {max} или меньше 0"

#: hetu/common/snowflake_id.py:137
#, python-brace-format
msgid "[❄️ID] 雪花ID生成器初始化完成，Worker ID: {worker_id}, last_timestamp: {ts}"
msgstr ""
"[❄️ID] Генератор снежинчатых ID инициализирован, Worker ID: {worker_id}, "
"last_timestamp: {ts}"

#: hetu/common/snowflake_id.py:170
#, python-brace-format
msgid ""
"[❄️ID] Worker ID {worker_id} 的租约已超出安全期 {overdue:.1f} "
"秒，拒绝发号以防产生重复ID。通常意味着本进程长时间卡住或后端连不上，Worker 会在下一次续约时重启"
msgstr ""
"[❄️ID] Срок аренды Worker ID {worker_id} превысил безопасный период на "
"{overdue:.1f} с, отказ в выдаче ID во избежание дубликатов. Обычно это "
"означает, что процесс надолго завис или нет связи с Backend; Worker будет "
"перезапущен при следующем продлении аренды."

#: hetu/common/snowflake_id.py:181
msgid "SnowflakeID 未初始化，请先调用 init() 方法。"
msgstr "SnowflakeID не инициализирован, сначала вызовите метод init()."

#: hetu/common/snowflake_id.py:191
#, python-brace-format
msgid "[❄️ID] 时钟回拨了 {ms} 毫秒。"
msgstr "[❄️ID] Часы отстали на {ms} миллисекунд."

#: hetu/common/snowflake_id.py:226 hetu/common/snowflake_id.py:242
msgid "[❄️ID] 每毫秒只能生成有限的ID，需要休眠 1 ms"
msgstr ""
"[❄️ID] В каждой миллисекунде можно сгенерировать ограниченное количество ID,"
" требуется ожидание 1 мс"

#: hetu/common/yamlloader.py:66
#, python-brace-format, python-format
msgid "环境变量 ${%s} 未设置且无默认值，如需空值请用 ${%s:-}"
msgstr ""
"Переменная окружения ${%s} не установлена и не имеет значения по умолчанию; "
"если нужно пустое значение, используйте ${%s:-}"

#: hetu/data/component.py:417
#, python-brace-format
msgid "{cname}.{pname}不是字符串属性（dtype={d}）"
msgstr "{cname}.{pname} не является строковым атрибутом (dtype={d})"

#: hetu/data/component.py:501
msgid "Component重复定义"
msgstr "Повторное определение компонента"

#: hetu/data/component.py:634
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是Python关键字。"
msgstr ""
"Ошибка определения атрибута {cname}.{fname}: имя атрибута не может быть "
"ключевым словом Python."

#: hetu/data/component.py:640
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是C#关键字。"
msgstr ""
"Ошибка определения атрибута {cname}.{fname}: имя атрибута не может быть "
"ключевым словом C#."

#: hetu/data/component.py:648
#, python-brace-format
msgid ""
"{cname}.{fname}属性定义出错，属性名不能和numpy行数据的属性同名，否则row.{fname}读到的是numpy的属性而不是字段值，请换个名字。"
msgstr ""
"Ошибка определения атрибута {cname}.{fname}: имя атрибута не может совпадать"
" с именем атрибута строки данных numpy, иначе row.{fname} прочитает атрибут "
"numpy, а не значение поля. Пожалуйста, выберите другое имя."

#: hetu/data/component.py:654
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不能为0长度。str类型请用'<U8'方式定义"
msgstr ""
"dtype атрибута {cname}.{fname} не может быть нулевой длины. Для строкового "
"типа используйте определение вида '<U8'."

#: hetu/data/component.py:657
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不支持void类型"
msgstr "dtype атрибута {cname}.{fname} не поддерживает тип void."

#: hetu/data/component.py:668
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为unique时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] При установке атрибута {cname}.{fname} как unique, index не "
"может быть установлен в False."

#: hetu/data/component.py:678
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了groupby（复合索引），point_sub用不上已忽略：按组订阅本来就只被本组的写入叫醒。"
msgstr ""
"⚠️ [🛠️Define] Для атрибута {cname}.{fname} задан groupby (составной индекс);"
" в point_sub он не используется и проигнорирован: подписка по группе и так "
"пробуждается только записями своей группы."

#: hetu/data/component.py:690
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了commit_seq，point_sub用不上已忽略：号要到提交时才有，发不出值频道。"
msgstr ""
"⚠️ [🛠️Define] Для атрибута {cname}.{fname} задан commit_seq; в point_sub он "
"не используется и проигнорирован: номер появляется только при коммите, канал"
" значений по нему не отправить."

#: hetu/data/component.py:698
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了commit_seq时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Если для атрибута {cname}.{fname} задан commit_seq, index не "
"может быть установлен в False."

#: hetu/data/component.py:707
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为point_sub时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Если атрибут {cname}.{fname} установлен как point_sub, index "
"не может быть установлен в False."

#: hetu/data/component.py:716
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了groupby时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Если для атрибута {cname}.{fname} задан groupby, index не "
"может быть установлен в False."

#: hetu/data/component.py:725
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，hidden属性不能同时设置point_sub：客户端不能按hidden属性订阅。"
msgstr ""
"Ошибка определения атрибута {cname}.{fname}: для hidden-атрибута нельзя "
"одновременно задавать point_sub — клиент не может подписываться по hidden-"
"атрибуту."

#: hetu/data/component.py:731
#, python-brace-format
msgid ""
"{cname}.{fname}默认值不能为None。所有属性都要有默认值，因为数据接口统一用c like "
"struct实现，强类型struct不接受NULL/None值。"
msgstr ""
"Значение по умолчанию для {cname}.{fname} не может быть None. Все атрибуты "
"должны иметь значение по умолчанию, поскольку интерфейс данных реализован "
"как структура в стиле C, а строго типизированные структуры не принимают "
"значения NULL/None."

#: hetu/data/component.py:742
#, python-brace-format
msgid ""
"{cname}.{fname}的default值：{default_type}({default_value})和属性dtype({dtype})不匹配"
msgstr ""
"Значение по умолчанию для {cname}.{fname}: {default_type}({default_value}) "
"не соответствует dtype атрибута ({dtype})."

#: hetu/data/component.py:756
#, python-brace-format
msgid "{cname}权限为OWNER时，不能设置rls_compare参数"
msgstr ""
"Для компонента {cname} с правами OWNER нельзя устанавливать параметр "
"rls_compare."

#: hetu/data/component.py:759
#, python-brace-format
msgid "{cname}权限为OWNER时，必须有owner属性"
msgstr ""
"Для компонента {cname} с правами OWNER должен быть определен атрибут owner."

#: hetu/data/component.py:766
#, python-brace-format
msgid "{cname}的owner属性必需是numeric数字(int, np.int64, ...)类型"
msgstr ""
"Атрибут owner компонента {cname} должен быть числового типа (int, np.int64, "
"...)."

#: hetu/data/component.py:772
#, python-brace-format
msgid "{cname}权限为RLS时，必须通过rls_compare参数定义行级权限逻辑"
msgstr ""
"Для компонента {cname} с правами RLS необходимо определить логику контроля "
"на уровне строк через параметр rls_compare."

#: hetu/data/component.py:775
#, python-brace-format
msgid "{cname}.rls_compare参数必须全部是字符串类型"
msgstr ""
"Все параметры rls_compare компонента {cname} должны быть строкового типа."

#: hetu/data/component.py:778
#, python-brace-format
msgid "{cname}.rls_compare参数必须只有3个元素)"
msgstr ""
"Параметр rls_compare компонента {cname} должен содержать ровно 3 элемента."

#: hetu/data/component.py:782
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但operator模块没有{method}方法"
msgstr ""
"Для компонента {cname} с правами RLS: {rls_compare}, но в модуле operator "
"отсутствует метод {method}."

#: hetu/data/component.py:786
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但表没有定义{prop}属性"
msgstr ""
"Для компонента {cname} с правами RLS: {rls_compare}, но в таблице не "
"определен атрибут {prop}."

#: hetu/data/component.py:803
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列必须是本组件的字段名，不能是id、_version：{col!r}"
msgstr ""
"Ошибка определения groupby для {cname}.{fname}: столбец группировки должен "
"быть именем поля данного компонента и не может быть id или _version: {col!r}"

#: hetu/data/component.py:809
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，不能按自己分组"
msgstr ""
"Ошибка определения groupby для {cname}.{fname}: нельзя группировать по "
"самому себе"

#: hetu/data/component.py:816
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，组件没有字段`{col}`"
msgstr ""
"Ошибка определения groupby для {cname}.{fname}: в компоненте нет поля "
"`{col}`"

#: hetu/data/component.py:822
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列`{col}`重复了"
msgstr ""
"Ошибка определения groupby для {cname}.{fname}: столбец группировки `{col}` "
"повторяется"

#: hetu/data/component.py:830
#, python-brace-format
msgid ""
"{cname}.{fname}的groupby定义出错，分组列`{col}`只能是整数、str、bytes类型，不能是{dtype}：浮点按等值分组没有意义，NaN、-0.0"
" 的相等也说不清"
msgstr ""
"Ошибка определения groupby для {cname}.{fname}: столбец группировки `{col}` "
"может быть только целочисленного типа, str или bytes, но не {dtype}: "
"группировка чисел с плавающей точкой по равенству не имеет смысла, а "
"равенство NaN и -0.0 неоднозначно"

#: hetu/data/component.py:842
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，{dtype}类型不能建索引"
msgstr ""
"Ошибка определения атрибута {cname}.{fname}: для типа {dtype} нельзя создать"
" индекс"

#: hetu/data/component.py:855
#, python-brace-format
msgid "{cname}定义出错，最多只能有一个commit_seq字段：{fields}"
msgstr ""
"Ошибка определения {cname}: допускается не более одного поля commit_seq: "
"{fields}"

#: hetu/data/component.py:866
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的类型只能是np.int64，不能是{dtype}"
msgstr ""
"Ошибка определения атрибута {cname}.{fname}: тип commit_seq может быть "
"только np.int64, но не {dtype}"

#: hetu/data/component.py:875
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的default必须是0：0表示还没发号，号从1开始"
msgstr ""
"Ошибка определения атрибута {cname}.{fname}: значение по умолчанию для "
"commit_seq должно быть 0 — 0 означает, что номер ещё не выдан, нумерация "
"начинается с 1"

#: hetu/data/component.py:884
