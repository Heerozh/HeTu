#: hetu/headless.py:83
#, python-brace-format
msgid ""
"实例 {instance} 里不存在组件表 {comp_name}：请先启动 HeTu 服务器建表（或检查 instance / 组件名 / "
"后端配置是否指向同一个数据库）"
msgstr ""
"В экземпляре {instance} отсутствует таблица Component {comp_name}: сначала "
"запустите сервер HeTu для создания таблиц (или проверьте, что экземпляр / "
"имя Component / конфигурация Backend указывают на одну и ту же базу данных)"

#: hetu/headless.py:102
#, python-brace-format
msgid "组件 {comp_name} 的本地定义与服务器表结构不一致（服务器 -> 本地）：{diff}"
msgstr ""
"Локальное определение Component {comp_name} не соответствует структуре "
"таблицы на сервере (сервер -> локально): {diff}"

#: hetu/headless.py:119
#, python-brace-format
msgid ""
"组件 {comp_name} 的 cluster_id 已由 {old_id} 变为 {new_id}（服务器已迁簇），请重新 connect"
msgstr ""
"cluster_id у Component {comp_name} изменился с {old_id} на {new_id} (сервер "
"перенёс кластер), пожалуйста, выполните connect заново"

#: hetu/headless.py:194
#, python-brace-format
msgid ""
"组件 {name} 未在本事务声明（或不是 connect 时认下的那个类），请在 client.session(...) "
"里加上；已声明：{declared}"
msgstr ""
"Component {name} не объявлен в этой транзакции (или это не тот класс, "
"который был распознан при connect), добавьте его в client.session(...); "
"объявлено: {declared}"

#: hetu/headless.py:239 hetu/headless.py:260
#, python-brace-format
msgid "组件 {name} 重复声明"
msgstr "Component {name} объявлен повторно"

#: hetu/headless.py:253
msgid "components 不能为空：至少声明一个组件"
msgstr ""
"Параметр components не может быть пустым: объявите хотя бы один Component"

#: hetu/headless.py:274
#, python-brace-format
msgid "⚠️ [🧩Headless] 组件 {name} 的默认值与服务器不同（只影响本进程 new_row 的填充值）：{diff}"
msgstr ""
"⚠️ [🧩Headless] Значение по умолчанию Component {name} отличается от "
"серверного (влияет только на заполнение значений new_row в текущем "
"процессе): {diff}"

#: hetu/headless.py:281
#, python-brace-format
msgid "[🧩Headless] 实例 {instance} 组件表 {name} → cluster {cid}"
msgstr ""
"[🧩Headless] Экземпляр {instance}: таблица Component {name} → кластер {cid}"

#: hetu/headless.py:314
#, python-brace-format
msgid "组件 {name} 未在 connect(components=...) 里声明；已声明：{declared}"
msgstr ""
"Component {name} не объявлен в connect(components=...); объявлено: "
"{declared}"

#: hetu/headless.py:320
#, python-brace-format
msgid ""
"组件 {name} 是按名字声明的，其类来自服务器 meta，请用 client.table('{name}').comp_cls 而不是本地类"
msgstr ""
"Component {name} объявлен по имени, его класс получен из meta сервера; "
"используйте client.table('{name}').comp_cls вместо локального класса"

#: hetu/headless.py:338
msgid "session() 至少要声明一个组件"
msgstr "session() должен объявлять хотя бы один Component"

#: hetu/headless.py:345
#, python-brace-format
msgid "同一事务的组件必须同簇（簇由服务器 System 的引用关系决定，跨簇请拆成两个事务）：{detail}"
msgstr ""
"Components одной транзакции должны находиться в одном кластере (кластер "
"определяется ссылочными отношениями System на сервере; если кластеры "
"различаются, разделите транзакцию на две): {detail}"

#: hetu/manager.py:56
#, python-brace-format
msgid "Backend {backend}未找到"
msgstr "Бэкенд {backend} не найден"

#: hetu/manager.py:100
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表结构需要迁移Schema。"
msgstr "⚠️  Для компонента {comp_name} требуется миграция схемы таблицы."

#: hetu/manager.py:107
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表需要迁移到新集群。"
msgstr ""
"⚠️  Таблицу компонента {comp_name} необходимо перенести в новый кластер."

#: hetu/webext.py:91
#, python-brace-format
msgid "define_route的uri必须以'/'开头，你的：{uri}"
msgstr "uri в define_route должен начинаться с '/', ваш: {uri}"

#: hetu/webext.py:96
#, python-brace-format
msgid "define_route的uri不能占用HeTu保留的'{prefix}'路径（客户端SDK的WebSocket入口），你的：{uri}"
msgstr ""
"uri в define_route не может занимать зарезервированный HeTu путь '{prefix}' "
"(точка входа WebSocket клиентского SDK), ваш: {uri}"

#: hetu/cli/__init__.py:27
msgid "河图数据库"
msgstr "База данных Hetu"

#: hetu/cli/__init__.py:31
msgid "执行操作"
msgstr "Выполнить операцию"

#: hetu/cli/base.py:22
msgid "Boolean value expected."
msgstr "Ожидается логическое значение."

#: hetu/cli/build.py:22
msgid "生成客户端SDK C# 类型代码"
msgstr "Сгенерировать код типов C# для клиентского SDK"

#: hetu/cli/build.py:26 hetu/cli/migrate.py:46 hetu/cli/start.py:96
msgid "河图app的py文件"
msgstr "Python-файл приложения Hetu"

#: hetu/cli/build.py:33
msgid "编译app.py中哪个namespace下的数据类型"
msgstr "Какие типы данных в namespace компилировать из app.py"

#: hetu/cli/build.py:37
msgid "输出文件路径"
msgstr "Путь к выходному файлу"

#: hetu/cli/build.py:46 hetu/cli/migrate.py:96
#, python-brace-format
msgid "无法加载app文件 {app_file}"
msgstr "Не удалось загрузить файл приложения {app_file}"

#: hetu/cli/build.py:59
#, python-brace-format
msgid "✅ 已生成C#代码到 {output}"
msgstr "✅ Код C# сгенерирован в {output}"

#: hetu/cli/init.py:321
msgid "❌ 未找到 uv 命令，请先安装 uv：https://docs.astral.sh/uv/"
msgstr ""
"❌ Не найдена команда uv, пожалуйста, установите uv: "
"https://docs.astral.sh/uv/"

#: hetu/cli/init.py:325
#, python-brace-format
msgid "❌ uv {cmd} 执行失败（退出码 {code}）"
msgstr "❌ Ошибка выполнения uv {cmd} (код выхода {code})"

#: hetu/cli/init.py:351
#, python-brace-format
msgid "ℹ️  {path} 已存在，跳过"
msgstr "ℹ️  {path} уже существует, пропускаем"

#: hetu/cli/init.py:355
#, python-brace-format
msgid "✅ 已创建 {path}"
msgstr "✅ Создан {path}"

#: hetu/cli/init.py:370
msgid "ℹ️  pyproject.toml 已注册 build/dev 命令，跳过"
msgstr ""
"ℹ️  В pyproject.toml уже зарегистрированы команды build/dev, пропускаем"

#: hetu/cli/init.py:373
msgid "⚠️  pyproject.toml 已有 build/dev 命令定义，跳过注册，请手动检查"
msgstr ""
"⚠️  В pyproject.toml уже есть определения команд build/dev, пропускаем "
"регистрацию, проверьте вручную"

#: hetu/cli/init.py:387
msgid "✅ 已在 pyproject.toml 注册 build/dev 命令"
msgstr "✅ Команды build/dev зарегистрированы в pyproject.toml"

#: hetu/cli/init.py:397
#, python-brace-format
msgid "✅ 已将 {entry} 加入 .gitignore"
msgstr "✅ {entry} добавлен в .gitignore"

#: hetu/cli/init.py:407
msgid "初始化一个新的河图项目"
msgstr "Инициализировать новый проект hetu"

#: hetu/cli/init.py:412
msgid "项目目录名，省略则在当前目录初始化"
msgstr ""
"Имя каталога проекта, если не указано, будет инициализирован в текущем "
"каталоге"

#: hetu/cli/init.py:417
msgid "项目使用的 Python 版本"
msgstr "Используемая версия Python для проекта"

#: hetu/cli/init.py:427
msgid "ℹ️  检测到 pyproject.toml，跳过 uv init"
msgstr "ℹ️  Обнаружен pyproject.toml, пропускаем uv init"

#: hetu/cli/init.py:500
msgid "ℹ️  config.yml 已存在，跳过"
msgstr "ℹ️  config.yml уже существует, пропускаем"

#: hetu/cli/init.py:504
msgid "✅ 已创建 config.yml"
msgstr "✅ Создан config.yml"

#: hetu/cli/init.py:517
msgid "ℹ️  hetudb 已在依赖中，跳过 uv add"
msgstr "ℹ️  hetudb уже в зависимостях, пропускаем uv add"

#: hetu/cli/init.py:523
msgid "🎉 项目已就绪！下一步："
msgstr "🎉 Проект готов! Следующие шаги:"

#: hetu/cli/init.py:527
msgid "# 强制迁移并启动开发服务器（含客户端代码生成）"
msgstr ""
"# Принудительная миграция и запуск сервера разработки (включая генерацию "
"клиентского кода)"

#: hetu/cli/init.py:529
msgid "# 仅生成客户端 C# 组件代码"
msgstr "# Только генерация кода Component на C# для клиента"

#: hetu/cli/init.py:530
msgid "# 仅启动服务"
msgstr "# Только запуск сервера"

#: hetu/cli/init.py:532
msgid "提示：默认使用 SQLite 调试数据库，文件会自动创建，无需额外服务。"
msgstr ""
"Совет: по умолчанию используется отладочная база данных SQLite, файл будет "
"создан автоматически, дополнительный сервис не требуется."

#: hetu/cli/init.py:533
msgid "      生产环境请在 config.yml 的 BACKENDS 中改用 Redis。"
msgstr ""
"      Для продакшена укажите Redis в секции BACKENDS файла config.yml."

#: hetu/cli/init.py:536
#, python-brace-format
msgid "      uv run build 需在 .env.test 设置 {env} 指向客户端工程输出路径。"
msgstr ""
"      Для uv run build необходимо задать в .env.test переменную {env}, "
"указывающую на путь вывода клиентского проекта."

#: hetu/cli/init.py:540
#, python-brace-format
msgid "      已写入 .claude/skills/{name}/，供编码 AI 了解 HeTu 用法。"
msgstr ""
"      Записано в .claude/skills/{name}/, чтобы ИИ-помощник по коду знал, как"
" использовать HeTu."

#: hetu/cli/migrate.py:34
msgid ""
"在数据库执行Schema升级脚本,如果没有则创建，如果无变更则跳过。同时还会进行临时表的清空。应该在CI/CD流程中，每次启动服务器前执行一次。"
msgstr ""
"Выполняет скрипт обновления схемы в базе данных. Если скрипта нет — создаёт,"
" если изменений нет — пропускает. Также очищает временные таблицы. Должен "
"выполняться один раз перед каждым запуском сервера в процессе CI/CD."

#: hetu/cli/migrate.py:41 hetu/cli/start.py:114
msgid "后端数据库地址"
msgstr "Адрес серверной базы данных"

#: hetu/cli/migrate.py:53 hetu/cli/start.py:103
msgid "启动app.py中哪个namespace下的System"
msgstr "Какую System в namespace запустить из app.py"

#: hetu/cli/migrate.py:56 hetu/cli/start.py:106
msgid "实例名称，每个实例是一个副本"
msgstr "Имя экземпляра, каждый экземпляр — это реплика"

#: hetu/cli/migrate.py:61
msgid "通过yml配置文件读取后端数据库地址"
msgstr "Читает адрес серверной базы данных из конфигурационного файла yml"

#: hetu/cli/migrate.py:68
msgid "自动确认数据备份提示"
msgstr "Автоматически подтверждает запрос о резервном копировании данных"

#: hetu/cli/migrate.py:74
msgid "强制执行升级迁移，丢弃无法迁移的数据。请勿在生产环境使用此选项！"
msgstr ""
"Принудительно выполнить миграцию, удалив данные, которые невозможно "
"перенести. Не используйте эту опцию в рабочей среде!"

#: hetu/cli/migrate.py:110
msgid "⚠️  升级数据库表结构可能会导致数据丢失，请确保已备份数据。确认继续请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Обновление структуры таблиц базы данных может привести к потере данных. "
"Убедитесь, что данные сохранены. Для подтверждения введите y, для отмены — "
"любую другую клавишу и нажмите Enter:"

#: hetu/cli/migrate.py:115 hetu/cli/migrate.py:142
msgid "❌  升级迁移已取消。"
msgstr "❌  Миграция обновления отменена."

#: hetu/cli/migrate.py:132
msgid "❗ Component有数据删除或类型变更，请修改自动生成的迁移脚本，手动处理这些属性。或使用--drop-data参数直接丢弃这些属性。"
msgstr ""
"❗ В Component произошло удаление данных или изменение типа. Измените "
"автоматически сгенерированный скрипт миграции, чтобы обработать эти свойства"
" вручную. Или используйте параметр --drop-data для их прямого удаления."

#: hetu/cli/migrate.py:139
msgid "⚠️  确认强制迁移请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Для подтверждения принудительной миграции введите y, для отмены — любую "
"другую клавишу и нажмите Enter:"

#: hetu/cli/migrate.py:146
#, python-brace-format
msgid "⚠️  正在强制迁移 {instance_name} 服所有表结构，可能会丢失数据..."
msgstr ""
"⚠️  Выполняется принудительная миграция структуры всех таблиц для сервера "
"{instance_name}, возможна потеря данных..."

#: hetu/cli/migrate.py:154
#, python-brace-format
msgid "🧹 正在清除 {instance_name} 服易失数据..."
msgstr "🧹 Очищаю временные данные для сервера {instance_name}..."

#: hetu/cli/migrate.py:161
#, python-brace-format
msgid "✅  {instance_name} 服升级迁移完成！"
msgstr "✅  Миграция обновления для сервера {instance_name} завершена!"

#: hetu/cli/migrate.py:165
msgid "🎉  恭喜！所有数据库表结构均已升级完成！"
msgstr "🎉  Поздравляем! Структура всех таблиц базы данных успешно обновлена!"

#: hetu/cli/migrate.py:190
msgid "namespace参数不能为空，建议用--config参数"
msgstr ""
"Параметр namespace не может быть пустым, рекомендуется использовать параметр"
" --config"

#: hetu/cli/migrate.py:191
msgid "instance参数不能为空，建议用--config参数"
msgstr ""
"Параметр instance не может быть пустым, рекомендуется использовать параметр "
"--config"

#: hetu/cli/migrate.py:192
msgid "app_file参数不能为空，建议用--config参数"
msgstr ""
"Параметр app_file не может быть пустым, рекомендуется использовать параметр "
"--config"

#: hetu/cli/start.py:54
#, python-brace-format
msgid ""
"不支持的数据库URL scheme: '{scheme}'。目前支持 "
"redis/rediss/valkey/valkeys/postgres/postgresql/sqlite/mysql/mariadb"
msgstr ""
"Неподдерживаемая схема URL базы данных: '{scheme}'. В настоящее время "
"поддерживаются "
"redis/rediss/valkey/valkeys/postgres/postgresql/sqlite/mysql/mariadb"

#: hetu/cli/start.py:91
msgid "启动河图服务"
msgstr "Запуск службы Hetu"

#: hetu/cli/start.py:93
msgid "通过命令行启动参数"
msgstr "Параметры запуска через командную строку"

#: hetu/cli/start.py:109
msgid "监听的Websocket端口"
msgstr "Порт Websocket для прослушивания"

#: hetu/cli/start.py:120
msgid "工作进程数，可设为 CPU * 1.2，-1为按CPU核心数自动"
msgstr ""
"Число рабочих процессов, можно задать как CPU * 1.2, -1 — автоматически по "
"числу ядер CPU"

#: hetu/cli/start.py:129
msgid ""
"开启debug模式，这会启动代码热更新，并显示更多的log信息。如果设置为2，则对框架内核也启用debug模式，会开启Python协程的Debug模式，速度慢90％。"
msgstr ""
"Включить режим отладки (debug). Это запустит горячее обновление кода и "
"покажет больше информации в логах. Если установить значение 2, то режим "
"отладки будет включён и для ядра фреймворка, что активирует режим отладки "
"Python-корутин и замедлит работу на 90%%."

#: hetu/cli/start.py:139
msgid "证书目录，如果不设置则使用不安全的连接。不建议这里设置，请外加一层反向https代理。填入auto会生成自签https证书。"
msgstr ""
"Каталог сертификатов. Если не установлен, используется небезопасное "
"соединение. Не рекомендуется устанавливать здесь, лучше добавить внешний "
"обратный HTTPS-прокси. Ввод 'auto' сгенерирует самоподписанный HTTPS-"
"сертификат."

#: hetu/cli/start.py:147
msgid "默认crypto层的auth_key，用于握手签名校验。留空则不启用。"
msgstr ""
"Ключ аутентификации (auth_key) по умолчанию для криптографического слоя, "
"используется для проверки подписи при рукопожатии. Оставьте пустым для "
"отключения."

#: hetu/cli/start.py:154
msgid "配置文件模板见CONFIG_TEMPLATE.yml"
msgstr "Шаблон конфигурационного файла см. в CONFIG_TEMPLATE.yml"

#: hetu/cli/start.py:175
msgid "--app_file是必须参数，或者用--config"
msgstr ""
"--app_file является обязательным параметром, либо используйте --config"

#: hetu/cli/start.py:178
msgid "--namespace是必须参数，或者用--config"
msgstr ""
"--namespace является обязательным параметром, либо используйте --config"

#: hetu/cli/start.py:181
msgid "--instance是必须参数，或者用--config"
msgstr ""
"--instance является обязательным параметром, либо используйте --config"

#: hetu/cli/start.py:240
#, python-brace-format
msgid "ℹ️ {name}, {mode}, {workers} 个工作进程, 管理进程 pid: {pid}"
msgstr ""
"ℹ️ {name}, {mode}, {workers} рабочих процессов, pid управляющего процесса: "
"{pid}"

#: hetu/cli/start.py:248
#, python-brace-format
msgid "ℹ️ Python {version} 平台 {platform}"
msgstr "ℹ️ Python {version}, платформа {platform}"

#: hetu/cli/start.py:253
#, python-brace-format
msgid "📡 监听地址： http{s}://{host}:{port}"
msgstr "📡 Адрес прослушивания: http{s}://{host}:{port}"

#: hetu/cli/start.py:259
#, python-brace-format
msgid "ℹ️ 消息流协议：json -> {layers} -> Network"
msgstr "ℹ️ Протокол потока сообщений: json -> {layers} -> Network"

#: hetu/cli/start.py:275
#, python-brace-format
msgid "🔑 auth_key: {key}"
msgstr "🔑 auth_key: {key}"

#: hetu/cli/start.py:277
msgid "🔑 auth_key 未设置 ⚠️ 任意 key 都能连接"
