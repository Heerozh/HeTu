msgstr "[❄️ID] クロックが{ms}ミリ秒戻りました。"

#: hetu/common/snowflake_id.py:226 hetu/common/snowflake_id.py:242
msgid "[❄️ID] 每毫秒只能生成有限的ID，需要休眠 1 ms"
msgstr "[❄️ID] ミリ秒あたりに生成できるID数には限りがあります。1ミリ秒スリープが必要です"

#: hetu/common/yamlloader.py:66
#, python-brace-format, python-format
msgid "环境变量 ${%s} 未设置且无默认值，如需空值请用 ${%s:-}"
msgstr "環境変数 ${%s} が設定されておらず、デフォルト値もありません。空値が必要な場合は ${%s:-} を使用してください。"

#: hetu/data/component.py:417
#, python-brace-format
msgid "{cname}.{pname}不是字符串属性（dtype={d}）"
msgstr "{cname}.{pname}は文字列属性ではありません（dtype={d}）"

#: hetu/data/component.py:501
msgid "Component重复定义"
msgstr "Componentの重複定義"

#: hetu/data/component.py:634
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是Python关键字。"
msgstr "{cname}.{fname}属性の定義エラー：属性名はPythonのキーワードにできません。"

#: hetu/data/component.py:640
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是C#关键字。"
msgstr "{cname}.{fname}属性の定義エラー：属性名はC#のキーワードにできません。"

#: hetu/data/component.py:648
#, python-brace-format
msgid ""
"{cname}.{fname}属性定义出错，属性名不能和numpy行数据的属性同名，否则row.{fname}读到的是numpy的属性而不是字段值，请换个名字。"
msgstr ""
"{cname}.{fname}属性の定義エラー：属性名をnumpyの行データの属性と同名にできません。同名の場合、row.{fname}はフィールド値ではなくnumpyの属性を読み取ってしまいます。別の名前にしてください。"

#: hetu/data/component.py:654
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不能为0长度。str类型请用'<U8'方式定义"
msgstr "{cname}.{fname}属性のdtypeは長さ0にできません。str型は'<U8'のような形式で定義してください。"

#: hetu/data/component.py:657
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不支持void类型"
msgstr "{cname}.{fname}属性のdtypeはvoid型をサポートしていません。"

#: hetu/data/component.py:668
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为unique时，index不能设置为False。"
msgstr "⚠️ [🛠️Define] {cname}.{fname}属性をuniqueに設定する場合、indexをFalseに設定できません。"

#: hetu/data/component.py:678
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了groupby（复合索引），point_sub用不上已忽略：按组订阅本来就只被本组的写入叫醒。"
msgstr ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性にgroupby（複合インデックス）が設定されていますが、point_subでは使用できないため無視しました：グループ単位の購読は元々、同じグループの書き込みによってのみ通知されるためです。"

#: hetu/data/component.py:690
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了commit_seq，point_sub用不上已忽略：号要到提交时才有，发不出值频道。"
msgstr ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性にcommit_seqが設定されていますが、point_subでは使用できないため無視しました：番号はコミット時にしか確定しないため、値をチャンネルに送信できません。"

#: hetu/data/component.py:698
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了commit_seq时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] {cname}.{fname}属性にcommit_seqを設定する場合、indexをFalseに設定できません。"

#: hetu/data/component.py:707
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为point_sub时，index不能设置为False。"
msgstr "⚠️ [🛠️Define] {cname}.{fname}属性をpoint_subに設定する場合、indexをFalseに設定できません。"

#: hetu/data/component.py:716
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了groupby时，index不能设置为False。"
msgstr "⚠️ [🛠️Define] {cname}.{fname}属性にgroupbyを設定する場合、indexをFalseに設定できません。"

#: hetu/data/component.py:725
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，hidden属性不能同时设置point_sub：客户端不能按hidden属性订阅。"
msgstr ""
"{cname}.{fname}属性の定義エラー：hidden属性とpoint_subを同時に設定できません：クライアントはhidden属性で購読できません。"

#: hetu/data/component.py:731
#, python-brace-format
msgid ""
"{cname}.{fname}默认值不能为None。所有属性都要有默认值，因为数据接口统一用c like "
"struct实现，强类型struct不接受NULL/None值。"
msgstr ""
"{cname}.{fname}のデフォルト値をNoneにできません。すべての属性にはデフォルト値が必要です。データインターフェースはC言語風のstructで統一実装されており、強力な型付けを持つstructはNULL/None値を受け付けません。"

#: hetu/data/component.py:742
#, python-brace-format
msgid ""
"{cname}.{fname}的default值：{default_type}({default_value})和属性dtype({dtype})不匹配"
msgstr ""
"{cname}.{fname}のdefault値：{default_type}({default_value})と属性のdtype({dtype})が一致しません。"

#: hetu/data/component.py:756
#, python-brace-format
msgid "{cname}权限为OWNER时，不能设置rls_compare参数"
msgstr "{cname}の権限がOWNERの場合、rls_compareパラメータを設定できません。"

#: hetu/data/component.py:759
#, python-brace-format
msgid "{cname}权限为OWNER时，必须有owner属性"
msgstr "{cname}の権限がOWNERの場合、owner属性が必要です。"

#: hetu/data/component.py:766
#, python-brace-format
msgid "{cname}的owner属性必需是numeric数字(int, np.int64, ...)类型"
msgstr "{cname}のowner属性は数値型（int, np.int64, ...）でなければなりません。"

#: hetu/data/component.py:772
#, python-brace-format
msgid "{cname}权限为RLS时，必须通过rls_compare参数定义行级权限逻辑"
msgstr "{cname}の権限がRLSの場合、rls_compareパラメータで行レベル権限ロジックを定義する必要があります。"

#: hetu/data/component.py:775
#, python-brace-format
msgid "{cname}.rls_compare参数必须全部是字符串类型"
msgstr "{cname}.rls_compareパラメータはすべて文字列型でなければなりません。"

#: hetu/data/component.py:778
#, python-brace-format
msgid "{cname}.rls_compare参数必须只有3个元素)"
msgstr "{cname}.rls_compareパラメータは3つの要素のみでなければなりません。"

#: hetu/data/component.py:782
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但operator模块没有{method}方法"
msgstr "{cname}の権限がRLS: {rls_compare}ですが、operatorモジュールに{method}メソッドがありません。"

#: hetu/data/component.py:786
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但表没有定义{prop}属性"
msgstr "{cname}の権限がRLS: {rls_compare}ですが、テーブルに{prop}属性が定義されていません。"

#: hetu/data/component.py:803
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列必须是本组件的字段名，不能是id、_version：{col!r}"
msgstr ""
"{cname}.{fname}のgroupby定義エラー：グループ列はこのコンポーネントのフィールド名でなければならず、id、_versionは使用できません：{col!r}"

#: hetu/data/component.py:809
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，不能按自己分组"
msgstr "{cname}.{fname}のgroupby定義エラー：自分自身でグループ化できません。"

#: hetu/data/component.py:816
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，组件没有字段`{col}`"
msgstr "{cname}.{fname}のgroupby定義エラー：コンポーネントにフィールド`{col}`がありません。"

#: hetu/data/component.py:822
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列`{col}`重复了"
msgstr "{cname}.{fname}のgroupby定義エラー：グループ列`{col}`が重複しています。"

#: hetu/data/component.py:830
#, python-brace-format
msgid ""
"{cname}.{fname}的groupby定义出错，分组列`{col}`只能是整数、str、bytes类型，不能是{dtype}：浮点按等值分组没有意义，NaN、-0.0"
" 的相等也说不清"
msgstr ""
"{cname}.{fname}のgroupby定義エラー：グループ列`{col}`は整数、str、bytes型のみ使用でき、{dtype}は使用できません：浮動小数点の等値グループ化は意味がなく、NaNや-0.0の等価性も明確ではありません。"

#: hetu/data/component.py:842
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，{dtype}类型不能建索引"
msgstr "{cname}.{fname}属性の定義エラー：{dtype}型はインデックスを作成できません。"

#: hetu/data/component.py:855
#, python-brace-format
msgid "{cname}定义出错，最多只能有一个commit_seq字段：{fields}"
msgstr "{cname}の定義エラー：commit_seqフィールドは最大1つまでです：{fields}"

#: hetu/data/component.py:866
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的类型只能是np.int64，不能是{dtype}"
msgstr "{cname}.{fname}属性の定義エラー：commit_seqの型はnp.int64のみ使用でき、{dtype}は使用できません。"

#: hetu/data/component.py:875
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的default必须是0：0表示还没发号，号从1开始"
msgstr ""
"{cname}.{fname}属性の定義エラー：commit_seqのdefaultは0でなければなりません：0はまだ番号が発行されていないことを示し、番号は1から始まります。"

#: hetu/data/component.py:884
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq不能同时设置unique：组内唯一由发号保证"
msgstr ""
"{cname}.{fname}属性の定義エラー：commit_seqとuniqueを同時に設定できません：グループ内の一意性は番号発行によって保証されます。"

#: hetu/data/component.py:894
#, python-brace-format
msgid "{cname}.{other}的groupby定义出错，commit_seq字段`{fname}`不能当分组列：它的号要到提交时才有"
msgstr ""
"{cname}.{other}のgroupby定義エラー：commit_seqフィールド`{fname}`はグループ列にできません：その番号はコミット時にしか確定しません。"

#: hetu/data/component.py:912
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq字段不能用作行级权限的判定列"
msgstr "{cname}.{fname}属性の定義エラー：commit_seqフィールドは行レベル権限の判定列に使用できません。"

#: hetu/data/component.py:921
#, python-brace-format
msgid "组件名({name})是C#关键字，请refactor。"
msgstr "コンポーネント名({name})はC#のキーワードです。リファクタリングしてください。"

#: hetu/data/component.py:934
#, python-brace-format
msgid "{cls_name}.{name}不是Property类型"
msgstr "{cls_name}.{name}はProperty型ではありません。"

#: hetu/data/component.py:944
#, python-brace-format
msgid ""
"{cls_name}.{name}属性未定义type hint。请使用以下形式，{name}: type = property_field(...)"
msgstr ""
"{cls_name}.{name}属性に型ヒントが定義されていません。次の形式を使用してください：{name}: type = "
"property_field(...)"

#: hetu/data/component.py:949
#, python-brace-format
msgid "{cls_name}至少要有1个Property成员"
msgstr "{cls_name}には少なくとも1つのPropertyメンバーが必要です。"

#: hetu/data/component.py:957
#, python-brace-format
msgid "{cls_name}.id是保留的内置主键，外部不能重定义"
msgstr "{cls_name}.idは組み込みの主キーとして予約されており、外部から再定義できません。"

#: hetu/data/component.py:960
#, python-brace-format
msgid "{cls_name}._version是保留的内置主键，外部不能重定义"
msgstr "{cls_name}._versionは組み込みの主キーとして予約されており、外部から再定義できません。"

#: hetu/data/component.py:969
#, python-brace-format
msgid "{cls_name}必须继承于BaseComponent"
msgstr "{cls_name}はBaseComponentを継承しなければなりません。"

#: hetu/data/component.py:977
#, python-brace-format
