#: hetu/headless.py:83
#, python-brace-format
msgid ""
"实例 {instance} 里不存在组件表 {comp_name}：请先启动 HeTu 服务器建表（或检查 instance / 组件名 / "
"后端配置是否指向同一个数据库）"
msgstr ""
"インスタンス {instance} にComponentテーブル {comp_name} が存在しません：先に HeTu "
"サーバーを起動してテーブルを作成してください（または instance / Component名 / "
"Backend設定が同じデータベースを指しているか確認してください）"

#: hetu/headless.py:102
#, python-brace-format
msgid "组件 {comp_name} 的本地定义与服务器表结构不一致（服务器 -> 本地）：{diff}"
msgstr "Component {comp_name} のローカル定義はサーバーのテーブル構造と一致しません（サーバー -> ローカル）：{diff}"

#: hetu/headless.py:119
#, python-brace-format
msgid ""
"组件 {comp_name} 的 cluster_id 已由 {old_id} 变为 {new_id}（服务器已迁簇），请重新 connect"
msgstr ""
"Component {comp_name} の cluster_id は {old_id} から {new_id} "
"に変更されました（サーバーはクラスタを移行済みです）。再度 connect してください。"

#: hetu/headless.py:248
#, python-brace-format
msgid ""
"组件 {name} 未在本事务声明（或不是 connect 时认下的那个类），请在 client.session(...) "
"里加上；已声明：{declared}"
msgstr ""
"Component {name} はこのトランザクションで宣言されていません（または connect "
"時に認識されたクラスではありません）。client.session(...) に追加してください。宣言済み: {declared}"

#: hetu/headless.py:295 hetu/headless.py:316
#, python-brace-format
msgid "组件 {name} 重复声明"
msgstr "Component {name} の宣言が重複しています。"

#: hetu/headless.py:309
msgid "components 不能为空：至少声明一个组件"
msgstr "components は空にできません：少なくとも1つの Component を宣言してください。"

#: hetu/headless.py:330
#, python-brace-format
msgid "⚠️ [🧩Headless] 组件 {name} 的默认值与服务器不同（只影响本进程 new_row 的填充值）：{diff}"
msgstr ""
"⚠️ [🧩Headless] Component {name} のデフォルト値がサーバーと異なります（このプロセスの new_row "
"の初期値にのみ影響します）：{diff}"

#: hetu/headless.py:337
#, python-brace-format
msgid "[🧩Headless] 实例 {instance} 组件表 {name} → cluster {cid}"
msgstr "[🧩Headless] インスタンス {instance} Componentテーブル {name} → cluster {cid}"

#: hetu/headless.py:370
#, python-brace-format
msgid "组件 {name} 未在 connect(components=...) 里声明；已声明：{declared}"
msgstr ""
"Component {name} は connect(components=...) で宣言されていません。宣言済み: {declared}"

#: hetu/headless.py:376
#, python-brace-format
msgid ""
"组件 {name} 是按名字声明的，其类来自服务器 meta，请用 client.table('{name}').comp_cls 而不是本地类"
msgstr ""
"Component {name} は名前で宣言されており、そのクラスはサーバーの meta に由来します。ローカルクラスではなく "
"client.table('{name}').comp_cls を使用してください。"

#: hetu/headless.py:394
msgid "session() 至少要声明一个组件"
msgstr "session() は少なくとも1つの Component を宣言する必要があります。"

#: hetu/headless.py:401
#, python-brace-format
msgid "同一事务的组件必须同簇（簇由服务器 System 的引用关系决定，跨簇请拆成两个事务）：{detail}"
msgstr ""
"同一トランザクションの Component は同じクラスタである必要があります（クラスタはサーバーの System "
"の参照関係によって決まります。クラスタをまたぐ場合は2つのトランザクションに分割してください）：{detail}"

#: hetu/local.py:86
msgid "库里没有这张表：先用当前代码启动一次服务器（会建新表）"
msgstr "データベースにこのテーブルがありません：まず現在のコードでサーバーを一度起動してください（新しいテーブルが作成されます）"

#: hetu/local.py:89
msgid "本地代码与库里的表结构 / 簇不一致：先 hetu upgrade，或用与线上一致的代码版本运行"
msgstr ""
"ローカルコードとデータベース内のテーブル構造 / クラスタが一致しません：まず hetu upgrade "
"を実行するか、本番と同じコードバージョンで実行してください"

#: hetu/local.py:93
#, python-brace-format
msgid "组件 {comp_name} 的表状态为 {status}，{hint}"
msgstr "Component {comp_name} のテーブル状態は {status} です。{hint}"

#: hetu/local.py:117
#, python-brace-format
msgid ""
"System {system} 是 USER 权限：生产里只有已登录连接能调，请指定玩家 id（hetu call 用 --as <uid>，代码里传 "
"caller=）"
msgstr ""
"System {system} は USER 権限です：本番環境ではログイン済みの接続からのみ呼び出せます。プレイヤー id "
"を指定してください（hetu call では --as <uid>、コード内では caller= を渡します）"

#: hetu/cli/build.py:46 hetu/local.py:128
#, python-brace-format
msgid "无法加载app文件 {app_file}"
msgstr "アプリファイル {app_file} を読み込めません"

#: hetu/local.py:376
#, python-brace-format
msgid "找不到 Component：{comp}（是否在 components 中引用过？）"
msgstr "Component が見つかりません：{comp}（components 内で参照されていますか？）"

#: hetu/local.py:397
#, python-brace-format
msgid "{comp} 中不存在匹配 {query} 的行"
msgstr "{comp} に {query} に一致する行がありません"

#: hetu/local.py:443
#, python-brace-format
msgid "{comp} 组件没有叫 {name} 的字段"
msgstr "Component {comp} に {name} というフィールドはありません"

#: hetu/local.py:448
msgid "_version 由引擎管理，insert 时不能设置"
msgstr "_version はエンジンが管理しているため、insert 時に設定できません"

#: hetu/local.py:509
#, python-brace-format
msgid "库文件不存在：{path}（服务器还没在这个库上启动过，或配置路径不对）"
msgstr "データベースファイルが存在しません：{path}（このデータベースでサーバーを起動したことがないか、設定されたパスが間違っています）"

#: hetu/cli/base.py:238 hetu/local.py:562
#, python-brace-format
msgid "实例 {instance} 不在配置的 INSTANCES 里：{instances}"
msgstr "インスタンス {instance} は設定された INSTANCES にありません：{instances}"

#: hetu/manager.py:57
#, python-brace-format
msgid "Backend {backend}未找到"
msgstr "バックエンド {backend} が見つかりません"

#: hetu/manager.py:104
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表结构需要迁移Schema。"
msgstr "⚠️  コンポーネント {comp_name} のテーブル構造はスキーマ移行が必要です。"

#: hetu/manager.py:111
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表需要迁移到新集群。"
msgstr "⚠️  コンポーネント {comp_name} のテーブルは新しいクラスタに移行する必要があります。"

#: hetu/webext.py:91
#, python-brace-format
msgid "define_route的uri必须以'/'开头，你的：{uri}"
msgstr "define_routeのuriは'/'で始まる必要があります。あなたのもの：{uri}"

#: hetu/webext.py:96
#, python-brace-format
msgid "define_route的uri不能占用HeTu保留的'{prefix}'路径（客户端SDK的WebSocket入口），你的：{uri}"
msgstr ""
"define_routeのuriは河図が予約している'{prefix}'パス（クライアントSDKのWebSocketエントリポイント）を使用することはできません。あなたのもの：{uri}"

#: hetu/cli/__init__.py:70
msgid "河图数据库"
msgstr "河図データベース"

#: hetu/cli/__init__.py:75
msgid "执行操作"
msgstr "操作を実行"

#: hetu/cli/__init__.py:103
#, python-brace-format
msgid "无法识别的参数：{extras}"
msgstr "認識できない引数：{extras}"

#: hetu/cli/base.py:46
msgid "Boolean value expected."
msgstr "ブール値が必要です。"

#: hetu/cli/base.py:69
#, python-brace-format
msgid ""
"SQL 后端已移除，PostgreSQL / MariaDB 不再支持：'{scheme}'。开发用 sqlite:///<库文件路径>，生产用 "
"Redis"
msgstr ""
"SQL Backend は削除され、PostgreSQL / MariaDB はサポートされなくなりました：'{scheme}'。開発には "
"sqlite:///<データベースファイルのパス>、本番には Redis を使用してください"

#: hetu/cli/base.py:77
#, python-brace-format
msgid "不支持的数据库URL scheme: '{scheme}'。目前支持 redis/rediss/valkey/valkeys/sqlite"
msgstr ""
"サポートされていないデータベース URL scheme です：'{scheme}'。現在サポートしているのは "
"redis/rediss/valkey/valkeys/sqlite です"

#: hetu/cli/base.py:106
#, python-brace-format
msgid "⚠️ SQLite 库文件的相对路径现在按配置文件所在目录解析：{new}。旧位置（相对当前目录）{old} 有库文件，如需沿用请把它挪过去"
msgstr ""
"⚠️ SQLite "
"データベースファイルの相対パスは、設定ファイルのあるディレクトリを基準に解決されるようになりました：{new}。旧位置（カレントディレクトリ基準）{old}"
" にデータベースファイルがあります。引き続き使用する場合は移動してください"

#: hetu/cli/base.py:125
#, python-brace-format
msgid "读不了配置文件 {path}：{err}"
msgstr "設定ファイル {path} を読み込めません：{err}"

#: hetu/cli/base.py:128
#, python-brace-format
msgid "配置文件 {path} 不是一个映射"
msgstr "設定ファイル {path} はマッピングではありません"

#: hetu/cli/base.py:192
#, python-brace-format
msgid "命令行参数模式缺少：{missing}（或改用 --config）"
msgstr "コマンドライン引数モードで不足しています：{missing}（または --config を使用してください）"

#: hetu/cli/base.py:223
msgid ""
"找不到配置：用 --config 指定，或设环境变量 HETU_CONFIG，或在当前目录放 config.yml；也可以用 --app-file / "
"--namespace / --instance / --db 直接给出"
msgstr ""
"設定が見つかりません：--config で指定するか、環境変数 HETU_CONFIG を設定するか、カレントディレクトリに config.yml "
"を置いてください。--app-file / --namespace / --instance / --db で直接指定することもできます"

#: hetu/cli/base.py:233
msgid "配置里没有 INSTANCES"
msgstr "設定に INSTANCES がありません"

#: hetu/cli/base.py:247
msgid "配置"
msgstr "設定"

#: hetu/cli/base.py:251
msgid "配置文件；不给时依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr "設定ファイル。指定しない場合は環境変数 HETU_CONFIG、カレントディレクトリの config.yml の順に探します"

#: hetu/cli/base.py:256
msgid "实例名，默认取配置里 INSTANCES 的第一个"
msgstr "インスタンス名。デフォルトでは設定内の INSTANCES の最初のものを使用します"

#: hetu/cli/base.py:259
msgid "（无配置文件时）河图app的py文件"
msgstr "（設定ファイルがない場合）河図 app の py ファイル"

#: hetu/cli/base.py:262
msgid "（无配置文件时）app的namespace"
msgstr "（設定ファイルがない場合）app の namespace"

#: hetu/cli/base.py:267
msgid "（无配置文件时）后端数据库地址"
msgstr "（設定ファイルがない場合）Backend データベースのアドレス"

#: hetu/cli/build.py:22
msgid "生成客户端SDK C# 类型代码"
msgstr "クライアントSDK C# 型コードを生成"

#: hetu/cli/build.py:26
msgid "河图app的py文件"
msgstr "河図アプリのpyファイル"

#: hetu/cli/build.py:33
msgid "编译app.py中哪个namespace下的数据类型"
msgstr "app.py内のどのnamespaceのデータ型をコンパイルするか"

#: hetu/cli/build.py:37
msgid "输出文件路径"
msgstr "出力ファイルパス"

#: hetu/cli/build.py:59
#, python-brace-format
msgid "✅ 已生成C#代码到 {output}"
msgstr "✅ C#コードを {output} に生成しました"

#: hetu/cli/call.py:85
#, python-brace-format
msgid ""
"第 {n} 个参数看起来是 JSON 但解析失败（PowerShell 可能吃掉了引号），改用 --args-file 或 stdin：{raw}"
msgstr ""
"{n} 番目の引数は JSON に見えますが解析に失敗しました（PowerShell が引用符を消費した可能性があります）。--args-file か "
"stdin を使ってください：{raw}"

#: hetu/cli/call.py:104
#, python-brace-format
msgid "--args-file 读不了或不是合法 JSON：{err}"
msgstr "--args-file を読めないか、有効な JSON ではありません：{err}"

#: hetu/cli/call.py:107
msgid "--args-file 的内容必须是 JSON 数组"
msgstr "--args-file の内容は JSON 配列でなければなりません"

#: hetu/cli/call.py:122
#, python-brace-format
msgid "--user-data 读不了或不是合法 JSON：{err}"
msgstr "--user-data を読めないか、有効な JSON ではありません：{err}"

#: hetu/cli/call.py:125
msgid "--user-data 必须是 JSON 对象"
msgstr "--user-data は JSON オブジェクトでなければなりません"

#: hetu/cli/call.py:135
#, python-brace-format
msgid "System {name} 要 {low}-{high} 个参数，给了 {n} 个"
msgstr "System {name} は {low}-{high} 個の引数を必要としますが、{n} 個指定されました"

#: hetu/cli/call.py:162
#, python-brace-format
msgid "，相近的有：{close}"
msgstr "、近いもの：{close}"

#: hetu/cli/call.py:164
#, python-brace-format
msgid "不存在的 System：{name}{hint}（hetu call --list 查看全部）"
msgstr "存在しない System：{name}{hint}（hetu call --list で全件表示）"

#: hetu/cli/call.py:293
#, python-brace-format
msgid ""
"System {name} 超过 {timeout} 秒没结束，已中止。若超时发生在提交途中，提交可能已经生效：writes 里 committed 为"
" unknown 的那次，请直接查数据确认"
msgstr ""
"System {name} が {timeout} "
"秒を超えても終了しないため、中止しました。タイムアウトがコミット途中で発生した場合、コミットはすでに有効になっている可能性があります：writes "
"のうち committed が unknown のものについて、直接データを確認してください"

#: hetu/cli/call.py:303
#, python-brace-format
msgid "System 留下 {n} 个后台任务，CLI 退出时已取消（在服务器里它们会继续跑）"
msgstr "System が {n} 個のバックグラウンドタスクを残しました。CLI の終了時にキャンセル済みです（サーバー内では実行が継続されます）"

#: hetu/cli/call.py:333
msgid "--args-file 与位置参数不能同时给"
msgstr "--args-file と位置引数は同時に指定できません"

#: hetu/cli/call.py:348
#, python-brace-format
msgid "生产端点不会放行这个身份（caller={caller}，group={group}）调用 {permission} 权限的 System"
msgstr ""
"本番エンドポイントでは、この ID（caller={caller}、group={group}）による {permission} 権限の System "
"呼び出しは許可されません"

#: hetu/cli/call.py:359
#, python-brace-format
msgid "System {name} 读了 ctx.caller，而当前 caller 是推断出来的 0；要以玩家身份跑请用 --as <uid>"
msgstr ""
"System {name} は ctx.caller を参照しましたが、現在の caller は推定値の 0 です。プレイヤーとして実行するには "
"--as <uid> を使用してください"

#: hetu/cli/call.py:441
msgid ""
"在本进程里直连后端调用一个 System（不经服务器），stdout 输出一行 JSON。调试用：写入与 System "
"走同一条提交路径，在线客户端照常收到推送"
msgstr ""
"このプロセス内で Backend に直接接続して System を呼び出します（サーバーを経由しません）。stdout に 1 行の JSON "
"を出力します。デバッグ用：書き込みは System と同じコミット経路を通り、オンラインのクライアントには通常どおりプッシュが届きます"

#: hetu/cli/call.py:449
msgid "列出全部 System（参数、权限、引用的组件、文档第一行），不连数据库"
msgstr "すべての System を一覧表示します（引数、権限、参照する Component、ドキュメントの先頭行）。データベースには接続しません"

#: hetu/cli/call.py:451
msgid "身份"
msgstr "ID"

#: hetu/cli/call.py:458
msgid ""
"以这个玩家 id 调用（ctx.caller）。USER 权限的 System 必须给；不给时按权限推断：ADMIN/GM/内部 System 用 "
"admin，EVERYBODY 用 guest"
msgstr ""
"このプレイヤー id で呼び出します（ctx.caller）。USER 権限の System "
"では必須です。省略時は権限に応じて推定されます：ADMIN/GM/内部 System は admin、EVERYBODY は guest"

#: hetu/cli/call.py:465
msgid "ctx.group，如 gm / admin；给了 --as 时默认 guest"
msgstr "ctx.group（例：gm / admin）。--as 指定時はデフォルトで guest"

#: hetu/cli/call.py:470
msgid "ctx.user_data（登录时写进去的数据 CLI 不知道，需要时手动给）"
msgstr "ctx.user_data（ログイン時に書き込まれるデータは CLI では分からないため、必要に応じて手動で指定します）"

#: hetu/cli/call.py:476
msgid "从文件读参数（一个 JSON 数组），- 为 stdin；避开 PowerShell 的引号问题"
msgstr "ファイルから引数を読み込みます（JSON 配列）。- は stdin を表します。PowerShell の引用符の問題を回避できます"

#: hetu/cli/call.py:482
msgid "调用锁 uuid（call_lock 的 System），同一 uuid 只执行一次"
msgstr "呼び出しロックの uuid（call_lock の System）。同じ uuid は 1 回だけ実行されます"

#: hetu/cli/call.py:487
msgid "照常执行但不提交，输出它会写什么（写集）"
msgstr "通常どおり実行しますがコミットせず、書き込まれる内容（書き込みセット）を出力します"

#: hetu/cli/call.py:494
msgid "System 调用的超时秒数，默认 30，0 为不限"
msgstr "System 呼び出しのタイムアウト秒数。デフォルトは 30、0 は無制限"

#: hetu/cli/call.py:501 hetu/cli/data.py:398 hetu/cli/shell.py:364
msgid "stderr 上多打日志：-v 为 INFO，-vv 为 DEBUG"
msgstr "stderr にログを追加出力します：-v は INFO、-vv は DEBUG"

#: hetu/cli/call.py:503
msgid "System 名"
msgstr "System 名"

#: hetu/cli/call.py:508
msgid "参数：按 JSON 解析，解析不了当字符串；- 开头的放在 -- 后面"
msgstr "引数：JSON として解析され、解析できない場合は文字列として扱われます。- で始まるものは -- の後に置いてください"

#: hetu/cli/call.py:518
msgid "要给 System 名（hetu call --list 查看全部）"
msgstr "System 名を指定してください（hetu call --list で全件表示）"

#: hetu/cli/console.py:67
msgid ""
"本配置禁止 hetu call / shell 写入（CLI_ALLOW_WRITE: false）：加 --dry-run 看它会写什么，或在配置里设"
" CLI_ALLOW_WRITE: true"
msgstr ""
"本設定では hetu call / shell の書き込みが禁止されています（CLI_ALLOW_WRITE: false）：--dry-run "
"を付けて何を書き込むか確認するか、設定で CLI_ALLOW_WRITE: true を設定してください"

#: hetu/cli/console.py:366
#, python-brace-format
msgid "审计日志写不进去：{path}（{err}）。可用配置 CLI_AUDIT_LOG 改路径"
msgstr "監査ログを書き込めません：{path}（{err}）。設定 CLI_AUDIT_LOG でパスを変更できます"

#: hetu/cli/console.py:376
#, python-brace-format
msgid "⚠️ 审计日志写不进去：{path}（{err}）"
msgstr "⚠️ 監査ログを書き込めません：{path}（{err}）"

#: hetu/cli/console.py:550
msgid "DEBUG 关闭的配置（按生产库对待）上 CLI 刚刚真写入了数据；要禁止，在配置里设 CLI_ALLOW_WRITE: false"
msgstr ""
"DEBUG が無効な設定（本番データベースとして扱う）で、CLI が先ほど実際にデータを書き込みました。禁止するには、設定で "
"CLI_ALLOW_WRITE: false を設定してください"

#: hetu/cli/console.py:630
msgid "Worker ID 租约丢失（本进程卡住太久被别人接手），命令已中止"
msgstr "Worker ID のリースを失いました（このプロセスが長時間停止して他のプロセスに引き継がれたため）、コマンドは中止されました"

#: hetu/cli/console.py:653
#, python-brace-format
msgid "⚠️ 后台任务 {task} 退出时出错：{err}"
msgstr "⚠️ バックグラウンドタスク {task} の終了時にエラーが発生しました：{err}"

#: hetu/cli/console.py:659
#, python-brace-format
msgid "⚠️ {n} 个后台任务 {timeout} 秒内没有响应取消，不再等待"
msgstr "⚠️ {n} 個のバックグラウンドタスクが {timeout} 秒以内にキャンセルに応答しなかったため、これ以上待機しません"

#: hetu/cli/console.py:672
#, python-brace-format
msgid "收尾释放租约 / 关闭连接时出错（不影响已经完成的操作）：{err}"
msgstr "終了処理でリースの解放 / 接続のクローズ時にエラーが発生しました（完了済みの操作には影響しません）：{err}"

#: hetu/cli/data.py:65
#, python-brace-format
msgid "值 {raw} 不能转换成列类型 {dtype}"
msgstr "値 {raw} は列型 {dtype} に変換できません"

#: hetu/cli/data.py:89
#, python-brace-format
msgid "分组值 {raw} 不能转换成列类型 {dtype}"
msgstr "グループ値 {raw} は列型 {dtype} に変換できません"

#: hetu/cli/data.py:100 hetu/cli/data.py:282
msgid "查询要写成 FIELD=VALUE，如 owner=1001"
msgstr "クエリは FIELD=VALUE の形式で指定してください（例: owner=1001）"

#: hetu/cli/data.py:104
#, python-brace-format
msgid "{field} 给了不止一次"
msgstr "{field} が複数回指定されています"

#: hetu/cli/data.py:122
#, python-brace-format
msgid ""
"组件 {comp} 的 {field} 不是 id 或带索引的字段，不能查；可查的有：{fields}（括号里是复合索引的分组列，查询时要一并用 "
"FIELD=VALUE 给出）"
msgstr ""
"Component {comp} の {field} は id またはインデックス付きフィールドではないため、クエリできません。クエリ可能なフィールド:"
" {fields}（括弧内は複合インデックスのグループ列で、クエリ時には FIELD=VALUE で併せて指定する必要があります）"

#: hetu/cli/data.py:140
#, python-brace-format
msgid "--index {index} 要同时用 {index}=VALUE 给出查询值"
msgstr "--index {index} を指定する場合は、同時に {index}=VALUE でクエリ値を指定してください"

#: hetu/cli/data.py:157
#, python-brace-format
msgid ""
"查询条件 {keys} 对不上组件 {comp} "
"的任何索引：要么只给一个带索引的字段，要么正好给出复合索引的本字段和全部分组列；可查的有：{fields}"
msgstr ""
"クエリ条件 {keys} は Component {comp} のどのインデックスにも一致しません。インデックス付きフィールドを 1 "
"つだけ指定するか、複合インデックスの対象フィールドとすべてのグループ列を正確に指定してください。クエリ可能なフィールド: {fields}"

#: hetu/cli/data.py:166
#, python-brace-format
msgid "查询条件 {keys} 同时匹配了 {matched} 几个索引，请用 --index 指定"
msgstr "クエリ条件 {keys} が {matched} 個のインデックスに同時に一致しました。--index で指定してください"

#: hetu/cli/data.py:181
#, python-brace-format
msgid "{index} 是按 {columns} 分组的复合索引，要用 FIELD=VALUE 正好给出这些分组列，收到：{keys}"
msgstr ""
"{index} は {columns} でグループ化された複合インデックスです。FIELD=VALUE "
"でこれらのグループ列を正確に指定してください。受信内容: {keys}"

#: hetu/cli/data.py:186
#, python-brace-format
msgid "{index} 不是复合索引，多给了 {keys}"
msgstr "{index} は複合インデックスではありません。余分に指定されています: {keys}"

#: hetu/cli/data.py:390
msgid "读 master（刚写完马上读时用）；默认读 servant"
msgstr "master を読みます（書き込み直後にすぐ読む場合に使用）。デフォルトでは servant を読みます"

#: hetu/cli/data.py:392
msgid "只输出这些列，逗号分隔"
msgstr "これらの列のみを出力します。カンマ区切り"

#: hetu/cli/data.py:414
msgid ""
"按 id 或带索引的字段读一行组件数据（不做 RLS），stdout 输出一行 JSON；不加载 app，schema 取自库里的表 meta"
msgstr ""
"id またはインデックス付きフィールドで Component データを 1 行読み込みます（RLS は行いません）。stdout に 1 行の JSON"
" を出力します。app は読み込まず、schema はデータベース内のテーブル meta から取得します"

#: hetu/cli/data.py:422
msgid "列出组件、字段与索引（加载 app，不连数据库）"
msgstr "Component、フィールド、インデックスを一覧表示します（app を読み込み、データベースには接続しません）"

#: hetu/cli/data.py:427
msgid "FIELD=VALUE 同时匹配了几个复合索引时，指定按哪个索引查（其余 FIELD=VALUE 是它的分组值）"
msgstr ""
"FIELD=VALUE が複数の複合インデックスに同時に一致する場合に、どのインデックスでクエリするかを指定します（残りの FIELD=VALUE "
"はそのグループ値です）"

#: hetu/cli/data.py:437
msgid "一个带索引的字段，如 owner=1001；复合索引要同时给出全部分组列，如 name=abc zone=3"
msgstr ""
"インデックス付きフィールドを 1 つ指定します。例: owner=1001。複合インデックスの場合は、すべてのグループ列を同時に指定します。例: "
"name=abc zone=3"

#: hetu/cli/data.py:450
msgid "要给组件名和 FIELD=VALUE（hetu get --list 查看组件）"
msgstr "Component 名と FIELD=VALUE を指定してください（hetu get --list で Component を確認）"

#: hetu/cli/data.py:469
msgid ""
"按带索引的字段读一个区间的组件数据（不做 RLS），stdout 输出一行 JSON；省略 RIGHT 即精确匹配 LEFT，( / [ 前缀表示开 /"
" 闭区间"
msgstr ""
"インデックス付きフィールドで範囲内の Component データを読み込みます（RLS は行いません）。stdout に 1 行の JSON "
"を出力します。RIGHT を省略すると LEFT の完全一致になります。( / [ の接頭辞は開区間 / 閉区間を表します"

#: hetu/cli/data.py:478
msgid "最多返回多少行，默认 10，-1 为不限"
msgstr "最大で何行返すか。デフォルトは 10、-1 は無制限"

#: hetu/cli/data.py:480
msgid "降序"
msgstr "降順"

#: hetu/cli/data.py:486
msgid "复合索引的分组值，每个分组列给一次，如 --group zone=3"
msgstr "複合インデックスのグループ値。各グループ列につき 1 回指定します。例: --group zone=3"

#: hetu/cli/init.py:325
msgid "❌ 未找到 uv 命令，请先安装 uv：https://docs.astral.sh/uv/"
msgstr "❌ uv コマンドが見つかりません。先に uv をインストールしてください: https://docs.astral.sh/uv/"

#: hetu/cli/init.py:329
#, python-brace-format
