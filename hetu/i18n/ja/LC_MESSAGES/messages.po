"redis/rediss/valkey/valkeys/postgres/postgresql/sqlite/mysql/mariadb です"

#: hetu/cli/start.py:91
msgid "启动河图服务"
msgstr "河図サービスを起動"

#: hetu/cli/start.py:93
msgid "通过命令行启动参数"
msgstr "コマンドライン起動引数による"

#: hetu/cli/start.py:109
