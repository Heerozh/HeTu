#: hetu/endpoint/executor.py:171
#, python-brace-format
msgid "🔜 [📞Endpoint] 调用Endpoint: {ep_name}{args}"
msgstr "🔜 [📞Endpoint] Rufe Endpoint auf: {ep_name}{args}"

