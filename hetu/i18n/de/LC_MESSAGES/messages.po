msgstr ""
"❌ [💾SQLite] Polling der Benachrichtigungstabelle fehlgeschlagen, erneuter "
"Versuch in {backoff}s"

#: hetu/data/backend/sqlite/mq.py:244
#, python-brace-format
msgid "❌ [💾SQLite] 轮询通知表连续失败 {count} 次，{backoff}s 后重试：{err}"
msgstr ""
"❌ [💾SQLite] Polling der Benachrichtigungstabelle {count} Mal in Folge "
"fehlgeschlagen, erneuter Versuch in {backoff}s: {err}"

#: hetu/data/backend/sqlite/mq.py:255
#, python-brace-format
msgid "✅ [💾SQLite] 轮询通知表恢复，期间失败 {count} 次"
msgstr ""
"✅ [💾SQLite] Polling der Benachrichtigungstabelle wiederhergestellt, {count} "
"Fehlschläge währenddessen"

#: hetu/data/backend/sqlite/store.py:64
#, python-brace-format
