#, python-brace-format
msgid "连接Redis数据库 {url} 时服务端返回错误：{error}"
msgstr ""
"Beim Verbinden mit der Redis-Datenbank {url} hat der Server einen Fehler "
"zurückgegeben: {error}"

#: hetu/data/backend/redis/client.py:338
#, python-brace-format
msgid ""
"⚠️ [💾Redis] 无权限调用数据库{url}的config_set命令，数据订阅将不起效。可手动设置配置文件：notify-keyspace-"
"events={keyspace}"
msgstr ""
"⚠️ [💾Redis] Keine Berechtigung zum Aufruf des config_set-Befehls für "
"Datenbank {url}, Datenabonnements werden nicht funktionieren. Konfiguration "
"kann manuell gesetzt werden: notify-keyspace-events={keyspace}"

#: hetu/data/backend/redis/client.py:366
msgid "is_synced只能在master上调用"
msgstr "is_synced kann nur auf dem Master aufgerufen werden"

