"beginnt"

#: hetu/data/backend/sqlite/store.py:403 hetu/data/backend/sqlite/store.py:424
#, python-brace-format
msgid "HSET 至少要给一个字段：{key}"
msgstr "HSET erfordert mindestens ein Feld: {key}"

#: hetu/endpoint/connection.py:75 hetu/endpoint/connection.py:113
#: hetu/endpoint/connection.py:146
