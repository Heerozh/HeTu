msgstr "Unbekannte Konfigurationsoptionen für das SQLite-Backend: {names}"

#: hetu/data/backend/sqlite/client.py:115
#, python-brace-format
msgid "无法打开SQLite库文件：{path}（{err}）"
msgstr "Die SQLite-Datenbankdatei kann nicht geöffnet werden: {path} ({err})"

