msgstr ""
"[❄️ID] Snowflake-ID-Generator initialisiert, Worker ID: {worker_id}, "
"last_timestamp: {ts}"

#: hetu/common/snowflake_id.py:170
#, python-brace-format
msgid ""
"[❄️ID] Worker ID {worker_id} 的租约已超出安全期 {overdue:.1f} "
"秒，拒绝发号以防产生重复ID。通常意味着本进程长时间卡住或后端连不上，Worker 会在下一次续约时重启"
msgstr ""
"[❄️ID] Die Lease von Worker ID {worker_id} hat den sicheren Zeitraum um "
"{overdue:.1f} Sekunden überschritten; ID-Vergabe wird abgelehnt, um doppelte"
" IDs zu vermeiden. Dies bedeutet normalerweise, dass dieser Prozess lange "
"blockiert ist oder das Backend nicht erreichbar ist; der Worker wird bei der"
" nächsten Lease-Erneuerung neu gestartet."

#: hetu/common/snowflake_id.py:181
msgid "SnowflakeID 未初始化，请先调用 init() 方法。"
msgstr ""
"SnowflakeID nicht initialisiert, bitte zuerst die init()-Methode aufrufen."

#: hetu/common/snowflake_id.py:191
#, python-brace-format
msgid "[❄️ID] 时钟回拨了 {ms} 毫秒。"
msgstr "[❄️ID] Uhr wurde um {ms} Millisekunden zurückgestellt."

#: hetu/common/snowflake_id.py:226 hetu/common/snowflake_id.py:242
msgid "[❄️ID] 每毫秒只能生成有限的ID，需要休眠 1 ms"
msgstr ""
"[❄️ID] Pro Millisekunde können nur begrenzte IDs generiert werden, muss 1 ms"
" warten"

#: hetu/common/yamlloader.py:66
#, python-brace-format, python-format
msgid "环境变量 ${%s} 未设置且无默认值，如需空值请用 ${%s:-}"
msgstr ""
"Umgebungsvariable ${%s} ist nicht gesetzt und hat keinen Standardwert. Wenn "
"ein leerer Wert gewünscht ist, verwenden Sie ${%s:-}."

#: hetu/data/component.py:417
#, python-brace-format
msgid "{cname}.{pname}不是字符串属性（dtype={d}）"
msgstr "{cname}.{pname} ist keine String-Eigenschaft (dtype={d})"

#: hetu/data/component.py:501
msgid "Component重复定义"
msgstr "Doppelte Definition der Komponente"

#: hetu/data/component.py:634
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是Python关键字。"
msgstr ""
"{cname}.{fname}-Eigenschaftsdefinition fehlerhaft, Eigenschaftsname darf "
"kein Python-Schlüsselwort sein."

#: hetu/data/component.py:640
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是C#关键字。"
msgstr ""
"{cname}.{fname}-Eigenschaftsdefinition fehlerhaft, Eigenschaftsname darf "
"kein C#-Schlüsselwort sein."

#: hetu/data/component.py:648
#, python-brace-format
msgid ""
"{cname}.{fname}属性定义出错，属性名不能和numpy行数据的属性同名，否则row.{fname}读到的是numpy的属性而不是字段值，请换个名字。"
msgstr ""
"Fehler bei der Definition der Eigenschaft {cname}.{fname}: Der "
"Eigenschaftsname darf nicht mit einer Eigenschaft der numpy-Zeilendaten "
"übereinstimmen, sonst liest row.{fname} die numpy-Eigenschaft statt des "
"Feldwerts. Bitte wählen Sie einen anderen Namen."

#: hetu/data/component.py:654
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不能为0长度。str类型请用'<U8'方式定义"
msgstr ""
"Der dtype der Eigenschaft {cname}.{fname} darf nicht die Länge 0 haben. Für "
"str-Typ bitte mit '<U8' definieren."

#: hetu/data/component.py:657
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不支持void类型"
msgstr ""
"Der dtype der Eigenschaft {cname}.{fname} unterstützt den void-Typ nicht."

#: hetu/data/component.py:668
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为unique时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Wenn die Eigenschaft {cname}.{fname} auf unique gesetzt ist, "
"darf index nicht auf False gesetzt werden."

#: hetu/data/component.py:678
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了groupby（复合索引），point_sub用不上已忽略：按组订阅本来就只被本组的写入叫醒。"
msgstr ""
"⚠️ [🛠️Define] Für die Eigenschaft {cname}.{fname} ist groupby "
"(zusammengesetzter Index) gesetzt; point_sub wird nicht verwendet und "
"ignoriert: Abonnements nach Gruppe werden ohnehin nur durch Schreibvorgänge "
"der eigenen Gruppe geweckt."

#: hetu/data/component.py:690
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了commit_seq，point_sub用不上已忽略：号要到提交时才有，发不出值频道。"
msgstr ""
"⚠️ [🛠️Define] Für die Eigenschaft {cname}.{fname} ist commit_seq gesetzt; "
"point_sub wird nicht verwendet und ignoriert: Die Nummer entsteht erst beim "
"Commit, daher kann kein Wert-Kanal ausgesendet werden."

#: hetu/data/component.py:698
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了commit_seq时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Wenn für die Eigenschaft {cname}.{fname} commit_seq gesetzt "
"ist, darf index nicht auf False gesetzt werden."

#: hetu/data/component.py:707
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为point_sub时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Wenn die Eigenschaft {cname}.{fname} auf point_sub gesetzt "
"ist, darf index nicht auf False gesetzt werden."

#: hetu/data/component.py:716
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了groupby时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Wenn für die Eigenschaft {cname}.{fname} groupby gesetzt ist, "
"darf index nicht auf False gesetzt werden."

#: hetu/data/component.py:725
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，hidden属性不能同时设置point_sub：客户端不能按hidden属性订阅。"
msgstr ""
"Fehler bei der Definition der Eigenschaft {cname}.{fname}: Bei der hidden-"
"Eigenschaft kann point_sub nicht gleichzeitig gesetzt werden: Clients können"
" nicht nach der hidden-Eigenschaft abonnieren."

#: hetu/data/component.py:731
#, python-brace-format
msgid ""
"{cname}.{fname}默认值不能为None。所有属性都要有默认值，因为数据接口统一用c like "
"struct实现，强类型struct不接受NULL/None值。"
msgstr ""
"Der Standardwert für {cname}.{fname} darf nicht None sein. Alle "
"Eigenschaften müssen einen Standardwert haben, da die Datenschnittstelle "
"einheitlich als C-ähnliches Struct implementiert ist. Stark typisierte "
"Structs akzeptieren keine NULL/None-Werte."

#: hetu/data/component.py:742
#, python-brace-format
msgid ""
"{cname}.{fname}的default值：{default_type}({default_value})和属性dtype({dtype})不匹配"
msgstr ""
"Der Standardwert für {cname}.{fname}: {default_type}({default_value}) stimmt"
" nicht mit dem Eigenschafts-dtype({dtype}) überein."

#: hetu/data/component.py:756
#, python-brace-format
msgid "{cname}权限为OWNER时，不能设置rls_compare参数"
msgstr ""
"Wenn die Berechtigung für {cname} OWNER ist, darf der rls_compare-Parameter "
"nicht gesetzt werden."

#: hetu/data/component.py:759
#, python-brace-format
msgid "{cname}权限为OWNER时，必须有owner属性"
msgstr ""
"Wenn die Berechtigung für {cname} OWNER ist, muss eine owner-Eigenschaft "
"vorhanden sein."

#: hetu/data/component.py:766
#, python-brace-format
msgid "{cname}的owner属性必需是numeric数字(int, np.int64, ...)类型"
msgstr ""
"Die owner-Eigenschaft von {cname} muss vom numerischen Typ (int, np.int64, "
"...) sein."

#: hetu/data/component.py:772
#, python-brace-format
msgid "{cname}权限为RLS时，必须通过rls_compare参数定义行级权限逻辑"
msgstr ""
"Wenn die Berechtigung für {cname} RLS ist, muss die Zeilenebenen-"
"Berechtigungslogik über den rls_compare-Parameter definiert werden."

#: hetu/data/component.py:775
#, python-brace-format
msgid "{cname}.rls_compare参数必须全部是字符串类型"
msgstr "Alle rls_compare-Parameter von {cname} müssen vom Typ String sein."

#: hetu/data/component.py:778
#, python-brace-format
msgid "{cname}.rls_compare参数必须只有3个元素)"
msgstr "Der rls_compare-Parameter von {cname} muss genau 3 Elemente haben."

#: hetu/data/component.py:782
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但operator模块没有{method}方法"
msgstr ""
"Berechtigung für {cname} ist RLS: {rls_compare}, aber das operator-Modul hat"
" keine Methode {method}."

#: hetu/data/component.py:786
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但表没有定义{prop}属性"
msgstr ""
"Berechtigung für {cname} ist RLS: {rls_compare}, aber die Tabelle hat keine "
"Eigenschaft {prop} definiert."

#: hetu/data/component.py:803
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列必须是本组件的字段名，不能是id、_version：{col!r}"
msgstr ""
"Fehler bei der groupby-Definition von {cname}.{fname}: Gruppenspalten müssen"
" Feldnamen dieser Komponente sein und dürfen nicht id oder _version sein: "
"{col!r}"

#: hetu/data/component.py:809
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，不能按自己分组"
msgstr ""
"Fehler bei der groupby-Definition von {cname}.{fname}: Eine Gruppierung nach"
" der Eigenschaft selbst ist nicht möglich"

#: hetu/data/component.py:816
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，组件没有字段`{col}`"
msgstr ""
"Fehler bei der groupby-Definition von {cname}.{fname}: Die Komponente hat "
"kein Feld `{col}`"

#: hetu/data/component.py:822
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列`{col}`重复了"
msgstr ""
"Fehler bei der groupby-Definition von {cname}.{fname}: Die Gruppenspalte "
"`{col}` ist doppelt angegeben"

#: hetu/data/component.py:830
#, python-brace-format
msgid ""
"{cname}.{fname}的groupby定义出错，分组列`{col}`只能是整数、str、bytes类型，不能是{dtype}：浮点按等值分组没有意义，NaN、-0.0"
" 的相等也说不清"
msgstr ""
"Fehler bei der groupby-Definition von {cname}.{fname}: Die Gruppenspalte "
"`{col}` darf nur vom Typ Integer, str oder bytes sein, nicht {dtype}: Eine "
"Gruppierung von Gleitkommazahlen nach Gleichheit ist sinnlos, und die "
"Gleichheit von NaN und -0.0 ist nicht eindeutig definiert"

#: hetu/data/component.py:842
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，{dtype}类型不能建索引"
msgstr ""
"Fehler bei der Definition der Eigenschaft {cname}.{fname}: Für den Typ "
"{dtype} kann kein Index erstellt werden"

#: hetu/data/component.py:855
#, python-brace-format
msgid "{cname}定义出错，最多只能有一个commit_seq字段：{fields}"
msgstr ""
"Fehler bei der Definition von {cname}: Es darf höchstens ein commit_seq-Feld"
" geben: {fields}"

#: hetu/data/component.py:866
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的类型只能是np.int64，不能是{dtype}"
msgstr ""
"Fehler bei der Definition der Eigenschaft {cname}.{fname}: Der Typ von "
"commit_seq darf nur np.int64 sein, nicht {dtype}"

#: hetu/data/component.py:875
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的default必须是0：0表示还没发号，号从1开始"
msgstr ""
"Fehler bei der Definition der Eigenschaft {cname}.{fname}: Der Standardwert "
"von commit_seq muss 0 sein: 0 bedeutet, dass noch keine Nummer vergeben "
"wurde; die Nummerierung beginnt bei 1"

#: hetu/data/component.py:884
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq不能同时设置unique：组内唯一由发号保证"
msgstr ""
"Fehler bei der Definition der Eigenschaft {cname}.{fname}: commit_seq darf "
"nicht gleichzeitig unique gesetzt werden: Die Eindeutigkeit innerhalb der "
"Gruppe wird durch die Nummervergabe gewährleistet"

#: hetu/data/component.py:894
#, python-brace-format
msgid "{cname}.{other}的groupby定义出错，commit_seq字段`{fname}`不能当分组列：它的号要到提交时才有"
msgstr ""
"Fehler bei der groupby-Definition von {cname}.{other}: Das commit_seq-Feld "
"`{fname}` kann nicht als Gruppenspalte dienen: Seine Nummer entsteht erst "
"beim Commit"

#: hetu/data/component.py:912
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq字段不能用作行级权限的判定列"
msgstr ""
"Fehler bei der Definition der Eigenschaft {cname}.{fname}: Ein commit_seq-"
"Feld kann nicht als Bestimmungsspalte für zeilenbasierte Berechtigungen "
"(RLS) verwendet werden"

#: hetu/data/component.py:921
#, python-brace-format
msgid "组件名({name})是C#关键字，请refactor。"
msgstr ""
"Der Komponentenname ({name}) ist ein C#-Schlüsselwort, bitte "
"refaktorisieren."

#: hetu/data/component.py:934
#, python-brace-format
msgid "{cls_name}.{name}不是Property类型"
msgstr "{cls_name}.{name} ist nicht vom Typ Property."

#: hetu/data/component.py:944
#, python-brace-format
msgid ""
"{cls_name}.{name}属性未定义type hint。请使用以下形式，{name}: type = property_field(...)"
msgstr ""
"Die Eigenschaft {cls_name}.{name} hat keinen Type-Hint definiert. Bitte "
"verwenden Sie die Form: {name}: type = property_field(...)"

#: hetu/data/component.py:949
#, python-brace-format
msgid "{cls_name}至少要有1个Property成员"
msgstr "{cls_name} muss mindestens 1 Property-Mitglied haben."

#: hetu/data/component.py:957
#, python-brace-format
msgid "{cls_name}.id是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}.id ist ein reservierter, interner Primärschlüssel und kann extern"
" nicht neu definiert werden."

#: hetu/data/component.py:960
#, python-brace-format
msgid "{cls_name}._version是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}._version ist ein reservierter, interner Primärschlüssel und kann "
"extern nicht neu definiert werden."

#: hetu/data/component.py:969
#, python-brace-format
msgid "{cls_name}必须继承于BaseComponent"
msgstr "{cls_name} muss von BaseComponent erben."

#: hetu/data/component.py:977
#, python-brace-format
msgid "{cls_name}权限定义出错，Component不能用GM权限：GM只用于System/Endpoint的调用权限"
msgstr ""
"Fehler bei der Berechtigungsdefinition von {cls_name}: Component kann keine "
"GM-Berechtigung verwenden: GM gilt nur für die Aufrufberechtigungen von "
"System/Endpoint"

#: hetu/data/migration.py:39
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 发现自定义迁移脚本 {file}，将调用脚本进行迁移..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Benutzerdefiniertes Migrationsskript"
" {file} gefunden, Skript wird zur Migration aufgerufen..."

#: hetu/data/migration.py:92
#, python-brace-format
msgid ""
"  ➖ [💾MIGRATION][{comp_name}组件] 缺少迁移脚本，生成默认迁移脚本 "
"{script_path}，请根据需要修改脚本内容后再执行迁移操作..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Migrationsskript fehlt, generiere "
"Standard-Migrationsskript {script_path}, bitte passen Sie den Skriptinhalt "
"nach Bedarf an, bevor Sie die Migration durchführen..."

#: hetu/data/migration.py:212
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 执行upgrade迁移：{module}"
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Upgrade-Migration wird ausgeführt: "
"{module}"

#: hetu/data/migration.py:218
#, python-brace-format
msgid "  ✔️ [💾MIGRATION][{comp_name}组件] Schema升级迁移完成，共处理{count}行"
msgstr ""
"  ✔️ [💾MIGRATION][{comp_name} Component] Schema-Upgrade-Migration "
"abgeschlossen, {count} Zeilen verarbeitet"

#: hetu/data/migration.py:230
#, python-brace-format
msgid ""
"[💾MIGRATION][{comp_name}组件] "
"数据已经按新定义搬完，但重建索引失败：{error}。在修好之前服务器会拒绝启动：请直接修改表里的数据（比如用 TableMaintenance 的 "
"upsert_row 给重复的号重新编号），再跑一次 hetu upgrade，它会按当前定义直接重建索引"
msgstr ""
"[💾MIGRATION][{comp_name} Component] Die Daten wurden bereits gemäß der neuen"
" Definition migriert, aber das Neuerstellen des Index ist fehlgeschlagen: "
"{error}. Bis dies behoben ist, verweigert der Server den Start: Bitte ändern"
" Sie die Daten in der Tabelle direkt (z. B. mit upsert_row von "
"TableMaintenance, um doppelten Nummern neue Nummern zuzuweisen) und führen "
"Sie anschließend erneut hetu upgrade aus; dabei wird der Index gemäß der "
"aktuellen Definition direkt neu erstellt"

#: hetu/data/migration.py:237
