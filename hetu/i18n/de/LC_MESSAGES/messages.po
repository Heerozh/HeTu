msgstr ""
"Nachrichtenwarteschlangen können nur an Verbindungen desselben Backend-Typs "
"angehängt werden"

#: hetu/data/backend/redis/mq.py:110
#, python-brace-format
msgid "⚠️ [💾Redis] 取消订阅 {count} 个频道失败：{err}"
msgstr "⚠️ [💾Redis] Abbestellen von {count} Kanälen fehlgeschlagen: {err}"

