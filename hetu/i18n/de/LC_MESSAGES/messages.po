#: hetu/data/backend/sqlite/mq.py:196
#, python-brace-format
msgid "🔔 [💾SQLite] 收到订阅更新通知: {channel_name}"
msgstr ""
"🔔 [💾SQLite] Aktualisierungsbenachrichtigung für Abonnement empfangen: "
"{channel_name}"

#: hetu/data/backend/sqlite/mq.py:213
#, python-brace-format
msgid "⚠️ [💾SQLite] 订阅更新通知来不及处理，丢弃了{seconds}秒前的消息共{count}条"
msgstr ""
"⚠️ [💾SQLite] Aktualisierungsbenachrichtigungen für Abonnements konnten nicht"
