#: hetu/headless.py:83
#, python-brace-format
msgid ""
"实例 {instance} 里不存在组件表 {comp_name}：请先启动 HeTu 服务器建表（或检查 instance / 组件名 / "
"后端配置是否指向同一个数据库）"
msgstr ""
"In Instanz {instance} existiert keine Component-Tabelle {comp_name}: Bitte "
"zuerst den HeTu-Server starten, um die Tabelle zu erstellen (oder prüfen, ob"
" instance / Component-Name / Backend-Konfiguration auf dieselbe Datenbank "
"zeigen)."

#: hetu/headless.py:102
#, python-brace-format
msgid "组件 {comp_name} 的本地定义与服务器表结构不一致（服务器 -> 本地）：{diff}"
msgstr ""
"Die lokale Definition von Component {comp_name} stimmt nicht mit der Server-"
"Tabellenstruktur überein (Server -> Lokal): {diff}"

#: hetu/headless.py:119
#, python-brace-format
msgid ""
"组件 {comp_name} 的 cluster_id 已由 {old_id} 变为 {new_id}（服务器已迁簇），请重新 connect"
msgstr ""
"Die cluster_id von Component {comp_name} hat sich von {old_id} zu {new_id} "
"geändert (der Server hat den Cluster gewechselt), bitte connect erneut "
"aufrufen."

#: hetu/headless.py:248
#, python-brace-format
msgid ""
"组件 {name} 未在本事务声明（或不是 connect 时认下的那个类），请在 client.session(...) "
"里加上；已声明：{declared}"
msgstr ""
"Component {name} wurde in dieser Transaktion nicht deklariert (oder ist "
"nicht die beim connect erkannte Klasse). Bitte in client.session(...) "
"hinzufügen; deklariert: {declared}"

#: hetu/headless.py:295 hetu/headless.py:316
#, python-brace-format
msgid "组件 {name} 重复声明"
msgstr "Component {name} ist doppelt deklariert."

#: hetu/headless.py:309
msgid "components 不能为空：至少声明一个组件"
msgstr ""
"components darf nicht leer sein: Mindestens eine Component muss deklariert "
"werden."

#: hetu/headless.py:330
#, python-brace-format
msgid "⚠️ [🧩Headless] 组件 {name} 的默认值与服务器不同（只影响本进程 new_row 的填充值）：{diff}"
msgstr ""
"⚠️ [🧩Headless] Der Standardwert von Component {name} unterscheidet sich vom "
"Server (betrifft nur den Füllwert von new_row in diesem Prozess): {diff}"

#: hetu/headless.py:337
#, python-brace-format
msgid "[🧩Headless] 实例 {instance} 组件表 {name} → cluster {cid}"
msgstr ""
"[🧩Headless] Instanz {instance} Component-Tabelle {name} → Cluster {cid}"

#: hetu/headless.py:370
#, python-brace-format
msgid "组件 {name} 未在 connect(components=...) 里声明；已声明：{declared}"
msgstr ""
"Component {name} wurde nicht in connect(components=...) deklariert; "
"deklariert: {declared}"

#: hetu/headless.py:376
#, python-brace-format
msgid ""
"组件 {name} 是按名字声明的，其类来自服务器 meta，请用 client.table('{name}').comp_cls 而不是本地类"
msgstr ""
"Component {name} wurde über den Namen deklariert; ihre Klasse stammt aus der"
" Server-Meta. Bitte client.table('{name}').comp_cls statt der lokalen Klasse"
" verwenden."

#: hetu/headless.py:394
msgid "session() 至少要声明一个组件"
msgstr "In session() muss mindestens eine Component deklariert werden."

#: hetu/headless.py:401
#, python-brace-format
msgid "同一事务的组件必须同簇（簇由服务器 System 的引用关系决定，跨簇请拆成两个事务）：{detail}"
msgstr ""
"Components derselben Transaktion müssen im selben Cluster liegen (der "
"Cluster wird durch die Referenzbeziehungen des Server-Systems bestimmt; bei "
"clusterübergreifenden Fällen bitte in zwei Transaktionen aufteilen): "
"{detail}"

#: hetu/local.py:86
msgid "库里没有这张表：先用当前代码启动一次服务器（会建新表）"
msgstr ""
"Die Tabelle existiert nicht in der Datenbank: Starte zuerst den Server "
"einmal mit dem aktuellen Code (dabei werden neue Tabellen angelegt)"

#: hetu/local.py:89
msgid "本地代码与库里的表结构 / 簇不一致：先 hetu upgrade，或用与线上一致的代码版本运行"
msgstr ""
"Der lokale Code stimmt nicht mit dem Tabellenschema / Cluster in der "
"Datenbank überein: Führe zuerst hetu upgrade aus oder verwende eine "
"Codeversion, die mit der Produktion übereinstimmt"

#: hetu/local.py:93
#, python-brace-format
msgid "组件 {comp_name} 的表状态为 {status}，{hint}"
msgstr "Die Tabelle des Component {comp_name} hat den Status {status}, {hint}"

#: hetu/local.py:117
#, python-brace-format
msgid ""
"System {system} 是 USER 权限：生产里只有已登录连接能调，请指定玩家 id（hetu call 用 --as <uid>，代码里传 "
"caller=）"
msgstr ""
"System {system} hat USER-Berechtigung: In der Produktion kann es nur von "
"angemeldeten Verbindungen aufgerufen werden, bitte gib die Spieler-id an "
"(bei hetu call --as <uid> verwenden, im Code caller= übergeben)"

#: hetu/cli/build.py:46 hetu/local.py:128
#, python-brace-format
msgid "无法加载app文件 {app_file}"
msgstr "App-Datei {app_file} kann nicht geladen werden"

#: hetu/local.py:376
#, python-brace-format
msgid "找不到 Component：{comp}（是否在 components 中引用过？）"
msgstr ""
"Component nicht gefunden: {comp} (Wurde es in components referenziert?)"

#: hetu/local.py:397
#, python-brace-format
msgid "{comp} 中不存在匹配 {query} 的行"
msgstr "In {comp} gibt es keine Zeile, die {query} entspricht"

#: hetu/local.py:443
#, python-brace-format
msgid "{comp} 组件没有叫 {name} 的字段"
msgstr "Das Component {comp} hat kein Feld namens {name}"

#: hetu/local.py:448
msgid "_version 由引擎管理，insert 时不能设置"
msgstr ""
"_version wird von der Engine verwaltet und kann beim insert nicht gesetzt "
"werden"

#: hetu/local.py:509
#, python-brace-format
msgid "库文件不存在：{path}（服务器还没在这个库上启动过，或配置路径不对）"
msgstr ""
"Datenbankdatei existiert nicht: {path} (der Server wurde noch nie mit dieser"
" Datenbank gestartet oder der konfigurierte Pfad ist falsch)"

#: hetu/cli/base.py:238 hetu/local.py:562
#, python-brace-format
msgid "实例 {instance} 不在配置的 INSTANCES 里：{instances}"
msgstr ""
"Instanz {instance} ist nicht in den konfigurierten INSTANCES enthalten: "
"{instances}"

#: hetu/manager.py:57
#, python-brace-format
msgid "Backend {backend}未找到"
msgstr "Backend {backend} nicht gefunden"

#: hetu/manager.py:104
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表结构需要迁移Schema。"
msgstr ""
"⚠️  Die Tabellenstruktur der Komponente {comp_name} benötigt eine Schema-"
"Migration."

#: hetu/manager.py:111
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表需要迁移到新集群。"
msgstr ""
"⚠️  Die Tabelle der Komponente {comp_name} muss zum neuen Cluster migriert "
"werden."

#: hetu/webext.py:91
#, python-brace-format
msgid "define_route的uri必须以'/'开头，你的：{uri}"
msgstr "Die uri von define_route muss mit '/' beginnen; deine: {uri}"

#: hetu/webext.py:96
#, python-brace-format
msgid "define_route的uri不能占用HeTu保留的'{prefix}'路径（客户端SDK的WebSocket入口），你的：{uri}"
msgstr ""
"Die uri von define_route darf nicht den von HeTu reservierten Pfad "
"'{prefix}' (WebSocket-Endpunkt des Client-SDK) belegen; deine: {uri}"

#: hetu/cli/__init__.py:70
msgid "河图数据库"
msgstr "Hetu-Datenbank"

#: hetu/cli/__init__.py:75
msgid "执行操作"
msgstr "Aktion ausführen"

#: hetu/cli/__init__.py:103
#, python-brace-format
msgid "无法识别的参数：{extras}"
msgstr "Unbekannte Argumente: {extras}"

#: hetu/cli/base.py:46
msgid "Boolean value expected."
msgstr "Boolescher Wert erwartet."

#: hetu/cli/base.py:69
#, python-brace-format
msgid ""
"SQL 后端已移除，PostgreSQL / MariaDB 不再支持：'{scheme}'。开发用 sqlite:///<库文件路径>，生产用 "
"Redis"
msgstr ""
"SQL-Backend wurde entfernt, PostgreSQL / MariaDB werden nicht mehr "
"unterstützt: '{scheme}'. Für die Entwicklung sqlite:///<Pfad zur "
"Datenbankdatei> verwenden, für die Produktion Redis"

#: hetu/cli/base.py:77
#, python-brace-format
msgid "不支持的数据库URL scheme: '{scheme}'。目前支持 redis/rediss/valkey/valkeys/sqlite"
msgstr ""
"Nicht unterstütztes Datenbank-URL-Schema: '{scheme}'. Derzeit unterstützt "
"werden redis/rediss/valkey/valkeys/sqlite"

#: hetu/cli/base.py:106
#, python-brace-format
msgid "⚠️ SQLite 库文件的相对路径现在按配置文件所在目录解析：{new}。旧位置（相对当前目录）{old} 有库文件，如需沿用请把它挪过去"
msgstr ""
"⚠️ Der relative Pfad der SQLite-Datenbankdatei wird jetzt relativ zum "
"Verzeichnis der Konfigurationsdatei aufgelöst: {new}. Am alten Ort (relativ "
"zum aktuellen Verzeichnis) {old} befindet sich eine Datenbankdatei; wenn Sie"
" sie weiterverwenden möchten, verschieben Sie sie dorthin"

#: hetu/cli/base.py:125
#, python-brace-format
msgid "读不了配置文件 {path}：{err}"
msgstr "Konfigurationsdatei {path} kann nicht gelesen werden: {err}"

#: hetu/cli/base.py:128
#, python-brace-format
msgid "配置文件 {path} 不是一个映射"
msgstr "Konfigurationsdatei {path} ist kein Mapping"

#: hetu/cli/base.py:192
#, python-brace-format
msgid "命令行参数模式缺少：{missing}（或改用 --config）"
msgstr ""
"Im Kommandozeilenargument-Modus fehlt: {missing} (oder verwenden Sie "
"--config)"

#: hetu/cli/base.py:223
msgid ""
"找不到配置：用 --config 指定，或设环境变量 HETU_CONFIG，或在当前目录放 config.yml；也可以用 --app-file / "
"--namespace / --instance / --db 直接给出"
msgstr ""
"Keine Konfiguration gefunden: Geben Sie sie mit --config an, setzen Sie die "
"Umgebungsvariable HETU_CONFIG oder legen Sie config.yml im aktuellen "
"Verzeichnis ab; alternativ können Sie sie direkt mit --app-file / "
"--namespace / --instance / --db angeben"

#: hetu/cli/base.py:233
msgid "配置里没有 INSTANCES"
msgstr "In der Konfiguration fehlt INSTANCES"

#: hetu/cli/base.py:247
msgid "配置"
msgstr "Konfiguration"

#: hetu/cli/base.py:251
msgid "配置文件；不给时依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Konfigurationsdatei; wenn nicht angegeben, wird nacheinander die "
"Umgebungsvariable HETU_CONFIG und config.yml im aktuellen Verzeichnis "
"gesucht"

#: hetu/cli/base.py:256
msgid "实例名，默认取配置里 INSTANCES 的第一个"
msgstr ""
"Instanzname, standardmäßig der erste Eintrag von INSTANCES in der "
"Konfiguration"

#: hetu/cli/base.py:259
msgid "（无配置文件时）河图app的py文件"
msgstr "(ohne Konfigurationsdatei) die py-Datei der Hetu-App"

#: hetu/cli/base.py:262
msgid "（无配置文件时）app的namespace"
msgstr "(ohne Konfigurationsdatei) der Namespace der App"

#: hetu/cli/base.py:267
msgid "（无配置文件时）后端数据库地址"
msgstr "(ohne Konfigurationsdatei) die Adresse der Backend-Datenbank"

#: hetu/cli/build.py:22
msgid "生成客户端SDK C# 类型代码"
msgstr "C#-Typencode für Client-SDK generieren"

#: hetu/cli/build.py:26
msgid "河图app的py文件"
msgstr "Py-Datei der Hetu-App"

#: hetu/cli/build.py:33
msgid "编译app.py中哪个namespace下的数据类型"
msgstr "Unter welchem Namespace in app.py Datentypen kompilieren"

#: hetu/cli/build.py:37
msgid "输出文件路径"
msgstr "Ausgabedateipfad"

#: hetu/cli/build.py:59
#, python-brace-format
msgid "✅ 已生成C#代码到 {output}"
msgstr "✅ C#-Code wurde nach {output} generiert"

#: hetu/cli/call.py:85
#, python-brace-format
msgid ""
"第 {n} 个参数看起来是 JSON 但解析失败（PowerShell 可能吃掉了引号），改用 --args-file 或 stdin：{raw}"
msgstr ""
"Das {n}. Argument sieht nach JSON aus, konnte aber nicht geparst werden "
"(PowerShell hat möglicherweise die Anführungszeichen verschluckt). Verwende "
"stattdessen --args-file oder stdin: {raw}"

#: hetu/cli/call.py:104
#, python-brace-format
msgid "--args-file 读不了或不是合法 JSON：{err}"
msgstr ""
"--args-file konnte nicht gelesen werden oder ist kein gültiges JSON: {err}"

#: hetu/cli/call.py:107
msgid "--args-file 的内容必须是 JSON 数组"
msgstr "Der Inhalt von --args-file muss ein JSON-Array sein"

#: hetu/cli/call.py:122
#, python-brace-format
msgid "--user-data 读不了或不是合法 JSON：{err}"
msgstr ""
"--user-data konnte nicht gelesen werden oder ist kein gültiges JSON: {err}"

#: hetu/cli/call.py:125
msgid "--user-data 必须是 JSON 对象"
msgstr "--user-data muss ein JSON-Objekt sein"

#: hetu/cli/call.py:135
#, python-brace-format
msgid "System {name} 要 {low}-{high} 个参数，给了 {n} 个"
msgstr "System {name} erwartet {low}-{high} Argumente, angegeben: {n}"

#: hetu/cli/call.py:162
#, python-brace-format
msgid "，相近的有：{close}"
msgstr ", ähnlich sind: {close}"

#: hetu/cli/call.py:164
#, python-brace-format
msgid "不存在的 System：{name}{hint}（hetu call --list 查看全部）"
msgstr ""
"System existiert nicht: {name}{hint} (alle mit hetu call --list anzeigen)"

#: hetu/cli/call.py:293
#, python-brace-format
msgid ""
"System {name} 超过 {timeout} 秒没结束，已中止。若超时发生在提交途中，提交可能已经生效：writes 里 committed 为"
" unknown 的那次，请直接查数据确认"
msgstr ""
"System {name} wurde nach mehr als {timeout} Sekunden nicht beendet und "
"abgebrochen. Wenn die Zeitüberschreitung während des Commits auftrat, kann "
"der Commit bereits wirksam geworden sein: Prüfe bei dem Eintrag in writes, "
"bei dem committed unknown ist, die Daten direkt, um es zu bestätigen"

#: hetu/cli/call.py:303
#, python-brace-format
msgid "System 留下 {n} 个后台任务，CLI 退出时已取消（在服务器里它们会继续跑）"
msgstr ""
"System hat {n} Hintergrundaufgaben hinterlassen; beim Beenden der CLI wurden"
" sie abgebrochen (auf dem Server laufen sie weiter)"

#: hetu/cli/call.py:333
msgid "--args-file 与位置参数不能同时给"
msgstr ""
"--args-file und Positionsargumente dürfen nicht gleichzeitig angegeben "
"werden"

#: hetu/cli/call.py:348
#, python-brace-format
msgid "生产端点不会放行这个身份（caller={caller}，group={group}）调用 {permission} 权限的 System"
msgstr ""
"Der Produktionsendpunkt erlaubt dieser Identität (caller={caller}, "
"group={group}) nicht, ein System mit der Berechtigung {permission} "
"aufzurufen"

#: hetu/cli/call.py:359
#, python-brace-format
msgid "System {name} 读了 ctx.caller，而当前 caller 是推断出来的 0；要以玩家身份跑请用 --as <uid>"
msgstr ""
"System {name} hat ctx.caller gelesen, aber der aktuelle caller ist der "
"abgeleitete Wert 0; um es als Spieler auszuführen, verwende --as <uid>"

#: hetu/cli/call.py:441
msgid ""
"在本进程里直连后端调用一个 System（不经服务器），stdout 输出一行 JSON。调试用：写入与 System "
"走同一条提交路径，在线客户端照常收到推送"
msgstr ""
"Ein System direkt in diesem Prozess gegen das Backend aufrufen (ohne "
"Server); stdout gibt eine Zeile JSON aus. Zum Debuggen: Schreibvorgänge "
"nehmen denselben Commit-Pfad wie das System, und Online-Clients erhalten die"
" Push-Benachrichtigungen wie gewohnt"

#: hetu/cli/call.py:449
msgid "列出全部 System（参数、权限、引用的组件、文档第一行），不连数据库"
msgstr ""
"Alle Systeme auflisten (Argumente, Berechtigungen, referenzierte Components,"
" erste Zeile der Dokumentation), ohne Verbindung zur Datenbank"

#: hetu/cli/call.py:451
msgid "身份"
msgstr "Identität"

#: hetu/cli/call.py:458
msgid ""
"以这个玩家 id 调用（ctx.caller）。USER 权限的 System 必须给；不给时按权限推断：ADMIN/GM/内部 System 用 "
"admin，EVERYBODY 用 guest"
msgstr ""
"Mit dieser Spieler-ID aufrufen (ctx.caller). Für Systeme mit der "
"Berechtigung USER muss dies angegeben werden; ohne Angabe wird anhand der "
"Berechtigung abgeleitet: ADMIN/GM/interne Systeme verwenden admin, EVERYBODY"
" verwendet guest"

#: hetu/cli/call.py:465
msgid "ctx.group，如 gm / admin；给了 --as 时默认 guest"
msgstr "ctx.group, z. B. gm / admin; bei Angabe von --as standardmäßig guest"

#: hetu/cli/call.py:470
msgid "ctx.user_data（登录时写进去的数据 CLI 不知道，需要时手动给）"
msgstr ""
"ctx.user_data (die beim Login hineingeschriebenen Daten kennt die CLI nicht;"
" bei Bedarf manuell angeben)"

#: hetu/cli/call.py:476
msgid "从文件读参数（一个 JSON 数组），- 为 stdin；避开 PowerShell 的引号问题"
msgstr ""
"Argumente aus einer Datei lesen (ein JSON-Array), - für stdin; umgeht die "
"Anführungszeichenprobleme von PowerShell"

#: hetu/cli/call.py:482
msgid "调用锁 uuid（call_lock 的 System），同一 uuid 只执行一次"
msgstr ""
"Aufruf-Lock-uuid (System call_lock); dieselbe uuid wird nur einmal "
"ausgeführt"

#: hetu/cli/call.py:487
msgid "照常执行但不提交，输出它会写什么（写集）"
msgstr ""
"Wie gewohnt ausführen, aber nicht committen; ausgeben, was es schreiben "
"würde (Write-Set)"

#: hetu/cli/call.py:494
msgid "System 调用的超时秒数，默认 30，0 为不限"
msgstr ""
"Timeout in Sekunden für Systemaufrufe; Standard 30, 0 bedeutet unbegrenzt"

#: hetu/cli/call.py:501 hetu/cli/data.py:398 hetu/cli/shell.py:364
msgid "stderr 上多打日志：-v 为 INFO，-vv 为 DEBUG"
msgstr "Mehr Logausgaben auf stderr: -v für INFO, -vv für DEBUG"

#: hetu/cli/call.py:503
msgid "System 名"
msgstr "Systemname"

#: hetu/cli/call.py:508
msgid "参数：按 JSON 解析，解析不了当字符串；- 开头的放在 -- 后面"
msgstr ""
"Argumente: als JSON parsen; wenn das nicht möglich ist, als String "
"behandeln; mit - beginnende Argumente nach -- setzen"

#: hetu/cli/call.py:518
msgid "要给 System 名（hetu call --list 查看全部）"
msgstr "Ein Systemname muss angegeben werden (hetu call --list zeigt alle an)"

#: hetu/cli/console.py:67
msgid ""
"本配置禁止 hetu call / shell 写入（CLI_ALLOW_WRITE: false）：加 --dry-run 看它会写什么，或在配置里设"
" CLI_ALLOW_WRITE: true"
msgstr ""
"Diese Konfiguration verbietet Schreibzugriffe von hetu call / shell "
"(CLI_ALLOW_WRITE: false): Fügen Sie --dry-run hinzu, um zu sehen, was "
"geschrieben würde, oder setzen Sie in der Konfiguration CLI_ALLOW_WRITE: "
"true"

#: hetu/cli/console.py:366
#, python-brace-format
msgid "审计日志写不进去：{path}（{err}）。可用配置 CLI_AUDIT_LOG 改路径"
msgstr ""
"Das Audit-Log kann nicht geschrieben werden: {path} ({err}). Der Pfad kann "
"über die Konfiguration CLI_AUDIT_LOG geändert werden"

#: hetu/cli/console.py:376
#, python-brace-format
msgid "⚠️ 审计日志写不进去：{path}（{err}）"
msgstr "⚠️ Das Audit-Log kann nicht geschrieben werden: {path} ({err})"

#: hetu/cli/console.py:550
msgid "DEBUG 关闭的配置（按生产库对待）上 CLI 刚刚真写入了数据；要禁止，在配置里设 CLI_ALLOW_WRITE: false"
msgstr ""
"In einer Konfiguration mit deaktiviertem DEBUG (wie eine "
"Produktionsdatenbank behandelt) hat die CLI gerade tatsächlich Daten "
"geschrieben; um dies zu verhindern, setzen Sie in der Konfiguration "
"CLI_ALLOW_WRITE: false"

#: hetu/cli/console.py:630
msgid "Worker ID 租约丢失（本进程卡住太久被别人接手），命令已中止"
msgstr ""
"Die Lease für die Worker ID ist verloren gegangen (dieser Prozess hing zu "
"lange und wurde von einem anderen übernommen), der Befehl wurde abgebrochen"

#: hetu/cli/console.py:653
#, python-brace-format
msgid "⚠️ 后台任务 {task} 退出时出错：{err}"
msgstr "⚠️ Fehler beim Beenden des Hintergrundtasks {task}: {err}"

#: hetu/cli/console.py:659
#, python-brace-format
msgid "⚠️ {n} 个后台任务 {timeout} 秒内没有响应取消，不再等待"
msgstr ""
"⚠️ {n} Hintergrundtask(s) haben innerhalb von {timeout} Sekunden nicht auf "
"den Abbruch reagiert; es wird nicht weiter gewartet"

#: hetu/cli/console.py:672
#, python-brace-format
msgid "收尾释放租约 / 关闭连接时出错（不影响已经完成的操作）：{err}"
msgstr ""
"Fehler beim abschließenden Freigeben der Lease / Schließen der Verbindung "
"(bereits abgeschlossene Vorgänge sind nicht betroffen): {err}"

#: hetu/cli/data.py:65
#, python-brace-format
msgid "值 {raw} 不能转换成列类型 {dtype}"
msgstr ""
"Der Wert {raw} kann nicht in den Spaltentyp {dtype} umgewandelt werden"

#: hetu/cli/data.py:89
#, python-brace-format
msgid "分组值 {raw} 不能转换成列类型 {dtype}"
msgstr ""
"Der Gruppierungswert {raw} kann nicht in den Spaltentyp {dtype} umgewandelt "
"werden"

#: hetu/cli/data.py:100 hetu/cli/data.py:282
msgid "查询要写成 FIELD=VALUE，如 owner=1001"
msgstr "Die Abfrage muss als FIELD=VALUE geschrieben werden, z. B. owner=1001"

#: hetu/cli/data.py:104
#, python-brace-format
msgid "{field} 给了不止一次"
msgstr "{field} wurde mehr als einmal angegeben"

#: hetu/cli/data.py:122
#, python-brace-format
msgid ""
"组件 {comp} 的 {field} 不是 id 或带索引的字段，不能查；可查的有：{fields}（括号里是复合索引的分组列，查询时要一并用 "
"FIELD=VALUE 给出）"
msgstr ""
"{field} von Component {comp} ist weder id noch ein indiziertes Feld und kann"
" nicht abgefragt werden; abfragbar sind: {fields} (in Klammern stehen die "
"Gruppierungsspalten zusammengesetzter Indizes, die bei der Abfrage ebenfalls"
" als FIELD=VALUE angegeben werden müssen)"

#: hetu/cli/data.py:140
#, python-brace-format
msgid "--index {index} 要同时用 {index}=VALUE 给出查询值"
msgstr ""
"Bei --index {index} muss der Abfragewert zusätzlich als {index}=VALUE "
"angegeben werden"

#: hetu/cli/data.py:157
#, python-brace-format
msgid ""
"查询条件 {keys} 对不上组件 {comp} "
"的任何索引：要么只给一个带索引的字段，要么正好给出复合索引的本字段和全部分组列；可查的有：{fields}"
msgstr ""
"Die Abfragebedingung {keys} passt zu keinem Index von Component {comp}: "
"Geben Sie entweder nur ein indiziertes Feld an oder genau das Feld des "
"zusammengesetzten Index zusammen mit allen Gruppierungsspalten; abfragbar "
"sind: {fields}"

#: hetu/cli/data.py:166
#, python-brace-format
msgid "查询条件 {keys} 同时匹配了 {matched} 几个索引，请用 --index 指定"
msgstr ""
"Die Abfragebedingung {keys} passt gleichzeitig auf {matched} Indizes; bitte "
"mit --index angeben"

#: hetu/cli/data.py:181
#, python-brace-format
msgid "{index} 是按 {columns} 分组的复合索引，要用 FIELD=VALUE 正好给出这些分组列，收到：{keys}"
msgstr ""
"{index} ist ein nach {columns} gruppierter zusammengesetzter Index; geben "
"Sie genau diese Gruppierungsspalten als FIELD=VALUE an, erhalten: {keys}"

#: hetu/cli/data.py:186
#, python-brace-format
msgid "{index} 不是复合索引，多给了 {keys}"
msgstr "{index} ist kein zusammengesetzter Index, zu viel angegeben: {keys}"

#: hetu/cli/data.py:390
msgid "读 master（刚写完马上读时用）；默认读 servant"
msgstr ""
"Liest von master (für sofortiges Lesen direkt nach dem Schreiben); "
"standardmäßig wird von servant gelesen"

#: hetu/cli/data.py:392
msgid "只输出这些列，逗号分隔"
msgstr "Nur diese Spalten ausgeben, durch Kommas getrennt"

#: hetu/cli/data.py:414
msgid ""
"按 id 或带索引的字段读一行组件数据（不做 RLS），stdout 输出一行 JSON；不加载 app，schema 取自库里的表 meta"
msgstr ""
"Liest eine Zeile Component-Daten über id oder ein indiziertes Feld (ohne "
"RLS) und gibt eine Zeile JSON auf stdout aus; app wird nicht geladen, das "
"schema stammt aus der Tabellen-meta in der Datenbank"

#: hetu/cli/data.py:422
msgid "列出组件、字段与索引（加载 app，不连数据库）"
msgstr ""
"Listet Components, Felder und Indizes auf (lädt app, keine "
"Datenbankverbindung)"

#: hetu/cli/data.py:427
msgid "FIELD=VALUE 同时匹配了几个复合索引时，指定按哪个索引查（其余 FIELD=VALUE 是它的分组值）"
msgstr ""
"Wenn FIELD=VALUE gleichzeitig auf mehrere zusammengesetzte Indizes passt, "
"gibt an, über welchen Index abgefragt wird (die übrigen FIELD=VALUE sind "
"dessen Gruppierungswerte)"

#: hetu/cli/data.py:437
msgid "一个带索引的字段，如 owner=1001；复合索引要同时给出全部分组列，如 name=abc zone=3"
msgstr ""
"Ein indiziertes Feld, z. B. owner=1001; bei einem zusammengesetzten Index "
"müssen alle Gruppierungsspalten angegeben werden, z. B. name=abc zone=3"

#: hetu/cli/data.py:450
msgid "要给组件名和 FIELD=VALUE（hetu get --list 查看组件）"
msgstr ""
"Component-Name und FIELD=VALUE müssen angegeben werden (Components mit hetu "
"get --list anzeigen)"

#: hetu/cli/data.py:469
msgid ""
"按带索引的字段读一个区间的组件数据（不做 RLS），stdout 输出一行 JSON；省略 RIGHT 即精确匹配 LEFT，( / [ 前缀表示开 /"
" 闭区间"
msgstr ""
"Liest einen Bereich von Component-Daten über ein indiziertes Feld (ohne RLS)"
" und gibt eine Zeile JSON auf stdout aus; ohne RIGHT wird exakt auf LEFT "
"abgeglichen, die Präfixe ( / [ stehen für offenes / geschlossenes Intervall"

#: hetu/cli/data.py:478
msgid "最多返回多少行，默认 10，-1 为不限"
msgstr ""
"Maximale Anzahl zurückgegebener Zeilen, Standard 10, -1 für unbegrenzt"

#: hetu/cli/data.py:480
msgid "降序"
msgstr "Absteigend"

#: hetu/cli/data.py:486
msgid "复合索引的分组值，每个分组列给一次，如 --group zone=3"
msgstr ""
"Gruppierungswert eines zusammengesetzten Index, einmal pro "
"Gruppierungsspalte, z. B. --group zone=3"

#: hetu/cli/init.py:325
msgid "❌ 未找到 uv 命令，请先安装 uv：https://docs.astral.sh/uv/"
msgstr ""
"❌ uv-Befehl nicht gefunden. Installiere uv: https://docs.astral.sh/uv/"

#: hetu/cli/init.py:329
#, python-brace-format
msgid "❌ uv {cmd} 执行失败（退出码 {code}）"
msgstr "❌ uv {cmd} fehlgeschlagen (Exit-Code {code})"

#: hetu/cli/init.py:355
#, python-brace-format
msgid "ℹ️  {path} 已存在，跳过"
msgstr "ℹ️  {path} existiert bereits, wird übersprungen"

#: hetu/cli/init.py:359
#, python-brace-format
msgid "✅ 已创建 {path}"
msgstr "✅ {path} wurde erstellt"

#: hetu/cli/init.py:374
msgid "ℹ️  pyproject.toml 已注册 build/dev 命令，跳过"
msgstr ""
"ℹ️  build/dev-Befehle sind in pyproject.toml bereits registriert, wird "
"übersprungen"

#: hetu/cli/init.py:377
msgid "⚠️  pyproject.toml 已有 build/dev 命令定义，跳过注册，请手动检查"
msgstr ""
"⚠️  pyproject.toml enthält bereits Definitionen für build/dev-Befehle, "
"Registrierung wird übersprungen, bitte manuell prüfen"

#: hetu/cli/init.py:391
msgid "✅ 已在 pyproject.toml 注册 build/dev 命令"
msgstr "✅ build/dev-Befehle wurden in pyproject.toml registriert"

#: hetu/cli/init.py:401
#, python-brace-format
msgid "✅ 已将 {entry} 加入 .gitignore"
msgstr "✅ {entry} wurde zu .gitignore hinzugefügt"

#: hetu/cli/init.py:411
msgid "初始化一个新的河图项目"
msgstr "Ein neues Hetu-Projekt initialisieren"

#: hetu/cli/init.py:416
msgid "项目目录名，省略则在当前目录初始化"
msgstr ""
"Projektverzeichnisname, bei Auslassung wird im aktuellen Verzeichnis "
"initialisiert"

#: hetu/cli/init.py:421
msgid "项目使用的 Python 版本"
msgstr "Python-Version für das Projekt"

#: hetu/cli/init.py:431
msgid "ℹ️  检测到 pyproject.toml，跳过 uv init"
msgstr "ℹ️  pyproject.toml erkannt, uv init wird übersprungen"

#: hetu/cli/init.py:504
msgid "ℹ️  config.yml 已存在，跳过"
msgstr "ℹ️  config.yml existiert bereits, wird übersprungen"

#: hetu/cli/init.py:508
msgid "✅ 已创建 config.yml"
msgstr "✅ config.yml wurde erstellt"

#: hetu/cli/init.py:521
msgid "ℹ️  hetudb 已在依赖中，跳过 uv add"
msgstr ""
"ℹ️  hetudb ist bereits als Abhängigkeit vorhanden, uv add wird übersprungen"

#: hetu/cli/init.py:527
msgid "🎉 项目已就绪！下一步："
msgstr "🎉 Projekt ist eingerichtet! Nächste Schritte:"

#: hetu/cli/init.py:531
msgid "# 强制迁移并启动开发服务器（含客户端代码生成）"
msgstr ""
"# Migration erzwingen und Entwicklungsserver starten (inkl. Client-"
"Codegenerierung)"

#: hetu/cli/init.py:533
msgid "# 仅生成客户端 C# 组件代码"
msgstr "# Nur Client-C#-Komponentencode generieren"

#: hetu/cli/init.py:534
msgid "# 仅启动服务"
msgstr "# Nur den Server starten"

#: hetu/cli/init.py:536
msgid "提示：默认使用 SQLite 调试数据库，文件会自动创建，无需额外服务。"
msgstr ""
"Hinweis: Standardmäßig wird SQLite als Debug-Datenbank verwendet, die Datei "
"wird automatisch erstellt, kein zusätzlicher Dienst erforderlich."

#: hetu/cli/init.py:537
msgid "      生产环境请在 config.yml 的 BACKENDS 中改用 Redis。"
msgstr ""
"      In der Produktionsumgebung bitte in config.yml unter BACKENDS Redis "
"verwenden."

#: hetu/cli/init.py:540
#, python-brace-format
msgid "      uv run build 需在 .env.test 设置 {env} 指向客户端工程输出路径。"
msgstr ""
"      uv run build erfordert, dass {env} in .env.test auf den Ausgabepfad "
"des Client-Projekts zeigt."

#: hetu/cli/init.py:544
#, python-brace-format
msgid "      已写入 .claude/skills/{name}/，供编码 AI 了解 HeTu 用法。"
msgstr ""
"      Wurde nach .claude/skills/{name}/ geschrieben, damit die Coding-KI die"
" HeTu-Nutzung versteht."

#: hetu/cli/migrate.py:37
msgid ""
"在数据库执行Schema升级脚本,如果没有则创建，如果无变更则跳过。同时还会进行临时表的清空。应该在CI/CD流程中，每次启动服务器前执行一次。"
msgstr ""
"Führt Schema-Upgrade-Skripte in der Datenbank aus, erstellt sie falls nicht "
"vorhanden und überspringt sie bei keiner Änderung. Zudem werden temporäre "
"Tabellen geleert. Sollte im CI/CD-Prozess einmal vor jedem Serverstart "
"ausgeführt werden."

#: hetu/cli/migrate.py:44 hetu/cli/start.py:95
msgid "后端数据库地址，默认 redis://127.0.0.1:6379/0"
msgstr "Adresse der Backend-Datenbank, Standard redis://127.0.0.1:6379/0"

#: hetu/cli/migrate.py:48
msgid "河图app的py文件，默认 app.py"
msgstr "Die py-Datei der hetu-App, Standard app.py"

#: hetu/cli/migrate.py:54 hetu/cli/start.py:84
msgid "启动app.py中哪个namespace下的System"
msgstr ""
"Welches System unter welchem Namespace in app.py gestartet werden soll"

#: hetu/cli/migrate.py:57 hetu/cli/start.py:87
msgid "实例名称，每个实例是一个副本"
msgstr "Instanzname, jede Instanz ist eine Replik"

#: hetu/cli/migrate.py:63
msgid "通过yml配置文件读取后端数据库地址。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Liest die Adresse der Backend-Datenbank aus einer yml-Konfigurationsdatei. "
"Wenn keine angegeben ist und kein Kommandozeilenparameter verwendet wird, "
"werden der Reihe nach die Umgebungsvariable HETU_CONFIG und die config.yml "
"im aktuellen Verzeichnis gesucht"

#: hetu/cli/migrate.py:72
msgid "自动确认数据备份提示"
msgstr "Bestätigt automatisch die Datenbank-Backup-Aufforderung."

#: hetu/cli/migrate.py:78
msgid "强制执行升级迁移，丢弃无法迁移的数据。请勿在生产环境使用此选项！"
msgstr ""
"Erzwingt das Upgrade-Migration und verwirft nicht migrierbare Daten. Diese "
"Option nicht in der Produktionsumgebung verwenden!"

#: hetu/cli/migrate.py:85
msgid "跳过重建索引。默认每次升级都按行数据重建持久组件的索引、修掉索引残留，数据量大时较慢"
msgstr ""
"Überspringt den Neuaufbau der Indizes. Standardmäßig werden bei jedem "
"Upgrade die Indizes der persistenten Component anhand der Zeilendaten neu "
"aufgebaut und Indexreste bereinigt; bei großen Datenmengen ist dies "
"langsamer"

#: hetu/cli/migrate.py:121
#, python-brace-format
msgid ""
"❌ 检测到还有服务器在运行（持有 Worker ID "
"租约：{ids}），请先停服再升级：迁移、清空易失表、重建索引在服务器运行时执行都会写坏数据。服务器是异常退出的，等租约过期（最多 {ttl} "
"秒）后再试。"
msgstr ""
"❌ Es wurden noch laufende Server erkannt (halten Worker-ID-Lease: {ids}). "
"Bitte stoppen Sie die Server vor dem Upgrade: Migration, Leeren flüchtiger "
"Tabellen und Neuaufbau der Indizes während laufender Server führen zu "
"Datenkorruption. Wenn der Server unerwartet beendet wurde, warten Sie, bis "
"der Lease abgelaufen ist (maximal {ttl} Sekunden), und versuchen Sie es "
"erneut."

#: hetu/cli/migrate.py:129
#, python-brace-format
msgid "   其中 {ids} 是 hetu call / shell 进程，等它们结束即可（异常退出的最多 {ttl} 秒过期）。"
msgstr ""
"   Dabei handelt es sich bei {ids} um hetu call / shell-Prozesse; warten Sie"
" einfach, bis sie beendet sind (bei unerwartetem Beenden laufen sie nach "
"maximal {ttl} Sekunden ab)."

#: hetu/cli/migrate.py:147
msgid "⚠️  升级数据库表结构可能会导致数据丢失，请确保已备份数据。确认继续请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Das Upgrade der Datenbanktabellenstruktur kann zu Datenverlust führen. "
"Stellen Sie sicher, dass Sie Ihre Daten gesichert haben. Geben Sie y ein, um"
" fortzufahren, oder eine andere Taste gefolgt von Enter, um abzubrechen:"

#: hetu/cli/migrate.py:152 hetu/cli/migrate.py:179
msgid "❌  升级迁移已取消。"
msgstr "❌  Upgrade-Migration wurde abgebrochen."

#: hetu/cli/migrate.py:169
msgid "❗ Component有数据删除或类型变更，请修改自动生成的迁移脚本，手动处理这些属性。或使用--drop-data参数直接丢弃这些属性。"
msgstr ""
"❗ Bei der Component gibt es Datenlöschungen oder Typänderungen. Bitte ändern"
" Sie das automatisch generierte Migrationsskript, um diese Attribute manuell"
" zu behandeln. Oder verwenden Sie den Parameter --drop-data, um diese "
"Attribute direkt zu verwerfen."

#: hetu/cli/migrate.py:176
msgid "⚠️  确认强制迁移请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Geben Sie y ein, um die erzwungene Migration zu bestätigen, oder eine "
"andere Taste gefolgt von Enter, um abzubrechen:"

#: hetu/cli/migrate.py:183
#, python-brace-format
msgid "⚠️  正在强制迁移 {instance_name} 服所有表结构，可能会丢失数据..."
msgstr ""
"⚠️  Erzwinge Migration der Tabellenstruktur für alle Server von "
"{instance_name}. Datenverlust ist möglich..."

#: hetu/cli/migrate.py:191
#, python-brace-format
msgid "🧹 正在清除 {instance_name} 服易失数据..."
msgstr "🧹 Räume flüchtige Daten für den Server {instance_name} auf..."

#: hetu/cli/migrate.py:199
#, python-brace-format
msgid "🔧 正在重建 {instance_name} 服的索引..."
msgstr "🔧 Indizes des Servers {instance_name} werden neu aufgebaut..."

#: hetu/cli/migrate.py:206
#, python-brace-format
msgid "✅  {instance_name} 服升级迁移完成！"
msgstr "✅  Upgrade-Migration für den Server {instance_name} abgeschlossen!"

#: hetu/cli/migrate.py:210
msgid "🎉  恭喜！所有数据库表结构均已升级完成！"
msgstr ""
"🎉  Glückwunsch! Alle Datenbanktabellenstrukturen wurden erfolgreich "
"aktualisiert!"

#: hetu/cli/shell.py:70
msgid "call 留给以后的 Endpoint 路径（与 Sandbox.call 同义），跑 System 请用 call_system"
msgstr ""
"call ist für spätere Endpoint-Pfade reserviert (gleichbedeutend mit "
"Sandbox.call); um ein System auszuführen, verwende call_system"

#: hetu/cli/shell.py:189
msgid "KeyboardInterrupt（Ctrl+D 退出 shell）"
msgstr "KeyboardInterrupt (Ctrl+D beendet die Shell)"

#: hetu/cli/shell.py:229
msgid ""
"HeTu shell：预置 app / client / call_system / get / must_get / insert / upsert "
"/ show，range 用 app.range；支持顶层 await，Ctrl+D 退出"
msgstr ""
"HeTu-Shell: vordefiniert sind app / client / call_system / get / must_get / "
"insert / upsert / show; für range verwende app.range; unterstützt top-level "
"await, Ctrl+D zum Beenden"

#: hetu/cli/shell.py:270
msgid "没有要执行的代码：用 -c CODE、脚本文件，或从 stdin 传入；在终端里直接运行 hetu shell 进交互模式"
msgstr ""
"Kein Code zum Ausführen: Verwende -c CODE, eine Skriptdatei oder Eingabe "
"über stdin; führe im Terminal direkt hetu shell aus, um in den interaktiven "
"Modus zu wechseln"

#: hetu/cli/shell.py:318
#, python-brace-format
msgid "⚠️ shell 退出时取消了 {n} 个还在跑的后台任务"
msgstr ""
"⚠️ Beim Beenden der Shell wurden {n} noch laufende Hintergrundaufgaben "
"abgebrochen"

#: hetu/cli/shell.py:348
msgid ""
"进程内连上后端的 Python shell：预置 call_system / get / must_get / insert / upsert / "
"show 与 app.range，支持顶层 await"
msgstr ""
"Python-Shell, die im laufenden Prozess eine Verbindung zum Backend "
"herstellt: vordefiniert sind call_system / get / must_get / insert / upsert "
"/ show und app.range, unterstützt top-level await"

#: hetu/cli/shell.py:353
msgid "执行这段代码"
msgstr "Diesen Code ausführen"

#: hetu/cli/shell.py:357
msgid "执行但不提交任何写入"
msgstr "Ausführen, aber keine Schreibvorgänge festschreiben"

#: hetu/cli/shell.py:370
msgid "要执行的脚本，- 为 stdin；都不给且 stdin 是终端时进交互模式"
msgstr ""
"Das auszuführende Skript, - steht für stdin; wird nichts angegeben und ist "
"stdin ein Terminal, wird der interaktive Modus gestartet"

#: hetu/cli/start.py:73
msgid "启动河图服务"
msgstr "Hetu-Dienst starten"

#: hetu/cli/start.py:75
msgid "通过命令行启动参数"
msgstr "Über Befehlszeilen-Startparameter"

#: hetu/cli/start.py:78
msgid "河图app的py文件，默认 /app/app.py"
msgstr "Die py-Datei der Hetu-App, standardmäßig /app/app.py"

#: hetu/cli/start.py:90
msgid "监听的Websocket端口"
msgstr "Websocket-Port, auf dem gelauscht wird"

#: hetu/cli/start.py:100
msgid "工作进程数，可设为 CPU * 1.2，-1为按CPU核心数自动"
msgstr ""
"Anzahl der Worker-Prozesse, kann auf CPU * 1.2 gesetzt werden, -1 für "
"automatisch nach CPU-Kernzahl"

#: hetu/cli/start.py:109
#, python-format
msgid ""
"开启debug模式，这会启动代码热更新，并显示更多的log信息。如果设置为2，则对框架内核也启用debug模式，会开启Python协程的Debug模式，速度慢90%%。"
msgstr ""
"Debug-Modus aktivieren. Dies startet Hot-Reloading von Code und zeigt mehr "
"Log-Informationen an. Wenn auf 2 gesetzt, wird der Debug-Modus auch für das "
"Framework-Kernel aktiviert, was den Python-Coroutine-Debug-Modus einschaltet"
" und die Geschwindigkeit um 90%% verringert."

#: hetu/cli/start.py:119
msgid "证书目录，如果不设置则使用不安全的连接。不建议这里设置，请外加一层反向https代理。填入auto会生成自签https证书。"
msgstr ""
"Zertifikatsverzeichnis. Wenn nicht gesetzt, wird eine unsichere Verbindung "
"verwendet. Es wird nicht empfohlen, dies hier zu setzen; bitte verwenden Sie"
" einen zusätzlichen Reverse-HTTPS-Proxy. 'auto' eingeben, um ein "
"selbstsigniertes HTTPS-Zertifikat zu generieren."

#: hetu/cli/start.py:127
msgid "默认crypto层的auth_key，用于握手签名校验。留空则不启用。"
msgstr ""
"Standard-Auth-Key für die Crypto-Schicht, verwendet für Handshake-"
"Signaturprüfung. Leer lassen, um nicht zu aktivieren."

#: hetu/cli/start.py:135
msgid ""
"配置文件模板见CONFIG_TEMPLATE.yml。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Die Vorlage für die Konfigurationsdatei finden Sie in CONFIG_TEMPLATE.yml. "
