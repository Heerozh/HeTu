#, python-brace-format
msgid "连接Redis数据库 {url} 时服务端返回错误：{error}"
msgstr ""
"The server returned an error while connecting to Redis database {url}: "
"{error}"

#: hetu/data/backend/redis/client.py:338
#, python-brace-format
msgid ""
"⚠️ [💾Redis] 无权限调用数据库{url}的config_set命令，数据订阅将不起效。可手动设置配置文件：notify-keyspace-"
"events={keyspace}"
msgstr ""
"⚠️ [💾Redis] No permission to call the config_set command on database {url}. "
"Data subscription will not work. You can manually set the configuration: "
"notify-keyspace-events={keyspace}"

#: hetu/data/backend/redis/client.py:366
msgid "is_synced只能在master上调用"
msgstr "is_synced can only be called on the master."

#: hetu/data/backend/redis/client.py:545
msgid "lua_commit脚本没有初始化，请先调用 post_configure"
msgstr ""
"The lua_commit script is not initialized. Please call post_configure first."

