msgid ""
"{cname}.{fname}属性定义出错，属性名不能和numpy行数据的属性同名，否则row.{fname}读到的是numpy的属性而不是字段值，请换个名字。"
msgstr ""
"{cname}.{fname} property definition error: property name cannot be the same "
"as a numpy row data attribute; otherwise row.{fname} reads the numpy "
"attribute instead of the field value. Please choose another name."

#: hetu/data/component.py:654
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不能为0长度。str类型请用'<U8'方式定义"
msgstr ""
"{cname}.{fname} property dtype cannot be zero length. For str type, please "
"define it using '<U8' format."

#: hetu/data/component.py:657
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不支持void类型"
msgstr "{cname}.{fname} property dtype does not support void type."

#: hetu/data/component.py:668
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为unique时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] When {cname}.{fname} property is set to unique, index cannot "
"be set to False."

#: hetu/data/component.py:678
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了groupby（复合索引），point_sub用不上已忽略：按组订阅本来就只被本组的写入叫醒。"
msgstr ""
"⚠️ [🛠️Define] {cname}.{fname} property has groupby (composite index) set; "
"point_sub cannot use it and has ignored it: group-based subscriptions are "
"only woken by writes from their own group anyway."

#: hetu/data/component.py:690
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了commit_seq，point_sub用不上已忽略：号要到提交时才有，发不出值频道。"
msgstr ""
"⚠️ [🛠️Define] {cname}.{fname} property has commit_seq set; point_sub cannot "
"use it and has ignored it: the number is only available at commit time and "
"cannot be emitted on the value channel."

#: hetu/data/component.py:698
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了commit_seq时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] When the {cname}.{fname} property has commit_seq set, index "
"cannot be set to False."

#: hetu/data/component.py:707
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为point_sub时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] When the {cname}.{fname} property is set to point_sub, index "
"cannot be set to False."

#: hetu/data/component.py:716
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了groupby时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] When the {cname}.{fname} property has groupby set, index "
"cannot be set to False."

#: hetu/data/component.py:725
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，hidden属性不能同时设置point_sub：客户端不能按hidden属性订阅。"
msgstr ""
"{cname}.{fname} property definition error: the hidden property cannot also "
"set point_sub: clients cannot subscribe by hidden property."

#: hetu/data/component.py:731
#, python-brace-format
msgid ""
"{cname}.{fname}默认值不能为None。所有属性都要有默认值，因为数据接口统一用c like "
"struct实现，强类型struct不接受NULL/None值。"
msgstr ""
"{cname}.{fname} default value cannot be None. All properties must have "
"default values because the data interface is uniformly implemented using "
"C-like structs, and strongly-typed structs do not accept NULL/None values."

#: hetu/data/component.py:742
#, python-brace-format
msgid ""
"{cname}.{fname}的default值：{default_type}({default_value})和属性dtype({dtype})不匹配"
msgstr ""
"{cname}.{fname} default value: {default_type}({default_value}) does not "
"match property dtype ({dtype})."

#: hetu/data/component.py:756
#, python-brace-format
msgid "{cname}权限为OWNER时，不能设置rls_compare参数"
msgstr ""
"When {cname} permission is OWNER, the rls_compare parameter cannot be set."

#: hetu/data/component.py:759
#, python-brace-format
msgid "{cname}权限为OWNER时，必须有owner属性"
msgstr "When {cname} permission is OWNER, it must have an owner property."

#: hetu/data/component.py:766
#, python-brace-format
msgid "{cname}的owner属性必需是numeric数字(int, np.int64, ...)类型"
msgstr "{cname}'s owner property must be a numeric type (int, np.int64, ...)."

#: hetu/data/component.py:772
#, python-brace-format
msgid "{cname}权限为RLS时，必须通过rls_compare参数定义行级权限逻辑"
msgstr ""
"When {cname} permission is RLS, the row-level permission logic must be "
"defined via the rls_compare parameter."

#: hetu/data/component.py:775
#, python-brace-format
msgid "{cname}.rls_compare参数必须全部是字符串类型"
msgstr "{cname}.rls_compare parameters must all be string types."

#: hetu/data/component.py:778
#, python-brace-format
msgid "{cname}.rls_compare参数必须只有3个元素)"
msgstr "{cname}.rls_compare parameter must have exactly 3 elements."

#: hetu/data/component.py:782
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但operator模块没有{method}方法"
msgstr ""
"{cname} permission is RLS: {rls_compare}, but the operator module does not "
"have the {method} method."

#: hetu/data/component.py:786
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但表没有定义{prop}属性"
msgstr ""
"{cname} permission is RLS: {rls_compare}, but the table does not define the "
"{prop} property."

#: hetu/data/component.py:803
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列必须是本组件的字段名，不能是id、_version：{col!r}"
msgstr ""
"{cname}.{fname} groupby definition error: grouping columns must be field "
"names of this Component and cannot be id or _version: {col!r}"

#: hetu/data/component.py:809
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，不能按自己分组"
msgstr "{cname}.{fname} groupby definition error: cannot group by itself"

#: hetu/data/component.py:816
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，组件没有字段`{col}`"
msgstr ""
"{cname}.{fname} groupby definition error: the Component has no field `{col}`"

#: hetu/data/component.py:822
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列`{col}`重复了"
msgstr ""
"{cname}.{fname} groupby definition error: grouping column `{col}` is "
"duplicated"

#: hetu/data/component.py:830
#, python-brace-format
msgid ""
"{cname}.{fname}的groupby定义出错，分组列`{col}`只能是整数、str、bytes类型，不能是{dtype}：浮点按等值分组没有意义，NaN、-0.0"
" 的相等也说不清"
msgstr ""
"{cname}.{fname} groupby definition error: grouping column `{col}` can only "
"be integer, str, or bytes type, and cannot be {dtype}: grouping floats by "
"equality is meaningless, and the equality of NaN and -0.0 is ambiguous"

#: hetu/data/component.py:842
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，{dtype}类型不能建索引"
msgstr ""
"{cname}.{fname} property definition error: an index cannot be created for "
"{dtype} type"

#: hetu/data/component.py:855
#, python-brace-format
msgid "{cname}定义出错，最多只能有一个commit_seq字段：{fields}"
msgstr ""
"{cname} definition error: there can be at most one commit_seq field: "
"{fields}"

#: hetu/data/component.py:866
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的类型只能是np.int64，不能是{dtype}"
msgstr ""
"{cname}.{fname} property definition error: commit_seq type can only be "
"np.int64, not {dtype}"

#: hetu/data/component.py:875
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的default必须是0：0表示还没发号，号从1开始"
msgstr ""
"{cname}.{fname} property definition error: the default of commit_seq must be"
" 0: 0 means no number has been issued yet; numbers start from 1"

#: hetu/data/component.py:884
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq不能同时设置unique：组内唯一由发号保证"
msgstr ""
"{cname}.{fname} property definition error: commit_seq cannot also set "
"unique: uniqueness within the group is guaranteed by number issuance"

#: hetu/data/component.py:894
#, python-brace-format
msgid "{cname}.{other}的groupby定义出错，commit_seq字段`{fname}`不能当分组列：它的号要到提交时才有"
msgstr ""
"{cname}.{other} groupby definition error: commit_seq field `{fname}` cannot "
"be used as a grouping column: its number is only available at commit time"

#: hetu/data/component.py:912
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq字段不能用作行级权限的判定列"
msgstr ""
"{cname}.{fname} property definition error: the commit_seq field cannot be "
"used as a determining column for row-level permissions"

#: hetu/data/component.py:921
#, python-brace-format
msgid "组件名({name})是C#关键字，请refactor。"
msgstr "Component name ({name}) is a C# keyword, please refactor."

#: hetu/data/component.py:934
#, python-brace-format
msgid "{cls_name}.{name}不是Property类型"
msgstr "{cls_name}.{name} is not of Property type."

#: hetu/data/component.py:944
#, python-brace-format
msgid ""
"{cls_name}.{name}属性未定义type hint。请使用以下形式，{name}: type = property_field(...)"
msgstr ""
"{cls_name}.{name} property does not have a type hint defined. Please use the"
" following format: {name}: type = property_field(...)"

#: hetu/data/component.py:949
#, python-brace-format
msgid "{cls_name}至少要有1个Property成员"
msgstr "{cls_name} must have at least 1 Property member."

#: hetu/data/component.py:957
#, python-brace-format
msgid "{cls_name}.id是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}.id is a reserved built-in primary key and cannot be redefined "
"externally."

#: hetu/data/component.py:960
#, python-brace-format
msgid "{cls_name}._version是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}._version is a reserved built-in primary key and cannot be "
"redefined externally."

#: hetu/data/component.py:969
#, python-brace-format
msgid "{cls_name}必须继承于BaseComponent"
msgstr "{cls_name} must inherit from BaseComponent."

#: hetu/data/component.py:977
#, python-brace-format
msgid "{cls_name}权限定义出错，Component不能用GM权限：GM只用于System/Endpoint的调用权限"
msgstr ""
"{cls_name} permission definition error: Component cannot use GM permissions:"
" GM is only used for System/Endpoint invocation permissions"

#: hetu/data/migration.py:39
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 发现自定义迁移脚本 {file}，将调用脚本进行迁移..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Found custom migration script "
"{file}, will call script to perform migration..."

#: hetu/data/migration.py:92
#, python-brace-format
msgid ""
"  ➖ [💾MIGRATION][{comp_name}组件] 缺少迁移脚本，生成默认迁移脚本 "
"{script_path}，请根据需要修改脚本内容后再执行迁移操作..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Migration script missing, generated "
"default migration script {script_path}. Please modify the script content as "
"needed before executing migration operations..."

#: hetu/data/migration.py:212
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 执行upgrade迁移：{module}"
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Executing upgrade migration: "
"{module}"

#: hetu/data/migration.py:218
#, python-brace-format
msgid "  ✔️ [💾MIGRATION][{comp_name}组件] Schema升级迁移完成，共处理{count}行"
msgstr ""
"  ✔️ [💾MIGRATION][{comp_name} Component] Schema upgrade migration completed,"
" processed {count} rows in total"

#: hetu/data/migration.py:230
#, python-brace-format
msgid ""
"[💾MIGRATION][{comp_name}组件] "
"数据已经按新定义搬完，但重建索引失败：{error}。在修好之前服务器会拒绝启动：请直接修改表里的数据（比如用 TableMaintenance 的 "
"upsert_row 给重复的号重新编号），再跑一次 hetu upgrade，它会按当前定义直接重建索引"
msgstr ""
"[💾MIGRATION][{comp_name} Component] The data has been migrated according to "
"the new definition, but rebuilding the index failed: {error}. Until this is "
"fixed, the server will refuse to start: please modify the data in the table "
"directly (for example, use TableMaintenance's upsert_row to renumber "
"duplicate numbers), then run hetu upgrade again; it will rebuild the index "
"directly according to the current definition"

#: hetu/data/migration.py:237
#, python-brace-format
msgid "  ✔️ [💾MIGRATION][{comp_name}组件] 已重建Index"
msgstr "  ✔️ [💾MIGRATION][{comp_name} Component] Index rebuilt"

#: hetu/data/sub.py:55
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] {comp_name} 按 id 点查询的范围订阅会订整个 id "
"索引的频道：这张表每次插入、删除都会叫醒它重跑比对。按 id 订单行请用行订阅（服务端 subscribe_get，客户端 WatchRow）"
msgstr ""
"⚠️ [📡Subscription] A range subscription on {comp_name} for point queries by "
"id will subscribe to the channel of the whole id index: every insert and "
"delete on this table will wake it up to re-run the comparison. For single "
"rows by id, use a row subscription (server-side subscribe_get, client-side "
"WatchRow)"

#: hetu/data/sub.py:63
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] {comp_name}.{index_name} 没有声明 "
"point_sub，点查询订阅退化为区间订阅：该索引上任何写入都会叫醒它重跑比对。需要高效点订阅请在 property_field 里加 "
"point_sub=True"
msgstr ""
"⚠️ [📡Subscription] {comp_name}.{index_name} does not declare point_sub; "
"point-query subscriptions degrade to range subscriptions: any write on this "
"index will wake it up to re-run the comparison. For efficient point "
"subscriptions, add point_sub=True in property_field"

#: hetu/data/sub.py:405
#, python-brace-format
msgid "IndexSubscription收到了未知的channel消息: {channel}"
msgstr "IndexSubscription received an unknown channel message: {channel}"

#: hetu/data/sub.py:546
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] "
"{comp_name}整表订阅行数超过限制MAX_TABLE_SUBSCRIPTION_ROWS={max_rows}，拒绝订阅"
msgstr ""
"⚠️ [📡Subscription] {comp_name} whole-table subscription row count exceeds "
"limit MAX_TABLE_SUBSCRIPTION_ROWS={max_rows}, rejecting subscription"

#: hetu/data/sub.py:588
#, python-brace-format
msgid "TableSubscription收到了未知的channel消息: {channel}"
msgstr "TableSubscription received an unknown channel message: {channel}"

