#: hetu/data/sub.py:1280
#, python-brace-format
msgid "初始化订阅 {sub_id} 出错，换副本稍后重试"
msgstr ""
"Error initializing subscription {sub_id}, switching to another replica and "
"retrying later"

#: hetu/data/sub.py:1322
#, python-brace-format
msgid "初始化订阅 {sub_id} 出错，重试 {retries} 次仍失败"
msgstr ""
"Error initializing subscription {sub_id}, still failing after {retries} "
"retries"

#: hetu/data/sub.py:1358
msgid "⚠️ [📡Subscription] 订阅处理循环被取消，下次订阅时重新拉起"
msgstr ""
"⚠️ [📡Subscription] Subscription processing loop was cancelled, it will be "
"started again on the next subscription"

#: hetu/data/sub.py:1365
#, python-brace-format
msgid "❌ [📡Subscription] 订阅处理循环异常结束，{delay} 秒后重新拉起"
msgstr ""
"❌ [📡Subscription] Subscription processing loop terminated abnormally, "
"restarting in {delay} seconds"

#: hetu/data/sub.py:1389
msgid "处理订阅通知异常（bug），这批通知可能没处理完"
msgstr ""
"Unexpected error (bug) while processing subscription notifications; this "
"batch may not have been fully processed"

#: hetu/data/sub.py:1435
#, python-brace-format
msgid "❌ [📡Subscription] {what}：{err}，已重新入队稍后重试（上次记录以来另有 {muted} 次出错未记）"
msgstr ""
"❌ [📡Subscription] {what}: {err}, re-queued to retry later ({muted} "
"additional errors not logged since the last record)"

#: hetu/data/sub.py:1440
#, python-brace-format
msgid "❌ [📡Subscription] {what}：{err}（上次记录以来另有 {muted} 次出错未记）"
msgstr ""
"❌ [📡Subscription] {what}: {err} ({muted} additional errors not logged since "
"the last record)"

#: hetu/data/sub.py:1461
#, python-brace-format
msgid "✅ [📡Subscription] {what}：{err} 已停止（最后一条日志之后另有 {muted} 次未记）"
msgstr ""
"✅ [📡Subscription] {what}: {err} stopped ({muted} additional occurrences not "
"logged after the last message)"

#: hetu/data/sub.py:1660
msgid "补订频道出错"
msgstr "Error subscribing to supplementary channels"

#: hetu/data/sub.py:1717
#, python-brace-format
msgid "预读 {comp_name} 的行出错，这批改为逐行读"
msgstr ""
"Error pre-reading rows of {comp_name}, reading this batch row by row instead"

#: hetu/data/sub.py:1747 hetu/data/sub.py:1756
msgid "处理订阅通知异常（bug）"
msgstr "Unexpected error (bug) while processing subscription notifications"

#: hetu/data/sub.py:1781
#, python-brace-format
msgid "订阅处理通知出错，频道 {channel}"
msgstr "Error processing subscription notification, channel {channel}"

#: hetu/data/sub.py:1922
msgid "订阅新进入范围的行频道出错"
msgstr "Error subscribing to the channel of a row newly entering range"

#: hetu/data/sub.py:1954
#, python-brace-format
msgid "⚠️ [📡Subscription] 订阅 / 退订频道失败：{err}"
msgstr "⚠️ [📡Subscription] Failed to subscribe / unsubscribe channel: {err}"

#: hetu/data/sub.py:2121
#, python-brace-format
msgid "⚠️ [📡Subscription] 关闭连接时取消订阅失败：{err}"
msgstr ""
"⚠️ [📡Subscription] Failed to unsubscribe while closing the connection: {err}"

#: hetu/data/sub.py:2212
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] {comp_name}.{index_name} 是 hidden "
"属性，不允许按它订阅，检查是否非法调用，caller：{caller}"
msgstr ""
"⚠️ [📡Subscription] {comp_name}.{index_name} is a hidden property and cannot "
"be subscribed on, check for illegal invocation, caller: {caller}"

#: hetu/data/sub.py:2311
#, python-brace-format
msgid "⚠️ [{tag}] 当前连接订阅数超过全局限制MAX_SUBSCRIBED={limit}行"
msgstr ""
"⚠️ [{tag}] Current connection subscription count exceeds global limit "
"MAX_SUBSCRIBED={limit} rows"

#: hetu/data/sub.py:2385
msgid "按 id 订阅不能给分组值"
msgstr "Subscribing by id does not accept a group value"

#: hetu/data/sub.py:2409 hetu/data/sub.py:2642 hetu/data/sub.py:2885
#, python-brace-format
msgid "⚠️ [📡Subscription] {sub_id} 数据重复订阅，检查客户端代码"
msgstr ""
"⚠️ [📡Subscription] {sub_id} Data duplicate subscription, check client code"

#: hetu/data/sub.py:2440
#, python-brace-format
msgid "🆕 [📡Subscription] 订阅了行: {sub_id} {channel_name}"
msgstr "🆕 [📡Subscription] Subscribed to row: {sub_id} {channel_name}"

#: hetu/data/sub.py:2621 hetu/data/sub.py:2875
#, python-brace-format
msgid "⚠️ [📡Subscription] {comp_name}无调用权限，检查是否非法调用，caller：{caller}"
msgstr ""
"⚠️ [📡Subscription] {comp_name} has no call permission, check for illegal "
"invocation, caller: {caller}"

