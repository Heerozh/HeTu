#: hetu/headless.py:83
#, python-brace-format
msgid ""
"实例 {instance} 里不存在组件表 {comp_name}：请先启动 HeTu 服务器建表（或检查 instance / 组件名 / "
"后端配置是否指向同一个数据库）"
msgstr ""
"Component table {comp_name} does not exist in instance {instance}: please "
"start the HeTu server to create tables first (or check that the instance / "
"component name / backend configuration point to the same database)"

#: hetu/headless.py:102
#, python-brace-format
msgid "组件 {comp_name} 的本地定义与服务器表结构不一致（服务器 -> 本地）：{diff}"
msgstr ""
"The local definition of component {comp_name} does not match the server "
"table schema (server -> local): {diff}"

#: hetu/headless.py:119
#, python-brace-format
msgid ""
"组件 {comp_name} 的 cluster_id 已由 {old_id} 变为 {new_id}（服务器已迁簇），请重新 connect"
msgstr ""
"The cluster_id of component {comp_name} has changed from {old_id} to "
"{new_id} (the server has migrated clusters); please reconnect"

#: hetu/headless.py:248
#, python-brace-format
msgid ""
"组件 {name} 未在本事务声明（或不是 connect 时认下的那个类），请在 client.session(...) "
"里加上；已声明：{declared}"
msgstr ""
"Component {name} is not declared in this transaction (or is not the class "
"recognized at connect time), please add it in client.session(...); declared:"
" {declared}"

#: hetu/headless.py:295 hetu/headless.py:316
#, python-brace-format
msgid "组件 {name} 重复声明"
msgstr "Component {name} is declared more than once"

#: hetu/headless.py:309
msgid "components 不能为空：至少声明一个组件"
msgstr "components cannot be empty: declare at least one component"

#: hetu/headless.py:330
#, python-brace-format
msgid "⚠️ [🧩Headless] 组件 {name} 的默认值与服务器不同（只影响本进程 new_row 的填充值）：{diff}"
msgstr ""
"⚠️ [🧩Headless] The default value of component {name} differs from the server"
" (only affects the fill value for new_row in this process): {diff}"

#: hetu/headless.py:337
#, python-brace-format
msgid "[🧩Headless] 实例 {instance} 组件表 {name} → cluster {cid}"
msgstr ""
"[🧩Headless] Instance {instance} component table {name} → cluster {cid}"

#: hetu/headless.py:370
#, python-brace-format
msgid "组件 {name} 未在 connect(components=...) 里声明；已声明：{declared}"
msgstr ""
"Component {name} is not declared in connect(components=...); declared: "
"{declared}"

#: hetu/headless.py:376
#, python-brace-format
msgid ""
"组件 {name} 是按名字声明的，其类来自服务器 meta，请用 client.table('{name}').comp_cls 而不是本地类"
msgstr ""
"Component {name} is declared by name, and its class comes from server meta; "
"please use client.table('{name}').comp_cls instead of the local class"

#: hetu/headless.py:394
msgid "session() 至少要声明一个组件"
msgstr "session() must declare at least one component"

#: hetu/headless.py:401
#, python-brace-format
msgid "同一事务的组件必须同簇（簇由服务器 System 的引用关系决定，跨簇请拆成两个事务）：{detail}"
msgstr ""
"Components in the same transaction must belong to the same cluster (clusters"
" are determined by server System reference relationships; split cross-"
"cluster operations into two transactions): {detail}"

#: hetu/local.py:86
msgid "库里没有这张表：先用当前代码启动一次服务器（会建新表）"
msgstr ""
"The table does not exist in the database: start the server once with the "
"current code first (it will create the new table)"

#: hetu/local.py:89
msgid "本地代码与库里的表结构 / 簇不一致：先 hetu upgrade，或用与线上一致的代码版本运行"
msgstr ""
"The local code is inconsistent with the table structure / cluster in the "
"database: run hetu upgrade first, or run with a code version that matches "
"production"

#: hetu/local.py:93
#, python-brace-format
msgid "组件 {comp_name} 的表状态为 {status}，{hint}"
msgstr "The table status of Component {comp_name} is {status}, {hint}"

#: hetu/local.py:117
#, python-brace-format
msgid ""
"System {system} 是 USER 权限：生产里只有已登录连接能调，请指定玩家 id（hetu call 用 --as <uid>，代码里传 "
"caller=）"
msgstr ""
"System {system} has USER permission: in production only logged-in "
"connections can call it, please specify a player id (use --as <uid> with "
"hetu call, pass caller= in code)"

#: hetu/cli/build.py:46 hetu/local.py:128
#, python-brace-format
msgid "无法加载app文件 {app_file}"
msgstr "Unable to load app file {app_file}"

#: hetu/local.py:376
#, python-brace-format
msgid "找不到 Component：{comp}（是否在 components 中引用过？）"
msgstr "Component not found: {comp} (has it been referenced in components?)"

#: hetu/local.py:397
#, python-brace-format
msgid "{comp} 中不存在匹配 {query} 的行"
msgstr "No rows matching {query} exist in {comp}"

#: hetu/local.py:443
#, python-brace-format
msgid "{comp} 组件没有叫 {name} 的字段"
msgstr "Component {comp} has no field named {name}"

#: hetu/local.py:448
msgid "_version 由引擎管理，insert 时不能设置"
msgstr "_version is managed by the engine and cannot be set on insert"

#: hetu/local.py:509
#, python-brace-format
msgid "库文件不存在：{path}（服务器还没在这个库上启动过，或配置路径不对）"
msgstr ""
"Database file does not exist: {path} (the server has not started on this "
"database yet, or the configured path is wrong)"

#: hetu/cli/base.py:238 hetu/local.py:562
#, python-brace-format
msgid "实例 {instance} 不在配置的 INSTANCES 里：{instances}"
msgstr "Instance {instance} is not in the configured INSTANCES: {instances}"

#: hetu/manager.py:57
#, python-brace-format
msgid "Backend {backend}未找到"
msgstr "Backend {backend} not found"

#: hetu/manager.py:104
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表结构需要迁移Schema。"
msgstr "⚠️ Component {comp_name}'s table structure requires schema migration."

#: hetu/manager.py:111
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表需要迁移到新集群。"
msgstr ""
"⚠️ Component {comp_name}'s table needs to be migrated to the new cluster."

#: hetu/webext.py:91
#, python-brace-format
msgid "define_route的uri必须以'/'开头，你的：{uri}"
msgstr "The uri of define_route must start with '/', yours: {uri}"

#: hetu/webext.py:96
#, python-brace-format
msgid "define_route的uri不能占用HeTu保留的'{prefix}'路径（客户端SDK的WebSocket入口），你的：{uri}"
msgstr ""
"The uri of define_route cannot occupy the '{prefix}' path reserved by HeTu "
"(the WebSocket entry for the client SDK), yours: {uri}"

#: hetu/cli/__init__.py:70
msgid "河图数据库"
msgstr "Hetu Database"

#: hetu/cli/__init__.py:75
msgid "执行操作"
msgstr "Execute operation"

#: hetu/cli/__init__.py:103
#, python-brace-format
msgid "无法识别的参数：{extras}"
msgstr "Unrecognized arguments: {extras}"

#: hetu/cli/base.py:46
msgid "Boolean value expected."
msgstr "Boolean value expected."

#: hetu/cli/base.py:69
#, python-brace-format
msgid ""
"SQL 后端已移除，PostgreSQL / MariaDB 不再支持：'{scheme}'。开发用 sqlite:///<库文件路径>，生产用 "
"Redis"
msgstr ""
"The SQL backend has been removed; PostgreSQL / MariaDB are no longer "
"supported: '{scheme}'. Use sqlite:///<database file path> for development "
"and Redis for production"

#: hetu/cli/base.py:77
#, python-brace-format
msgid "不支持的数据库URL scheme: '{scheme}'。目前支持 redis/rediss/valkey/valkeys/sqlite"
msgstr ""
"Unsupported database URL scheme: '{scheme}'. Currently supported: "
"redis/rediss/valkey/valkeys/sqlite"

#: hetu/cli/base.py:106
#, python-brace-format
msgid "⚠️ SQLite 库文件的相对路径现在按配置文件所在目录解析：{new}。旧位置（相对当前目录）{old} 有库文件，如需沿用请把它挪过去"
msgstr ""
"⚠️ Relative paths to SQLite database files are now resolved relative to the "
"directory containing the config file: {new}. A database file exists at the "
"old location (relative to the current directory) {old}; move it there if you"
" want to keep using it"

#: hetu/cli/base.py:125
#, python-brace-format
msgid "读不了配置文件 {path}：{err}"
msgstr "Cannot read config file {path}: {err}"

#: hetu/cli/base.py:128
#, python-brace-format
msgid "配置文件 {path} 不是一个映射"
msgstr "Config file {path} is not a mapping"

#: hetu/cli/base.py:192
#, python-brace-format
msgid "命令行参数模式缺少：{missing}（或改用 --config）"
msgstr "Missing command-line arguments: {missing} (or use --config instead)"

#: hetu/cli/base.py:223
msgid ""
"找不到配置：用 --config 指定，或设环境变量 HETU_CONFIG，或在当前目录放 config.yml；也可以用 --app-file / "
"--namespace / --instance / --db 直接给出"
msgstr ""
"No configuration found: specify one with --config, set the HETU_CONFIG "
"environment variable, or place config.yml in the current directory; you can "
"also provide --app-file / --namespace / --instance / --db directly"

#: hetu/cli/base.py:233
msgid "配置里没有 INSTANCES"
msgstr "No INSTANCES in the configuration"

#: hetu/cli/base.py:247
msgid "配置"
msgstr "config"

#: hetu/cli/base.py:251
msgid "配置文件；不给时依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Config file; if not given, looks for the HETU_CONFIG environment variable, "
"then config.yml in the current directory"

#: hetu/cli/base.py:256
msgid "实例名，默认取配置里 INSTANCES 的第一个"
msgstr ""
"Instance name; defaults to the first entry in INSTANCES in the configuration"

#: hetu/cli/base.py:259
msgid "（无配置文件时）河图app的py文件"
msgstr "(when no config file is used) the py file of the 河图 app"

#: hetu/cli/base.py:262
msgid "（无配置文件时）app的namespace"
msgstr "(when no config file is used) the app namespace"

#: hetu/cli/base.py:267
msgid "（无配置文件时）后端数据库地址"
msgstr "(when no config file is used) the Backend database address"

#: hetu/cli/build.py:22
msgid "生成客户端SDK C# 类型代码"
msgstr "Generate C# type code for the client SDK"

#: hetu/cli/build.py:26
msgid "河图app的py文件"
msgstr "Python file for the Hetu app"

#: hetu/cli/build.py:33
msgid "编译app.py中哪个namespace下的数据类型"
msgstr "Which namespace's data types to compile from app.py"

#: hetu/cli/build.py:37
msgid "输出文件路径"
msgstr "Output file path"

#: hetu/cli/build.py:59
#, python-brace-format
msgid "✅ 已生成C#代码到 {output}"
msgstr "✅ C# code has been generated to {output}"

#: hetu/cli/call.py:85
#, python-brace-format
msgid ""
"第 {n} 个参数看起来是 JSON 但解析失败（PowerShell 可能吃掉了引号），改用 --args-file 或 stdin：{raw}"
msgstr ""
"Argument {n} looks like JSON but failed to parse (PowerShell may have eaten "
"the quotes); use --args-file or stdin instead: {raw}"

#: hetu/cli/call.py:104
#, python-brace-format
msgid "--args-file 读不了或不是合法 JSON：{err}"
msgstr "Cannot read --args-file, or it is not valid JSON: {err}"

#: hetu/cli/call.py:107
msgid "--args-file 的内容必须是 JSON 数组"
msgstr "The contents of --args-file must be a JSON array"

#: hetu/cli/call.py:122
#, python-brace-format
msgid "--user-data 读不了或不是合法 JSON：{err}"
msgstr "Cannot read --user-data, or it is not valid JSON: {err}"

#: hetu/cli/call.py:125
msgid "--user-data 必须是 JSON 对象"
msgstr "--user-data must be a JSON object"

#: hetu/cli/call.py:135
#, python-brace-format
msgid "System {name} 要 {low}-{high} 个参数，给了 {n} 个"
msgstr "System {name} takes {low}-{high} arguments, got {n}"

#: hetu/cli/call.py:162
#, python-brace-format
msgid "，相近的有：{close}"
msgstr ", close matches: {close}"

#: hetu/cli/call.py:164
#, python-brace-format
msgid "不存在的 System：{name}{hint}（hetu call --list 查看全部）"
msgstr "No such System: {name}{hint} (run hetu call --list to see all)"

#: hetu/cli/call.py:293
#, python-brace-format
msgid ""
"System {name} 超过 {timeout} 秒没结束，已中止。若超时发生在提交途中，提交可能已经生效：writes 里 committed 为"
" unknown 的那次，请直接查数据确认"
msgstr ""
"System {name} did not finish within {timeout} seconds and was aborted. If "
"the timeout happened mid-commit, the commit may already have taken effect: "
"for the write in writes whose committed is unknown, query the data directly "
"to confirm"

#: hetu/cli/call.py:303
#, python-brace-format
msgid "System 留下 {n} 个后台任务，CLI 退出时已取消（在服务器里它们会继续跑）"
msgstr ""
"System left {n} background tasks; they were cancelled when the CLI exited "
"(on the server they would keep running)"

#: hetu/cli/call.py:333
msgid "--args-file 与位置参数不能同时给"
msgstr "--args-file and positional arguments cannot be given together"

#: hetu/cli/call.py:348
#, python-brace-format
msgid "生产端点不会放行这个身份（caller={caller}，group={group}）调用 {permission} 权限的 System"
msgstr ""
"The production endpoint will not allow this identity (caller={caller}, "
"group={group}) to call a System requiring {permission} permission"

#: hetu/cli/call.py:359
#, python-brace-format
msgid "System {name} 读了 ctx.caller，而当前 caller 是推断出来的 0；要以玩家身份跑请用 --as <uid>"
msgstr ""
"System {name} read ctx.caller, but the current caller is the inferred 0; to "
"run as a player, use --as <uid>"

#: hetu/cli/call.py:441
msgid ""
"在本进程里直连后端调用一个 System（不经服务器），stdout 输出一行 JSON。调试用：写入与 System "
"走同一条提交路径，在线客户端照常收到推送"
msgstr ""
"Call a System directly against the Backend in this process (without going "
"through the server); prints one line of JSON to stdout. For debugging: "
"writes go through the same commit path as the System, and online clients "
"receive pushes as usual"

#: hetu/cli/call.py:449
msgid "列出全部 System（参数、权限、引用的组件、文档第一行），不连数据库"
msgstr ""
"List all Systems (arguments, permissions, referenced components, first line "
"of the docstring) without connecting to the database"

#: hetu/cli/call.py:451
msgid "身份"
msgstr "Identity"

#: hetu/cli/call.py:458
msgid ""
"以这个玩家 id 调用（ctx.caller）。USER 权限的 System 必须给；不给时按权限推断：ADMIN/GM/内部 System 用 "
"admin，EVERYBODY 用 guest"
msgstr ""
"Call as this player id (ctx.caller). Required for Systems with USER "
"permission; when omitted, inferred from the permission: admin for "
"ADMIN/GM/internal Systems, guest for EVERYBODY"

#: hetu/cli/call.py:465
msgid "ctx.group，如 gm / admin；给了 --as 时默认 guest"
msgstr "ctx.group, e.g. gm / admin; defaults to guest when --as is given"

#: hetu/cli/call.py:470
msgid "ctx.user_data（登录时写进去的数据 CLI 不知道，需要时手动给）"
msgstr ""
"ctx.user_data (the data written at login is unknown to the CLI; provide it "
"manually when needed)"

#: hetu/cli/call.py:476
msgid "从文件读参数（一个 JSON 数组），- 为 stdin；避开 PowerShell 的引号问题"
msgstr ""
"Read arguments from a file (a JSON array), - for stdin; avoids PowerShell "
"quoting issues"

#: hetu/cli/call.py:482
msgid "调用锁 uuid（call_lock 的 System），同一 uuid 只执行一次"
msgstr ""
"Call-lock uuid (for Systems with call_lock); the same uuid executes only "
"once"

#: hetu/cli/call.py:487
msgid "照常执行但不提交，输出它会写什么（写集）"
msgstr ""
"Run as usual but do not commit; print what it would write (the write set)"

#: hetu/cli/call.py:494
msgid "System 调用的超时秒数，默认 30，0 为不限"
msgstr "Timeout in seconds for the System call, default 30, 0 for unlimited"

#: hetu/cli/call.py:501 hetu/cli/data.py:398 hetu/cli/shell.py:364
msgid "stderr 上多打日志：-v 为 INFO，-vv 为 DEBUG"
msgstr "Print more logs to stderr: -v for INFO, -vv for DEBUG"

#: hetu/cli/call.py:503
msgid "System 名"
msgstr "System name"

#: hetu/cli/call.py:508
msgid "参数：按 JSON 解析，解析不了当字符串；- 开头的放在 -- 后面"
msgstr ""
"Arguments: parsed as JSON, falling back to string; put arguments starting "
"with - after --"

#: hetu/cli/call.py:518
msgid "要给 System 名（hetu call --list 查看全部）"
msgstr "The System name is required (run hetu call --list to see all)"

#: hetu/cli/console.py:67
msgid ""
"本配置禁止 hetu call / shell 写入（CLI_ALLOW_WRITE: false）：加 --dry-run 看它会写什么，或在配置里设"
" CLI_ALLOW_WRITE: true"
msgstr ""
"This configuration prohibits hetu call / shell writes (CLI_ALLOW_WRITE: "
"false): add --dry-run to see what it would write, or set CLI_ALLOW_WRITE: "
"true in the configuration"

#: hetu/cli/console.py:366
#, python-brace-format
msgid "审计日志写不进去：{path}（{err}）。可用配置 CLI_AUDIT_LOG 改路径"
msgstr ""
"Could not write the audit log: {path} ({err}). You can change the path with "
"the CLI_AUDIT_LOG configuration"

#: hetu/cli/console.py:376
#, python-brace-format
msgid "⚠️ 审计日志写不进去：{path}（{err}）"
msgstr "⚠️ Could not write the audit log: {path} ({err})"

#: hetu/cli/console.py:550
msgid "DEBUG 关闭的配置（按生产库对待）上 CLI 刚刚真写入了数据；要禁止，在配置里设 CLI_ALLOW_WRITE: false"
msgstr ""
"The CLI just actually wrote data to a configuration with DEBUG disabled "
"(treated as a production database); to prohibit this, set CLI_ALLOW_WRITE: "
"false in the configuration"

#: hetu/cli/console.py:630
msgid "Worker ID 租约丢失（本进程卡住太久被别人接手），命令已中止"
msgstr ""
"Worker ID lease lost (this process stalled too long and was taken over by "
"another), command aborted"

#: hetu/cli/console.py:653
#, python-brace-format
msgid "⚠️ 后台任务 {task} 退出时出错：{err}"
msgstr "⚠️ Background task {task} errored on exit: {err}"

#: hetu/cli/console.py:659
#, python-brace-format
msgid "⚠️ {n} 个后台任务 {timeout} 秒内没有响应取消，不再等待"
msgstr ""
"⚠️ {n} background tasks did not respond to cancellation within {timeout} "
"seconds; no longer waiting"

#: hetu/cli/console.py:672
#, python-brace-format
msgid "收尾释放租约 / 关闭连接时出错（不影响已经完成的操作）：{err}"
msgstr ""
"Error while releasing the lease / closing connections during cleanup (does "
"not affect operations that already completed): {err}"

#: hetu/cli/data.py:65
#, python-brace-format
msgid "值 {raw} 不能转换成列类型 {dtype}"
msgstr "Value {raw} cannot be converted to column type {dtype}"

#: hetu/cli/data.py:89
#, python-brace-format
msgid "分组值 {raw} 不能转换成列类型 {dtype}"
msgstr "Group value {raw} cannot be converted to column type {dtype}"

#: hetu/cli/data.py:100 hetu/cli/data.py:282
msgid "查询要写成 FIELD=VALUE，如 owner=1001"
msgstr "Query must be written as FIELD=VALUE, e.g. owner=1001"

#: hetu/cli/data.py:104
#, python-brace-format
msgid "{field} 给了不止一次"
msgstr "{field} was given more than once"

#: hetu/cli/data.py:122
#, python-brace-format
msgid ""
"组件 {comp} 的 {field} 不是 id 或带索引的字段，不能查；可查的有：{fields}（括号里是复合索引的分组列，查询时要一并用 "
"FIELD=VALUE 给出）"
msgstr ""
"{field} of component {comp} is not id or an indexed field, so it cannot be "
"queried; queryable fields: {fields} (the ones in parentheses are grouping "
"columns of a composite index, and must all be given together as FIELD=VALUE "
"when querying)"

#: hetu/cli/data.py:140
#, python-brace-format
msgid "--index {index} 要同时用 {index}=VALUE 给出查询值"
msgstr "--index {index} requires also giving the query value as {index}=VALUE"

#: hetu/cli/data.py:157
#, python-brace-format
msgid ""
"查询条件 {keys} 对不上组件 {comp} "
"的任何索引：要么只给一个带索引的字段，要么正好给出复合索引的本字段和全部分组列；可查的有：{fields}"
msgstr ""
"Query conditions {keys} do not match any index of component {comp}: either "
"give just one indexed field, or give exactly the indexed field of a "
"composite index and all of its grouping columns; queryable fields: {fields}"

#: hetu/cli/data.py:166
#, python-brace-format
msgid "查询条件 {keys} 同时匹配了 {matched} 几个索引，请用 --index 指定"
msgstr ""
"Query conditions {keys} match {matched} indexes at once, please specify with"
" --index"

#: hetu/cli/data.py:181
#, python-brace-format
msgid "{index} 是按 {columns} 分组的复合索引，要用 FIELD=VALUE 正好给出这些分组列，收到：{keys}"
msgstr ""
"{index} is a composite index grouped by {columns}; give exactly these "
"grouping columns as FIELD=VALUE, received: {keys}"

#: hetu/cli/data.py:186
#, python-brace-format
msgid "{index} 不是复合索引，多给了 {keys}"
msgstr "{index} is not a composite index, extra given: {keys}"

#: hetu/cli/data.py:390
msgid "读 master（刚写完马上读时用）；默认读 servant"
msgstr ""
"Read from master (use when reading immediately after writing); reads from "
