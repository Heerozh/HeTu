#, python-brace-format
msgid "🔔 [💾SQLite] 收到订阅更新通知: {channel_name}"
msgstr "🔔 [💾SQLite] Received subscription update notification: {channel_name}"

#: hetu/data/backend/sqlite/mq.py:213
#, python-brace-format
