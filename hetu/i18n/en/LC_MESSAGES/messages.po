#: hetu/system/definer.py:575
#, python-brace-format
msgid "System函数名过长，最大长度为{max_len}个字符"
msgstr ""
"System function name is too long. Maximum length is {max_len} characters."

#: hetu/system/definer.py:579
#, python-brace-format
msgid "System {name} 必须是异步函数(`async def ...`)"
msgstr "System {name} must be an asynchronous function (`async def ...`)."

#: hetu/system/definer.py:586
#, python-brace-format
msgid "System {name} 引用的Component必须都是同一种backend"
msgstr ""
"All Components referenced by System {name} must be of the same backend."

#: hetu/system/definer.py:609
#, python-brace-format
msgid ""
"@rate_limit/@guard 不能用于 permission=None 的 System {name}：该 System 不生成 "
"endpoint，guard 永远不会执行（继承调用也会绕过）。请设置 permission，或把 guard 挂到直接被客户端调用的外层 System"
" 上。"
msgstr ""
"@rate_limit/@guard cannot be used on System {name} with permission=None: "
"this System does not generate an endpoint, so the guard will never execute "
"(inherited calls will also bypass it). Please set permission, or attach the "
"guard to an outer System that is directly called by clients."

#: hetu/system/definer.py:633
msgid "第一个参数必须是SystemContext实例"
msgstr "The first parameter must be a SystemContext instance."

#: hetu/system/definer.py:638
#, python-brace-format
msgid "错误，ctx[{name}] 返回值不是本函数"
msgstr "Error, ctx[{name}] return value is not this function."

#: hetu/system/definer.py:642
msgid "要调用其他System必须在define_system时通过depends参数定义"
msgstr ""
"To call another System, it must be defined via the depends parameter in "
"define_system."

#: hetu/system/future.py:108
#, python-brace-format
msgid "args长度超过1024字符: {length}"
msgstr "args length exceeds 1024 characters: {length}"

#: hetu/system/future.py:114
msgid "args无法通过eval还原"
msgstr "args cannot be restored via eval"

#: hetu/system/future.py:115
msgid "args通过eval还原丢失了信息"
msgstr "args lost information when restored via eval"

#: hetu/system/future.py:117
msgid "recurring=True时timeout不能为0"
msgstr "timeout cannot be 0 when recurring=True"

#: hetu/system/future.py:123
#, python-brace-format
msgid ""
"一次性未来调用的 timeout（{timeout} 秒）不能超过 call lock 保留期 "
"CALL_LOCK_RETENTION（{retention} 秒）的一半：超时重投时锁必须还在"
msgstr ""
"The timeout for a one-off future call ({timeout} seconds) cannot exceed half"
" of the call lock retention period CALL_LOCK_RETENTION ({retention} "
"seconds): the lock must still be present when the call is redelivered after "
"a timeout"

#: hetu/system/future.py:132
#, python-brace-format
msgid "⚠️ [⚙️Future] [致命错误] 不存在的System {system}"
msgstr "⚠️ [⚙️Future] [Fatal Error] Non-existent System {system}"

#: hetu/system/future.py:139
#, python-brace-format
msgid "⚠️ [⚙️Future] [致命错误] System {system} 定义未开启 call_lock"
msgstr ""
"⚠️ [⚙️Future] [Fatal Error] System {system} definition does not have "
"call_lock enabled"

#: hetu/system/future.py:147
#, python-brace-format
msgid ""
"⚠️ [⚙️Future] [警告] 未来任务的目标 {system} "
"为{permission}权限，建议设为None防止客户端调用。且未来调用为后台任务，执行时Context无用户信息"
msgstr ""
"⚠️ [⚙️Future] [Warning] The target System {system} for the future task has "
"{permission} permission. It is recommended to set it to None to prevent "
"client calls. Also, future calls are background tasks and the Context has no"
" user information during execution."

#: hetu/system/future.py:155
#, python-brace-format
msgid "⚠️ [⚙️Future] [警告] 未来任务的目标 {system} 为{permission}权限，建议设为None防止客户端调用。"
msgstr ""
"⚠️ [⚙️Future] [Warning] The target System {system} for the future task has "
"{permission} permission. It is recommended to set it to None to prevent "
"client calls."

#: hetu/system/future.py:439
#, python-brace-format
msgid ""
"[⚙️Future] "
"正在取出的调用：{system}{args}，id={id}，recurring={recurring}，timeout={timeout}"
msgstr ""
"[⚙️Future] Fetching call: {system}{args}, id={id}, recurring={recurring}, "
"timeout={timeout}"

#: hetu/system/future.py:464
#, python-brace-format
msgid ""
"⚠️ [⚙️Future] 未来调用 {system}{args} 事务冲突重试了 {count} "
"次仍未成功，先放弃这一轮，稍后重投。最后一次冲突：{reason}。一直冲突就一直跑不成，请缩小它读写的范围，不依赖区间的 range 可以传 "
"phantom_check=False"
msgstr ""
"⚠️ [⚙️Future] Future call {system}{args} still failed after {count} "
"transaction conflict retries; giving up on this round for now and "
"redelivering later. Last conflict: {reason}. If conflicts persist, it will "
"never complete—please narrow the scope of what it reads and writes; ranges "
"that do not depend on interval data can be passed phantom_check=False"

#: hetu/system/future.py:503
#, python-brace-format
msgid "❌ [⚙️Future] 不存在的System, 检查是否代码修改删除了该System：{system}"
msgstr ""
"❌ [⚙️Future] Non-existent System, check if the code modification deleted "
"this System: {system}"

#: hetu/system/future.py:531
#, python-brace-format
msgid "❌ [⚙️Future] 未来调用System异常，调用：{system}{args}，异常：{exc}"
msgstr ""
"❌ [⚙️Future] Future System call exception, call: {system}{args}, exception: "
"{exc}"

#: hetu/system/future.py:594
#, python-brace-format
msgid "🔗 [⚙️Future] 新Task：{task_name}"
msgstr "🔗 [⚙️Future] New Task: {task_name}"

#: hetu/system/future.py:601
#, python-brace-format
msgid "🔗 [⚙️Future] 释放了 {deleted} 条过期的 call lock"
msgstr "🔗 [⚙️Future] Released {deleted} expired call locks"

#: hetu/system/future.py:660
#, python-brace-format
msgid "⚠️ [⚙️Future] Task执行异常，将再次重试：{exc}"
msgstr "⚠️ [⚙️Future] Task execution exception, will retry again: {exc}"

#: hetu/system/lock.py:94
#, python-brace-format
msgid "🔗 [⚙️Future] 释放了 {comp_name} 的 {deleted} 条过期数据"
msgstr "🔗 [⚙️Future] Released {deleted} expired data entries for {comp_name}"

#: hetu/system/startup.py:88
#, python-brace-format
msgid "🚀 [⚙️Startup] instance={instance} 执行启动System：{sys_name}"
msgstr ""
"🚀 [⚙️Startup] instance={instance} executing startup System: {sys_name}"

#: hetu/system/startup.py:99
#, python-brace-format
msgid "卡在启动System {sys_name} (instance={instance})"
msgstr "Stuck in startup System {sys_name} (instance={instance})"
