msgstr "      For production, switch to Redis in the BACKENDS of config.yml."

#: hetu/cli/init.py:536
#, python-brace-format
msgid "      uv run build 需在 .env.test 设置 {env} 指向客户端工程输出路径。"
msgstr ""
