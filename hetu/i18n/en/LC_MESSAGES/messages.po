msgstr "❌ Server startup failed, aborted, no external service provided: {err}"

#: hetu/cli/start.py:316
msgid "端口可能被系统 excludedportrange 禁用了，请用管理员执行：net stop winnatnet start winnat"
msgstr ""
"Port may be blocked by system's excludedportrange. Please run as "
"administrator: net stop winnatnet start winnat"

#: hetu/common/slowlog.py:72
#, python-brace-format
msgid ""
"⚠️ [📞慢日志] 系统 {name} 执行时间 {elapsed}秒，事务冲突次数 {retry}，平均时间 {avg_time}秒\n"
"{table}"
msgstr ""
"⚠️ [📞 Slow Log] System {name} execution time {elapsed} seconds, transaction conflict count {retry}, average time {avg_time} seconds\n"
"{table}"

#: hetu/common/slowlog.py:99
msgid "系统"
msgstr "System"

#: hetu/common/slowlog.py:99
msgid "平均时间"
msgstr "Average Time"

#: hetu/common/slowlog.py:99
msgid "平均冲突次数"
msgstr "Average Conflict Count"

#: hetu/common/snowflake_id.py:105
#, python-brace-format
msgid "Worker ID不能大于{max}或小于0"
msgstr "Worker ID cannot be greater than {max} or less than 0"

#: hetu/common/snowflake_id.py:121
#, python-brace-format
msgid "[❄️ID] 雪花ID生成器初始化完成，Worker ID: {worker_id}, last_timestamp: {ts}"
msgstr ""
"[❄️ID] Snowflake ID generator initialized successfully. Worker ID: "
"{worker_id}, last_timestamp: {ts}"

#: hetu/common/snowflake_id.py:154
#, python-brace-format
msgid ""
"[❄️ID] Worker ID {worker_id} 的租约已超出安全期 {overdue:.1f} "
"秒，拒绝发号以防产生重复ID。通常意味着本进程长时间卡住或后端连不上，Worker 会在下一次续约时重启"
msgstr ""
"[❄️ID] The lease for Worker ID {worker_id} has exceeded the safe period by "
"{overdue:.1f} seconds, refusing to issue IDs to prevent duplicate IDs. This "
"usually means this process has been stuck for a long time or the backend is "
"unreachable, and the Worker will restart at the next lease renewal."

#: hetu/common/snowflake_id.py:165
msgid "SnowflakeID 未初始化，请先调用 init() 方法。"
msgstr "SnowflakeID is not initialized. Please call the init() method first."

#: hetu/common/snowflake_id.py:175
#, python-brace-format
msgid "[❄️ID] 时钟回拨了 {ms} 毫秒。"
msgstr "[❄️ID] Clock moved backwards by {ms} milliseconds."

#: hetu/common/snowflake_id.py:210 hetu/common/snowflake_id.py:226
msgid "[❄️ID] 每毫秒只能生成有限的ID，需要休眠 1 ms"
msgstr ""
"[❄️ID] Only a limited number of IDs can be generated per millisecond. Need "
"to sleep for 1 ms"

#: hetu/common/yamlloader.py:65
#, python-brace-format, python-format
msgid "环境变量 ${%s} 未设置且无默认值，如需空值请用 ${%s:-}"
msgstr ""
"Environment variable ${%s} is not set and has no default value; for an empty"
" value, use ${%s:-}"

#: hetu/data/component.py:256
#, python-brace-format
msgid "{cname}.{pname}不是字符串属性（dtype={d}）"
msgstr "{cname}.{pname} is not a string property (dtype={d})."

#: hetu/data/component.py:341
msgid "Component重复定义"
msgstr "Component duplicate definition"

#: hetu/data/component.py:457
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是Python关键字。"
msgstr ""
"{cname}.{fname} property definition error: property name cannot be a Python "
"keyword."

#: hetu/data/component.py:463
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是C#关键字。"
msgstr ""
"{cname}.{fname} property definition error: property name cannot be a C# "
"keyword."

#: hetu/data/component.py:469
#, python-brace-format
