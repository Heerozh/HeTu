msgstr ""
"[❄️ID] Failed to write timestamp high-water mark during shutdown: {err}"

#: hetu/data/backend/snowflake_lease.py:183
#, python-brace-format
msgid "[❄️ID] 释放 Worker ID 失败，等它自己过期: {err}"
msgstr ""
"[❄️ID] Failed to release Worker ID, waiting for it to expire on its own: "
"{err}"

#: hetu/data/backend/snowflake_timestamp.py:131
#, python-brace-format
msgid "[❄️ID] 读取时间戳高水位失败，退化为固定容忍度: {err}"
msgstr ""
"[❄️ID] Failed to read timestamp high-water mark, falling back to fixed "
"tolerance: {err}"

#: hetu/data/backend/snowflake_timestamp.py:143
#, python-brace-format
msgid "[❄️ID] 记录的高水位比当前时间超前 {ms} 毫秒（上次未正常关服，或重启期间时钟回拨），已从高水位继续发号，避免ID重复"
msgstr ""
"[❄️ID] The recorded high-water mark is {ms} milliseconds ahead of the "
"current time (the server was not shut down properly last time, or the clock "
