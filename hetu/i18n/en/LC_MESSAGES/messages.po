msgstr "ℹ️ Message flow protocol: json -> {layers} -> Network"

#: hetu/cli/start.py:275
#, python-brace-format
msgid "🔑 auth_key: {key}"
msgstr "🔑 auth_key: {key}"

#: hetu/cli/start.py:277
msgid "🔑 auth_key 未设置 ⚠️ 任意 key 都能连接"
msgstr "🔑 auth_key not set ⚠️ any key can connect"

#: hetu/cli/start.py:281
msgid "⚠️⚠️⚠️ 深度Debug模式开启  ⚠️⚠️⚠️   此模式下Python协程慢90%"
msgstr ""
"⚠️⚠️⚠️ Deep Debug Mode Enabled  ⚠️⚠️⚠️   Python coroutines are 90% slower in"
" this mode."

#: hetu/cli/start.py:308
#, python-brace-format
