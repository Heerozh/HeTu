msgstr ""
"A message queue can only be attached to a connection of the same type of "
"Backend"

#: hetu/data/backend/redis/mq.py:110
#, python-brace-format
msgid "⚠️ [💾Redis] 取消订阅 {count} 个频道失败：{err}"
msgstr "⚠️ [💾Redis] Failed to unsubscribe from {count} channels: {err}"

