msgstr ""
"⌚ [📡Servidor] Falló la asignación del ID de Worker. Puede deberse a que los "
"ID de Worker se han agotado por reinicios repetidos. Reintentando después de"
" 1 segundo..."

#: hetu/data/backend/snowflake_lease.py:105
#: hetu/data/backend/snowflake_lease.py:159
#, python-brace-format
msgid "[❄️ID] 写入时间戳高水位失败，将重试: {err}"
msgstr ""
"[❄️ID] Error al escribir la marca de agua alta de timestamp, se reintentará:"
" {err}"

#: hetu/data/backend/snowflake_lease.py:121
#, python-brace-format
msgid "❌ [📡WorkerKeeper] 续约失败，将重试: {err}"
msgstr "❌ [📡WorkerKeeper] Falló la renovación, se reintentará: {err}"

#: hetu/data/backend/snowflake_lease.py:138
#, python-brace-format
msgid "❌ [📡WorkerKeeper] 续约异常，将重试: {err}"
msgstr "❌ [📡WorkerKeeper] Error en la renovación, se reintentará: {err}"

#: hetu/data/backend/snowflake_lease.py:174
#, python-brace-format
msgid "[❄️ID] 关服时写入时间戳高水位失败: {err}"
msgstr ""
"[❄️ID] Error al escribir la marca de agua alta de timestamp al apagar el "
"servidor: {err}"

#: hetu/data/backend/snowflake_lease.py:183
#, python-brace-format
msgid "[❄️ID] 释放 Worker ID 失败，等它自己过期: {err}"
msgstr ""
"[❄️ID] Error al liberar el Worker ID, se esperará a que expire por sí solo: "
"{err}"

#: hetu/data/backend/snowflake_timestamp.py:131
#, python-brace-format
msgid "[❄️ID] 读取时间戳高水位失败，退化为固定容忍度: {err}"
msgstr ""
"[❄️ID] No se pudo leer la marca de agua alta del timestamp, se usa una "
"tolerancia fija como respaldo: {err}"

#: hetu/data/backend/snowflake_timestamp.py:143
#, python-brace-format
msgid "[❄️ID] 记录的高水位比当前时间超前 {ms} 毫秒（上次未正常关服，或重启期间时钟回拨），已从高水位继续发号，避免ID重复"
msgstr ""
"[❄️ID] La marca de agua alta registrada está {ms} milisegundos por delante "
"de la hora actual (la última vez no se cerró el servidor correctamente, o el"
" reloj retrocedió durante el reinicio), por lo que se continúa emitiendo IDs"
" desde la marca de agua alta para evitar IDs duplicados"

#: hetu/data/backend/snowflake_timestamp.py:208
#, python-brace-format
msgid "[❄️ID] 补建时间戳高水位行失败（下个周期会重试）: {err}"
msgstr ""
"[❄️ID] No se pudo crear la fila de marca de agua alta de timestamp (se "
"reintentará en el próximo ciclo): {err}"

#: hetu/data/backend/worker_keeper.py:101
#, python-brace-format
msgid "Worker序号 {worker_id} 超出雪花ID上限 {max}"
msgstr ""
"El número de secuencia del Worker {worker_id} excede el límite máximo de "
"Snowflake ID {max}"

#: hetu/data/backend/worker_keeper.py:108
#, python-brace-format
msgid ""
"[❄️ID] [开发模式] 使用本机进程序号作为 Worker ID: {worker_id}。此模式只保证单机内不重复，多机部署请改用 Redis "
"后端"
msgstr ""
"[❄️ID] [modo desarrollo] Usa el número de proceso de la máquina local como "
"Worker ID: {worker_id}. Este modo solo garantiza que no haya duplicados "
"dentro de una sola máquina; para el despliegue en varias máquinas, cambia al"
" backend de Redis"

#: hetu/data/backend/redis/worker_keeper.py:179
#: hetu/data/backend/redis/worker_keeper.py:226
#: hetu/data/backend/worker_keeper.py:183
#, python-brace-format
msgid "[❄️ID] 成功获取 Worker ID: {worker_id}, 进程码: {node_id}"
msgstr ""
"[❄️ID] ID de Worker obtenido con éxito: {worker_id}, código de proceso: "
"{node_id}"

#: hetu/data/backend/worker_keeper.py:189
#, python-brace-format
msgid "并发的 hetu call / shell 进程太多：SQLite 上预留给它们的 {count} 个 Worker ID 都被占用了"
msgstr ""
"Demasiados procesos hetu call / shell concurrentes: los {count} Worker ID "
"reservados para ellos en SQLite están todos ocupados"

#: hetu/data/backend/worker_keeper.py:200
#, python-brace-format
msgid ""
"[❄️ID] 续约 Worker ID {worker_id} 失败: "
"租约已不属于本进程（可能因本进程长时间卡住导致租约过期后被其他实例接手），继续发号会产生重复雪花ID"
msgstr ""
"[❄️ID] Falló la renovación del Worker ID {worker_id}: el arrendamiento ya no"
" pertenece a este proceso (posiblemente porque este proceso estuvo bloqueado"
" mucho tiempo, el arrendamiento expiró y otra instancia lo asumió); seguir "
"emitiendo IDs produciría Snowflake IDs duplicados"

#: hetu/data/backend/worker_keeper.py:205
msgid "Worker ID 续约失败"
msgstr "Falló la renovación del Worker ID"

#: hetu/data/backend/redis/worker_keeper.py:250
#: hetu/data/backend/worker_keeper.py:219
#, python-brace-format
msgid "[❄️ID] 释放 Worker ID: {worker_id}"
msgstr "[❄️ID] Liberando ID de Worker: {worker_id}"

#: hetu/data/backend/redis/worker_keeper.py:256
#: hetu/data/backend/worker_keeper.py:223
#, python-brace-format
msgid "[❄️ID] Worker ID {worker_id} 的租约已不属于本进程，跳过释放"
msgstr ""
"[❄️ID] El arrendamiento del ID de Worker {worker_id} ya no pertenece a este "
"proceso; se omite la liberación."

#: hetu/data/backend/redis/client.py:81
msgid "Servant不允许加载Lua事务脚本，Lua事务脚本只能在Master上加载"
msgstr ""
"El Servant no permite cargar scripts de transacción Lua, los scripts de "
"transacción Lua solo se pueden cargar en el Master"

#: hetu/data/backend/redis/client.py:84
msgid "Lua事务脚本只能在Master上加载，但当前连接池中有多个服务器"
msgstr ""
"Los scripts de transacción Lua solo se pueden cargar en el Master, pero el "
"pool de conexiones actual tiene múltiples servidores"

#: hetu/data/backend/redis/client.py:120
#, python-brace-format
msgid "ℹ️ [💾Redis] master 上用不了 HSETEX（{err}），direct_set 改用同样语义的 Lua 脚本（稍慢）"
msgstr ""
"ℹ️ [💾Redis] No se puede usar HSETEX en el master ({err}), direct_set usa en "
"su lugar un script Lua con la misma semántica (más lento)"

#: hetu/data/backend/redis/client.py:139
#: hetu/data/backend/sqlite/client.py:154
msgid "Backend只能在同一个coroutine中使用。检测到调用此函数的协程发生了变化"
msgstr ""
"Backend solo se puede usar en la misma corrutina. Se detectó un cambio en la"
" corrutina que llama a esta función"

#: hetu/data/backend/redis/client.py:186
msgid "必须至少指定一个数据库连接URL"
msgstr "Debe especificar al menos una URL de conexión a la base de datos"

#: hetu/data/backend/redis/client.py:222
#, python-brace-format
msgid "无法连接到Redis数据库：{url}"
msgstr "No se puede conectar a la base de datos Redis: {url}"

#: hetu/data/backend/redis/client.py:231
#, python-brace-format
msgid ""
"Redis数据库 {url} 不支持 HELLO 命令（RESP3 握手）。通常是前面挂了不支持 RESP3 的代理层，请在 url 后追加 "
"?protocol=2 降级到 RESP2，master 和 servants 都要加。"
msgstr ""
"La base de datos Redis {url} no admite el comando HELLO (negociación RESP3)."
" Por lo general, hay una capa proxy delante que no admite RESP3; agregue "
"?protocol=2 al final de la url para degradar a RESP2, tanto en master como "
"en servants."

#: hetu/data/backend/redis/client.py:237
#, python-brace-format
msgid "连接Redis数据库 {url} 时服务端返回错误：{error}"
msgstr ""
"El servidor devolvió un error al conectar a la base de datos Redis {url}: "
"{error}"

#: hetu/data/backend/redis/client.py:338
#, python-brace-format
msgid ""
"⚠️ [💾Redis] 无权限调用数据库{url}的config_set命令，数据订阅将不起效。可手动设置配置文件：notify-keyspace-"
"events={keyspace}"
msgstr ""
"⚠️ [💾Redis] Sin permisos para llamar al comando config_set en la base de "
"datos {url}, la suscripción a datos no funcionará. Puede configurar "
"manualmente el archivo de configuración: notify-keyspace-events={keyspace}"

#: hetu/data/backend/redis/client.py:366
msgid "is_synced只能在master上调用"
msgstr "is_synced solo se puede llamar en el master"

#: hetu/data/backend/redis/client.py:545
