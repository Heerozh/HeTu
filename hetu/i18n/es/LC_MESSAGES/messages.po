#: hetu/common/snowflake_id.py:119
#, python-brace-format
msgid "Worker ID不能大于{max}或小于0"
msgstr "El ID de trabajador no puede ser mayor que {max} o menor que 0"

#: hetu/common/snowflake_id.py:137
#, python-brace-format
msgid "[❄️ID] 雪花ID生成器初始化完成，Worker ID: {worker_id}, last_timestamp: {ts}"
msgstr ""
"[❄️ID] Generador de ID de Snowflake inicializado, ID de trabajador: "
"{worker_id}, last_timestamp: {ts}"

#: hetu/common/snowflake_id.py:170
#, python-brace-format
msgid ""
"[❄️ID] Worker ID {worker_id} 的租约已超出安全期 {overdue:.1f} "
"秒，拒绝发号以防产生重复ID。通常意味着本进程长时间卡住或后端连不上，Worker 会在下一次续约时重启"
msgstr ""
"[❄️ID] El arrendamiento del ID de trabajador {worker_id} ha excedido el "
"período de seguridad en {overdue:.1f} segundos; se rechaza la emisión de IDs"
" para evitar IDs duplicados. Normalmente significa que este proceso se ha "
"bloqueado durante mucho tiempo o que no se puede conectar al Backend; el "
"worker se reiniciará en la próxima renovación."

#: hetu/common/snowflake_id.py:181
msgid "SnowflakeID 未初始化，请先调用 init() 方法。"
msgstr ""
"SnowflakeID no está inicializado, por favor llama primero al método init()."

#: hetu/common/snowflake_id.py:191
#, python-brace-format
msgid "[❄️ID] 时钟回拨了 {ms} 毫秒。"
msgstr "[❄️ID] El reloj retrocedió {ms} milisegundos."

#: hetu/common/snowflake_id.py:226 hetu/common/snowflake_id.py:242
msgid "[❄️ID] 每毫秒只能生成有限的ID，需要休眠 1 ms"
msgstr ""
"[❄️ID] Solo se pueden generar un número limitado de IDs por milisegundo, es "
"necesario dormir 1 ms"

#: hetu/common/yamlloader.py:66
#, python-brace-format, python-format
msgid "环境变量 ${%s} 未设置且无默认值，如需空值请用 ${%s:-}"
msgstr ""
"La variable de entorno ${%s} no está definida y no tiene valor "
"predeterminado; si desea un valor vacío, use ${%s:-}"

#: hetu/data/component.py:417
#, python-brace-format
msgid "{cname}.{pname}不是字符串属性（dtype={d}）"
msgstr "{cname}.{pname} no es una propiedad de tipo string (dtype={d})"

#: hetu/data/component.py:501
msgid "Component重复定义"
msgstr "Definición duplicada de Component"

#: hetu/data/component.py:634
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是Python关键字。"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, el nombre de la "
"propiedad no puede ser una palabra clave de Python."

#: hetu/data/component.py:640
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，属性名不能是C#关键字。"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, el nombre de la "
"propiedad no puede ser una palabra clave de C#."

#: hetu/data/component.py:648
#, python-brace-format
msgid ""
"{cname}.{fname}属性定义出错，属性名不能和numpy行数据的属性同名，否则row.{fname}读到的是numpy的属性而不是字段值，请换个名字。"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, el nombre de la "
"propiedad no puede coincidir con el de una propiedad de los datos de fila de"
" numpy; de lo contrario, row.{fname} leerá la propiedad de numpy en lugar "
"del valor del campo. Por favor, use otro nombre."

#: hetu/data/component.py:654
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不能为0长度。str类型请用'<U8'方式定义"
msgstr ""
"El dtype de la propiedad {cname}.{fname} no puede tener longitud 0. Para el "
"tipo str, defínalo usando el formato '<U8'."

#: hetu/data/component.py:657
#, python-brace-format
msgid "{cname}.{fname}属性的dtype不支持void类型"
msgstr "El dtype de la propiedad {cname}.{fname} no admite el tipo void."

#: hetu/data/component.py:668
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为unique时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Cuando la propiedad {cname}.{fname} se establece como unique, "
"index no puede establecerse en False."

#: hetu/data/component.py:678
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了groupby（复合索引），point_sub用不上已忽略：按组订阅本来就只被本组的写入叫醒。"
msgstr ""
"⚠️ [🛠️Define] La propiedad {cname}.{fname} tiene groupby (índice compuesto) "
"establecido; point_sub no lo usa y se ha ignorado: la suscripción por grupo,"
" de por sí, solo se activa con las escrituras de su propio grupo."

#: hetu/data/component.py:690
#, python-brace-format
msgid ""
"⚠️ [🛠️Define] "
"{cname}.{fname}属性设置了commit_seq，point_sub用不上已忽略：号要到提交时才有，发不出值频道。"
msgstr ""
"⚠️ [🛠️Define] La propiedad {cname}.{fname} tiene commit_seq establecido; "
"point_sub no lo usa y se ha ignorado: el número solo existe en el momento "
"del commit, no se puede emitir al canal de valores."

#: hetu/data/component.py:698
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了commit_seq时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Cuando la propiedad {cname}.{fname} tiene commit_seq "
"establecido, index no puede establecerse en False."

#: hetu/data/component.py:707
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置为point_sub时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Cuando la propiedad {cname}.{fname} se establece como "
"point_sub, index no puede establecerse en False."

#: hetu/data/component.py:716
#, python-brace-format
msgid "⚠️ [🛠️Define] {cname}.{fname}属性设置了groupby时，index不能设置为False。"
msgstr ""
"⚠️ [🛠️Define] Cuando la propiedad {cname}.{fname} tiene groupby establecido,"
" index no puede establecerse en False."

#: hetu/data/component.py:725
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，hidden属性不能同时设置point_sub：客户端不能按hidden属性订阅。"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, la propiedad hidden "
"no puede establecerse junto con point_sub: el cliente no puede suscribirse "
"por una propiedad hidden."

#: hetu/data/component.py:731
#, python-brace-format
msgid ""
"{cname}.{fname}默认值不能为None。所有属性都要有默认值，因为数据接口统一用c like "
"struct实现，强类型struct不接受NULL/None值。"
msgstr ""
"El valor por defecto de {cname}.{fname} no puede ser None. Todas las "
"propiedades deben tener un valor por defecto, ya que la interfaz de datos se"
" implementa de manera unificada con estructuras similares a C, y las "
"estructuras fuertemente tipadas no aceptan valores NULL/None."

#: hetu/data/component.py:742
#, python-brace-format
msgid ""
"{cname}.{fname}的default值：{default_type}({default_value})和属性dtype({dtype})不匹配"
msgstr ""
"El valor por defecto de {cname}.{fname}: {default_type}({default_value}) no "
"coincide con el dtype de la propiedad ({dtype})"

#: hetu/data/component.py:756
#, python-brace-format
msgid "{cname}权限为OWNER时，不能设置rls_compare参数"
msgstr ""
"Cuando el permiso de {cname} es OWNER, no se puede establecer el parámetro "
"rls_compare."

#: hetu/data/component.py:759
#, python-brace-format
msgid "{cname}权限为OWNER时，必须有owner属性"
msgstr ""
"Cuando el permiso de {cname} es OWNER, debe tener una propiedad owner."

#: hetu/data/component.py:766
#, python-brace-format
msgid "{cname}的owner属性必需是numeric数字(int, np.int64, ...)类型"
msgstr ""
"La propiedad owner de {cname} debe ser de tipo numérico (int, np.int64, "
"...)."

#: hetu/data/component.py:772
#, python-brace-format
msgid "{cname}权限为RLS时，必须通过rls_compare参数定义行级权限逻辑"
msgstr ""
"Cuando el permiso de {cname} es RLS, se debe definir la lógica de permisos a"
" nivel de fila mediante el parámetro rls_compare."

#: hetu/data/component.py:775
#, python-brace-format
msgid "{cname}.rls_compare参数必须全部是字符串类型"
msgstr ""
"El parámetro rls_compare de {cname} debe ser completamente de tipo string."

#: hetu/data/component.py:778
#, python-brace-format
msgid "{cname}.rls_compare参数必须只有3个元素)"
msgstr ""
"El parámetro rls_compare de {cname} debe tener exactamente 3 elementos."

#: hetu/data/component.py:782
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但operator模块没有{method}方法"
msgstr ""
"Permiso de {cname} es RLS: {rls_compare}, pero el módulo operator no tiene "
"el método {method}."

#: hetu/data/component.py:786
#, python-brace-format
msgid "{cname}权限为RLS: {rls_compare}，但表没有定义{prop}属性"
msgstr ""
"Permiso de {cname} es RLS: {rls_compare}, pero la tabla no define la "
"propiedad {prop}."

#: hetu/data/component.py:803
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列必须是本组件的字段名，不能是id、_version：{col!r}"
msgstr ""
"Error en la definición de groupby de {cname}.{fname}, la columna de "
"agrupación debe ser el nombre de un campo de este Component y no puede ser "
"id ni _version: {col!r}"

#: hetu/data/component.py:809
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，不能按自己分组"
msgstr ""
"Error en la definición de groupby de {cname}.{fname}, no se puede agrupar "
"por sí mismo"

#: hetu/data/component.py:816
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，组件没有字段`{col}`"
msgstr ""
"Error en la definición de groupby de {cname}.{fname}, el Component no tiene "
"el campo `{col}`"

#: hetu/data/component.py:822
#, python-brace-format
msgid "{cname}.{fname}的groupby定义出错，分组列`{col}`重复了"
msgstr ""
"Error en la definición de groupby de {cname}.{fname}, la columna de "
"agrupación `{col}` está duplicada"

#: hetu/data/component.py:830
#, python-brace-format
msgid ""
"{cname}.{fname}的groupby定义出错，分组列`{col}`只能是整数、str、bytes类型，不能是{dtype}：浮点按等值分组没有意义，NaN、-0.0"
" 的相等也说不清"
msgstr ""
"Error en la definición de groupby de {cname}.{fname}, la columna de "
"agrupación `{col}` solo puede ser de tipo entero, str o bytes, no {dtype}: "
"agrupar flotantes por igualdad no tiene sentido, y la igualdad de NaN y -0.0"
" tampoco está clara"

#: hetu/data/component.py:842
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，{dtype}类型不能建索引"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, el tipo {dtype} no "
"puede indexarse"

#: hetu/data/component.py:855
#, python-brace-format
msgid "{cname}定义出错，最多只能有一个commit_seq字段：{fields}"
msgstr ""
"Error en la definición de {cname}, como máximo puede haber un solo campo "
"commit_seq: {fields}"

#: hetu/data/component.py:866
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的类型只能是np.int64，不能是{dtype}"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, el tipo de "
"commit_seq solo puede ser np.int64, no {dtype}"

#: hetu/data/component.py:875
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq的default必须是0：0表示还没发号，号从1开始"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, el default de "
"commit_seq debe ser 0: 0 indica que aún no se ha asignado número, los "
"números empiezan en 1"

#: hetu/data/component.py:884
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq不能同时设置unique：组内唯一由发号保证"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, commit_seq no puede "
"establecerse junto con unique: la unicidad dentro del grupo la garantiza la "
"asignación de números"

#: hetu/data/component.py:894
#, python-brace-format
msgid "{cname}.{other}的groupby定义出错，commit_seq字段`{fname}`不能当分组列：它的号要到提交时才有"
msgstr ""
"Error en la definición de groupby de {cname}.{other}, el campo commit_seq "
"`{fname}` no puede usarse como columna de agrupación: su número solo existe "
"en el momento del commit"

#: hetu/data/component.py:912
#, python-brace-format
msgid "{cname}.{fname}属性定义出错，commit_seq字段不能用作行级权限的判定列"
msgstr ""
"Error en la definición de la propiedad {cname}.{fname}, el campo commit_seq "
"no puede usarse como columna de decisión para los permisos a nivel de fila"

#: hetu/data/component.py:921
#, python-brace-format
msgid "组件名({name})是C#关键字，请refactor。"
msgstr ""
"El nombre del componente ({name}) es una palabra clave de C#, por favor "
"refactorice."

#: hetu/data/component.py:934
#, python-brace-format
msgid "{cls_name}.{name}不是Property类型"
msgstr "{cls_name}.{name} no es del tipo Property."

#: hetu/data/component.py:944
#, python-brace-format
msgid ""
"{cls_name}.{name}属性未定义type hint。请使用以下形式，{name}: type = property_field(...)"
msgstr ""
"La propiedad {cls_name}.{name} no tiene definida la anotación de tipo (type "
"hint). Por favor, use la siguiente forma: {name}: type = property_field(...)"

#: hetu/data/component.py:949
#, python-brace-format
msgid "{cls_name}至少要有1个Property成员"
msgstr "{cls_name} debe tener al menos 1 miembro Property."

#: hetu/data/component.py:957
#, python-brace-format
msgid "{cls_name}.id是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}.id es una clave primaria interna reservada y no puede ser "
"redefinida externamente."

#: hetu/data/component.py:960
#, python-brace-format
msgid "{cls_name}._version是保留的内置主键，外部不能重定义"
msgstr ""
"{cls_name}._version es una clave primaria interna reservada y no puede ser "
"redefinida externamente."

#: hetu/data/component.py:969
#, python-brace-format
msgid "{cls_name}必须继承于BaseComponent"
msgstr "{cls_name} debe heredar de BaseComponent."

#: hetu/data/component.py:977
#, python-brace-format
msgid "{cls_name}权限定义出错，Component不能用GM权限：GM只用于System/Endpoint的调用权限"
msgstr ""
"Error en la definición de permisos de {cls_name}, Component no puede usar "
"permisos GM: GM solo se usa para los permisos de llamada de System/Endpoint"

#: hetu/data/migration.py:39
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 发现自定义迁移脚本 {file}，将调用脚本进行迁移..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Script de migración personalizado "
"encontrado {file}, se llamará al script para migrar..."

#: hetu/data/migration.py:92
#, python-brace-format
msgid ""
"  ➖ [💾MIGRATION][{comp_name}组件] 缺少迁移脚本，生成默认迁移脚本 "
"{script_path}，请根据需要修改脚本内容后再执行迁移操作..."
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Script de migración faltante, "
"generando script de migración predeterminado {script_path}. Modifique el "
"contenido del script según sea necesario antes de ejecutar la operación de "
"migración..."

#: hetu/data/migration.py:212
#, python-brace-format
msgid "  ➖ [💾MIGRATION][{comp_name}组件] 执行upgrade迁移：{module}"
msgstr ""
"  ➖ [💾MIGRATION][{comp_name} Component] Ejecutando migración upgrade: "
"{module}"

#: hetu/data/migration.py:218
#, python-brace-format
msgid "  ✔️ [💾MIGRATION][{comp_name}组件] Schema升级迁移完成，共处理{count}行"
msgstr ""
"  ✔️ [💾MIGRATION][{comp_name} Component] Migración de esquema completada, se"
" procesaron {count} filas"

#: hetu/data/migration.py:230
#, python-brace-format
msgid ""
"[💾MIGRATION][{comp_name}组件] "
"数据已经按新定义搬完，但重建索引失败：{error}。在修好之前服务器会拒绝启动：请直接修改表里的数据（比如用 TableMaintenance 的 "
"upsert_row 给重复的号重新编号），再跑一次 hetu upgrade，它会按当前定义直接重建索引"
msgstr ""
"[💾MIGRATION][{comp_name} Component] Los datos ya se migraron según la nueva "
"definición, pero falló la reconstrucción del índice: {error}. Hasta que se "
"corrija, el servidor rechazará el inicio: modifique directamente los datos "
"de la tabla (por ejemplo, use upsert_row de TableMaintenance para renumerar "
"los números duplicados) y vuelva a ejecutar hetu upgrade, que reconstruirá "
"el índice directamente según la definición actual"

#: hetu/data/migration.py:237
#, python-brace-format
msgid "  ✔️ [💾MIGRATION][{comp_name}组件] 已重建Index"
msgstr "  ✔️ [💾MIGRATION][{comp_name} Component] Índice reconstruido"

#: hetu/data/sub.py:55
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] {comp_name} 按 id 点查询的范围订阅会订整个 id "
"索引的频道：这张表每次插入、删除都会叫醒它重跑比对。按 id 订单行请用行订阅（服务端 subscribe_get，客户端 WatchRow）"
msgstr ""
"⚠️ [📡Subscription] La suscripción de rango para consultas puntuales por id "
"se suscribe al canal de todo el índice id: esta tabla despertará a la "
"suscripción en cada inserción y eliminación para volver a ejecutar la "
"comparación. Para solicitar una fila por id, use la suscripción de fila "
"(servidor subscribe_get, cliente WatchRow)"

#: hetu/data/sub.py:63
#, python-brace-format
msgid ""
"⚠️ [📡Subscription] {comp_name}.{index_name} 没有声明 "
"point_sub，点查询订阅退化为区间订阅：该索引上任何写入都会叫醒它重跑比对。需要高效点订阅请在 property_field 里加 "
"point_sub=True"
msgstr ""
"⚠️ [📡Subscription] {comp_name}.{index_name} no declaró point_sub; la "
"suscripción a consultas puntuales degenera en una suscripción de rango: "
"cualquier escritura en ese índice la despertará para volver a ejecutar la "
"comparación. Para una suscripción puntual eficiente, agregue point_sub=True "
"en property_field"

#: hetu/data/sub.py:405
