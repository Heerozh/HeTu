#: hetu/headless.py:83
#, python-brace-format
msgid ""
"实例 {instance} 里不存在组件表 {comp_name}：请先启动 HeTu 服务器建表（或检查 instance / 组件名 / "
"后端配置是否指向同一个数据库）"
msgstr ""
"No existe la tabla del Component {comp_name} en la instancia {instance}: "
"inicia primero el servidor HeTu para crear las tablas (o comprueba que "
"instance / nombre de Component / configuración de Backend apunten a la misma"
" base de datos)."

#: hetu/headless.py:102
#, python-brace-format
msgid "组件 {comp_name} 的本地定义与服务器表结构不一致（服务器 -> 本地）：{diff}"
msgstr ""
"La definición local del Component {comp_name} no coincide con la estructura "
"de la tabla del servidor (servidor -> local): {diff}"

#: hetu/headless.py:119
#, python-brace-format
msgid ""
"组件 {comp_name} 的 cluster_id 已由 {old_id} 变为 {new_id}（服务器已迁簇），请重新 connect"
msgstr ""
"El cluster_id del Component {comp_name} ha cambiado de {old_id} a {new_id} "
"(el servidor migró de cluster); vuelve a llamar a connect."

#: hetu/headless.py:248
#, python-brace-format
msgid ""
"组件 {name} 未在本事务声明（或不是 connect 时认下的那个类），请在 client.session(...) "
"里加上；已声明：{declared}"
msgstr ""
"El Component {name} no se declaró en esta transacción (o no es la clase "
"reconocida durante connect); añádelo en client.session(...); declarados: "
"{declared}"

#: hetu/headless.py:295 hetu/headless.py:316
#, python-brace-format
msgid "组件 {name} 重复声明"
msgstr "El Component {name} está declarado más de una vez."

#: hetu/headless.py:309
msgid "components 不能为空：至少声明一个组件"
msgstr "components no puede estar vacío: declara al menos un Component."

#: hetu/headless.py:330
#, python-brace-format
msgid "⚠️ [🧩Headless] 组件 {name} 的默认值与服务器不同（只影响本进程 new_row 的填充值）：{diff}"
msgstr ""
"⚠️ [🧩Headless] El valor por defecto del Component {name} difiere del "
"servidor (solo afecta al valor de relleno de new_row en este proceso): "
"{diff}"

#: hetu/headless.py:337
#, python-brace-format
msgid "[🧩Headless] 实例 {instance} 组件表 {name} → cluster {cid}"
msgstr ""
"[🧩Headless] Instancia {instance}, tabla del Component {name} → cluster {cid}"

#: hetu/headless.py:370
#, python-brace-format
msgid "组件 {name} 未在 connect(components=...) 里声明；已声明：{declared}"
msgstr ""
"El Component {name} no se declaró en connect(components=...); declarados: "
"{declared}"

#: hetu/headless.py:376
#, python-brace-format
msgid ""
"组件 {name} 是按名字声明的，其类来自服务器 meta，请用 client.table('{name}').comp_cls 而不是本地类"
msgstr ""
"El Component {name} se declaró por nombre y su clase proviene de los "
"metadatos del servidor; usa client.table('{name}').comp_cls en lugar de la "
"clase local."

#: hetu/headless.py:394
msgid "session() 至少要声明一个组件"
msgstr "session() debe declarar al menos un Component."

#: hetu/headless.py:401
#, python-brace-format
msgid "同一事务的组件必须同簇（簇由服务器 System 的引用关系决定，跨簇请拆成两个事务）：{detail}"
msgstr ""
"Todos los Component de una misma transacción deben pertenecer al mismo "
"cluster (el cluster lo determinan las relaciones de referencia de los System"
" del servidor; si abarcan varios clusters, divídelo en dos transacciones): "
"{detail}"

#: hetu/local.py:86
msgid "库里没有这张表：先用当前代码启动一次服务器（会建新表）"
msgstr ""
"La tabla no existe en la base de datos: inicia primero el servidor una vez "
"con el código actual (se creará una nueva tabla)"

#: hetu/local.py:89
msgid "本地代码与库里的表结构 / 簇不一致：先 hetu upgrade，或用与线上一致的代码版本运行"
msgstr ""
"El código local no coincide con el esquema de tablas / clúster de la base de"
" datos: primero ejecuta hetu upgrade, o ejecuta con una versión del código "
"coherente con la de producción"

#: hetu/local.py:93
#, python-brace-format
msgid "组件 {comp_name} 的表状态为 {status}，{hint}"
msgstr "El estado de la tabla del Component {comp_name} es {status}, {hint}"

#: hetu/local.py:117
#, python-brace-format
msgid ""
"System {system} 是 USER 权限：生产里只有已登录连接能调，请指定玩家 id（hetu call 用 --as <uid>，代码里传 "
"caller=）"
msgstr ""
"System {system} tiene permiso USER: en producción solo las conexiones con "
"sesión iniciada pueden llamarlo; especifica el id del jugador (en hetu call "
"usa --as <uid>, en el código pasa caller=)"

#: hetu/cli/build.py:46 hetu/local.py:128
#, python-brace-format
msgid "无法加载app文件 {app_file}"
msgstr "No se pudo cargar el archivo de aplicación {app_file}"

#: hetu/local.py:376
#, python-brace-format
msgid "找不到 Component：{comp}（是否在 components 中引用过？）"
msgstr ""
"No se encuentra el Component: {comp} (¿está referenciado en components?)"

#: hetu/local.py:397
#, python-brace-format
msgid "{comp} 中不存在匹配 {query} 的行"
msgstr "No hay filas en {comp} que coincidan con {query}"

#: hetu/local.py:443
#, python-brace-format
msgid "{comp} 组件没有叫 {name} 的字段"
msgstr "El Component {comp} no tiene un campo llamado {name}"

#: hetu/local.py:448
msgid "_version 由引擎管理，insert 时不能设置"
msgstr "_version lo gestiona el motor; no se puede establecer al hacer insert"

#: hetu/local.py:509
#, python-brace-format
msgid "库文件不存在：{path}（服务器还没在这个库上启动过，或配置路径不对）"
msgstr ""
"El archivo de la base de datos no existe: {path} (el servidor aún no se ha "
"iniciado con esta base de datos, o la ruta configurada es incorrecta)"

#: hetu/cli/base.py:238 hetu/local.py:562
#, python-brace-format
msgid "实例 {instance} 不在配置的 INSTANCES 里：{instances}"
msgstr ""
"La instancia {instance} no está en INSTANCES de la configuración: "
"{instances}"

#: hetu/manager.py:57
#, python-brace-format
msgid "Backend {backend}未找到"
msgstr "Backend {backend} no encontrado"

#: hetu/manager.py:104
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表结构需要迁移Schema。"
msgstr ""
"⚠️  El esquema de la tabla del componente {comp_name} necesita migración."

#: hetu/manager.py:111
#, python-brace-format
msgid "⚠️  组件 {comp_name} 的表需要迁移到新集群。"
msgstr ""
"⚠️  La tabla del componente {comp_name} necesita migrar al nuevo clúster."

#: hetu/webext.py:91
#, python-brace-format
msgid "define_route的uri必须以'/'开头，你的：{uri}"
msgstr "El uri de define_route debe comenzar con '/', el tuyo: {uri}"

#: hetu/webext.py:96
#, python-brace-format
msgid "define_route的uri不能占用HeTu保留的'{prefix}'路径（客户端SDK的WebSocket入口），你的：{uri}"
msgstr ""
"El uri de define_route no puede ocupar la ruta '{prefix}' reservada por HeTu"
" (punto de entrada WebSocket del SDK del cliente), el tuyo: {uri}"

#: hetu/cli/__init__.py:70
msgid "河图数据库"
msgstr "Base de datos de Hetu"

#: hetu/cli/__init__.py:75
msgid "执行操作"
msgstr "Ejecutar operación"

#: hetu/cli/__init__.py:103
#, python-brace-format
msgid "无法识别的参数：{extras}"
msgstr "Argumento no reconocido: {extras}"

#: hetu/cli/base.py:46
msgid "Boolean value expected."
msgstr "Se esperaba un valor booleano."

#: hetu/cli/base.py:69
#, python-brace-format
msgid ""
"SQL 后端已移除，PostgreSQL / MariaDB 不再支持：'{scheme}'。开发用 sqlite:///<库文件路径>，生产用 "
"Redis"
msgstr ""
"El Backend SQL se ha eliminado; PostgreSQL / MariaDB ya no son compatibles: "
"'{scheme}'. Para desarrollo, usa sqlite:///<ruta del archivo de base de "
"datos>; para producción, usa Redis"

#: hetu/cli/base.py:77
#, python-brace-format
msgid "不支持的数据库URL scheme: '{scheme}'。目前支持 redis/rediss/valkey/valkeys/sqlite"
msgstr ""
"Esquema de URL de base de datos no admitido: '{scheme}'. Actualmente se "
"admiten redis/rediss/valkey/valkeys/sqlite"

#: hetu/cli/base.py:106
#, python-brace-format
msgid "⚠️ SQLite 库文件的相对路径现在按配置文件所在目录解析：{new}。旧位置（相对当前目录）{old} 有库文件，如需沿用请把它挪过去"
msgstr ""
"⚠️ La ruta relativa del archivo de base de datos SQLite ahora se resuelve "
"respecto al directorio donde está el archivo de configuración: {new}. Hay un"
" archivo de base de datos en la ubicación anterior (relativa al directorio "
"actual) {old}; si quieres seguir usándolo, muévelo a la nueva ubicación"

#: hetu/cli/base.py:125
#, python-brace-format
msgid "读不了配置文件 {path}：{err}"
msgstr "No se puede leer el archivo de configuración {path}: {err}"

#: hetu/cli/base.py:128
#, python-brace-format
msgid "配置文件 {path} 不是一个映射"
msgstr "El archivo de configuración {path} no es un mapeo"

#: hetu/cli/base.py:192
#, python-brace-format
msgid "命令行参数模式缺少：{missing}（或改用 --config）"
msgstr ""
"Faltan en el modo de argumentos de línea de comandos: {missing} (o usa "
"--config en su lugar)"

#: hetu/cli/base.py:223
msgid ""
"找不到配置：用 --config 指定，或设环境变量 HETU_CONFIG，或在当前目录放 config.yml；也可以用 --app-file / "
"--namespace / --instance / --db 直接给出"
msgstr ""
"No se encuentra la configuración: especifícala con --config, o establece la "
"variable de entorno HETU_CONFIG, o coloca config.yml en el directorio "
"actual; también puedes indicarla directamente con --app-file / --namespace /"
" --instance / --db"

#: hetu/cli/base.py:233
msgid "配置里没有 INSTANCES"
msgstr "No hay INSTANCES en la configuración"

#: hetu/cli/base.py:247
msgid "配置"
msgstr "Configuración"

#: hetu/cli/base.py:251
msgid "配置文件；不给时依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Archivo de configuración; si no se indica, se busca en orden la variable de "
"entorno HETU_CONFIG y config.yml en el directorio actual"

#: hetu/cli/base.py:256
msgid "实例名，默认取配置里 INSTANCES 的第一个"
msgstr ""
"Nombre de la instancia; por defecto, se toma el primero de INSTANCES en la "
"configuración"

#: hetu/cli/base.py:259
msgid "（无配置文件时）河图app的py文件"
msgstr "(cuando no hay archivo de configuración) archivo .py de la app hetu"

#: hetu/cli/base.py:262
msgid "（无配置文件时）app的namespace"
msgstr "(cuando no hay archivo de configuración) namespace de la app"

#: hetu/cli/base.py:267
msgid "（无配置文件时）后端数据库地址"
msgstr ""
"(cuando no hay archivo de configuración) dirección de la base de datos del "
"Backend"

#: hetu/cli/build.py:22
msgid "生成客户端SDK C# 类型代码"
msgstr "Generar código de tipos C# para el SDK del cliente"

#: hetu/cli/build.py:26
msgid "河图app的py文件"
msgstr "Archivo Python de la aplicación Hetu"

#: hetu/cli/build.py:33
msgid "编译app.py中哪个namespace下的数据类型"
msgstr "Qué namespace en app.py compilar para los tipos de datos"

#: hetu/cli/build.py:37
msgid "输出文件路径"
msgstr "Ruta del archivo de salida"

#: hetu/cli/build.py:59
#, python-brace-format
msgid "✅ 已生成C#代码到 {output}"
msgstr "✅ Código C# generado en {output}"

#: hetu/cli/call.py:85
#, python-brace-format
msgid ""
"第 {n} 个参数看起来是 JSON 但解析失败（PowerShell 可能吃掉了引号），改用 --args-file 或 stdin：{raw}"
msgstr ""
"El argumento {n} parece JSON pero no se pudo analizar (puede que PowerShell "
"se haya comido las comillas); usa --args-file o stdin: {raw}"

#: hetu/cli/call.py:104
#, python-brace-format
msgid "--args-file 读不了或不是合法 JSON：{err}"
msgstr "No se pudo leer --args-file o no es JSON válido: {err}"

#: hetu/cli/call.py:107
msgid "--args-file 的内容必须是 JSON 数组"
msgstr "El contenido de --args-file debe ser un array JSON"

#: hetu/cli/call.py:122
#, python-brace-format
msgid "--user-data 读不了或不是合法 JSON：{err}"
msgstr "No se pudo leer --user-data o no es JSON válido: {err}"

#: hetu/cli/call.py:125
msgid "--user-data 必须是 JSON 对象"
msgstr "--user-data debe ser un objeto JSON"

#: hetu/cli/call.py:135
#, python-brace-format
msgid "System {name} 要 {low}-{high} 个参数，给了 {n} 个"
msgstr ""
"System {name} requiere entre {low} y {high} argumentos, se proporcionaron "
"{n}"

#: hetu/cli/call.py:162
#, python-brace-format
msgid "，相近的有：{close}"
msgstr ", los más parecidos son: {close}"

#: hetu/cli/call.py:164
#, python-brace-format
msgid "不存在的 System：{name}{hint}（hetu call --list 查看全部）"
msgstr ""
"System inexistente: {name}{hint} (consulta todos con hetu call --list)"

#: hetu/cli/call.py:293
#, python-brace-format
msgid ""
"System {name} 超过 {timeout} 秒没结束，已中止。若超时发生在提交途中，提交可能已经生效：writes 里 committed 为"
" unknown 的那次，请直接查数据确认"
msgstr ""
"System {name} superó los {timeout} segundos sin terminar y se abortó. Si el "
"tiempo de espera se agotó durante el envío, es posible que la confirmación "
"ya se haya aplicado: para la entrada de writes cuyo committed sea unknown, "
"consulta los datos directamente para confirmarlo"

#: hetu/cli/call.py:303
#, python-brace-format
msgid "System 留下 {n} 个后台任务，CLI 退出时已取消（在服务器里它们会继续跑）"
msgstr ""
"System dejó {n} tareas en segundo plano, que se cancelaron al salir de la "
"CLI (en el servidor seguirían ejecutándose)"

#: hetu/cli/call.py:333
msgid "--args-file 与位置参数不能同时给"
msgstr "--args-file y los argumentos posicionales no se pueden usar a la vez"

#: hetu/cli/call.py:348
#, python-brace-format
msgid "生产端点不会放行这个身份（caller={caller}，group={group}）调用 {permission} 权限的 System"
msgstr ""
"El endpoint de producción no permitirá que esta identidad (caller={caller}, "
"group={group}) llame a un System con el permiso {permission}"

#: hetu/cli/call.py:359
#, python-brace-format
msgid "System {name} 读了 ctx.caller，而当前 caller 是推断出来的 0；要以玩家身份跑请用 --as <uid>"
msgstr ""
"System {name} leyó ctx.caller, pero el caller actual es el 0 inferido; para "
"ejecutar como jugador usa --as <uid>"

#: hetu/cli/call.py:441
msgid ""
"在本进程里直连后端调用一个 System（不经服务器），stdout 输出一行 JSON。调试用：写入与 System "
"走同一条提交路径，在线客户端照常收到推送"
msgstr ""
"Llama a un System directamente contra el Backend en este proceso (sin pasar "
"por el servidor); stdout emite una línea de JSON. Para depuración: las "
"escrituras siguen la misma ruta de confirmación que System y los clientes en"
" línea reciben las notificaciones con normalidad"

#: hetu/cli/call.py:449
msgid "列出全部 System（参数、权限、引用的组件、文档第一行），不连数据库"
msgstr ""
"Lista todos los System (argumentos, permisos, Componentes referenciados, "
"primera línea de la documentación), sin conectar a la base de datos"

#: hetu/cli/call.py:451
msgid "身份"
msgstr "Identidad"

#: hetu/cli/call.py:458
msgid ""
"以这个玩家 id 调用（ctx.caller）。USER 权限的 System 必须给；不给时按权限推断：ADMIN/GM/内部 System 用 "
"admin，EVERYBODY 用 guest"
msgstr ""
"Llamar con este id de jugador (ctx.caller). Obligatorio para los System con "
"permiso USER; si se omite, se infiere según el permiso: los System "
"ADMIN/GM/internos usan admin, EVERYBODY usa guest"

#: hetu/cli/call.py:465
msgid "ctx.group，如 gm / admin；给了 --as 时默认 guest"
msgstr "ctx.group, p. ej. gm / admin; si se indica --as, por defecto guest"

#: hetu/cli/call.py:470
msgid "ctx.user_data（登录时写进去的数据 CLI 不知道，需要时手动给）"
msgstr ""
"ctx.user_data (los datos que se escriben al iniciar sesión y que la CLI "
"desconoce; proporciónalos manualmente cuando sea necesario)"

#: hetu/cli/call.py:476
msgid "从文件读参数（一个 JSON 数组），- 为 stdin；避开 PowerShell 的引号问题"
msgstr ""
"Leer los argumentos desde un archivo (un array JSON), con - para stdin; "
"evita los problemas de comillas de PowerShell"

#: hetu/cli/call.py:482
msgid "调用锁 uuid（call_lock 的 System），同一 uuid 只执行一次"
msgstr ""
"uuid del bloqueo de llamada (el System call_lock); el mismo uuid solo se "
"ejecuta una vez"

#: hetu/cli/call.py:487
msgid "照常执行但不提交，输出它会写什么（写集）"
msgstr ""
"Ejecutar con normalidad pero sin confirmar; muestra lo que escribiría "
"(conjunto de escrituras)"

#: hetu/cli/call.py:494
msgid "System 调用的超时秒数，默认 30，0 为不限"
msgstr ""
"Segundos de tiempo de espera para la llamada a System, por defecto 30, 0 "
"significa sin límite"

#: hetu/cli/call.py:501 hetu/cli/data.py:398 hetu/cli/shell.py:364
msgid "stderr 上多打日志：-v 为 INFO，-vv 为 DEBUG"
msgstr "Mostrar más registros en stderr: -v para INFO, -vv para DEBUG"

#: hetu/cli/call.py:503
msgid "System 名"
msgstr "Nombre del System"

#: hetu/cli/call.py:508
msgid "参数：按 JSON 解析，解析不了当字符串；- 开头的放在 -- 后面"
msgstr ""
"Argumentos: se analizan como JSON; si no se puede analizar, se tratan como "
"cadena; los que empiezan por - van después de --"

#: hetu/cli/call.py:518
msgid "要给 System 名（hetu call --list 查看全部）"
msgstr ""
"Debes indicar el nombre del System (consulta todos con hetu call --list)"

#: hetu/cli/console.py:67
msgid ""
"本配置禁止 hetu call / shell 写入（CLI_ALLOW_WRITE: false）：加 --dry-run 看它会写什么，或在配置里设"
" CLI_ALLOW_WRITE: true"
msgstr ""
"Esta configuración prohíbe que hetu call / shell escriba (CLI_ALLOW_WRITE: "
"false): añade --dry-run para ver qué escribiría, o establece "
"CLI_ALLOW_WRITE: true en la configuración"

#: hetu/cli/console.py:366
#, python-brace-format
msgid "审计日志写不进去：{path}（{err}）。可用配置 CLI_AUDIT_LOG 改路径"
msgstr ""
"No se puede escribir el registro de auditoría: {path} ({err}). Puedes "
"cambiar la ruta con la configuración CLI_AUDIT_LOG"

#: hetu/cli/console.py:376
#, python-brace-format
msgid "⚠️ 审计日志写不进去：{path}（{err}）"
msgstr "⚠️ No se puede escribir el registro de auditoría: {path} ({err})"

#: hetu/cli/console.py:550
msgid "DEBUG 关闭的配置（按生产库对待）上 CLI 刚刚真写入了数据；要禁止，在配置里设 CLI_ALLOW_WRITE: false"
msgstr ""
"El CLI acaba de escribir datos realmente en una configuración con DEBUG "
"desactivado (tratada como base de datos de producción); para prohibirlo, "
"establece CLI_ALLOW_WRITE: false en la configuración"

#: hetu/cli/console.py:630
msgid "Worker ID 租约丢失（本进程卡住太久被别人接手），命令已中止"
msgstr ""
"Se perdió el lease de Worker ID (este proceso estuvo bloqueado demasiado "
"tiempo y otro lo asumió), el comando se ha abortado"

#: hetu/cli/console.py:653
#, python-brace-format
msgid "⚠️ 后台任务 {task} 退出时出错：{err}"
msgstr "⚠️ Error al finalizar la tarea en segundo plano {task}: {err}"

#: hetu/cli/console.py:659
#, python-brace-format
msgid "⚠️ {n} 个后台任务 {timeout} 秒内没有响应取消，不再等待"
msgstr ""
"⚠️ {n} tareas en segundo plano no respondieron a la cancelación en {timeout}"
" segundos; se deja de esperar"

#: hetu/cli/console.py:672
#, python-brace-format
msgid "收尾释放租约 / 关闭连接时出错（不影响已经完成的操作）：{err}"
msgstr ""
"Error al liberar el lease / cerrar la conexión durante la limpieza final (no"
" afecta a las operaciones ya completadas): {err}"

#: hetu/cli/data.py:65
#, python-brace-format
msgid "值 {raw} 不能转换成列类型 {dtype}"
msgstr "El valor {raw} no se puede convertir al tipo de columna {dtype}"

#: hetu/cli/data.py:89
#, python-brace-format
msgid "分组值 {raw} 不能转换成列类型 {dtype}"
msgstr ""
"El valor de agrupación {raw} no se puede convertir al tipo de columna "
"{dtype}"

#: hetu/cli/data.py:100 hetu/cli/data.py:282
msgid "查询要写成 FIELD=VALUE，如 owner=1001"
msgstr "La consulta debe escribirse como FIELD=VALUE, p. ej. owner=1001"

#: hetu/cli/data.py:104
#, python-brace-format
msgid "{field} 给了不止一次"
msgstr "{field} se indicó más de una vez"

#: hetu/cli/data.py:122
#, python-brace-format
msgid ""
"组件 {comp} 的 {field} 不是 id 或带索引的字段，不能查；可查的有：{fields}（括号里是复合索引的分组列，查询时要一并用 "
"FIELD=VALUE 给出）"
msgstr ""
"El campo {field} del Component {comp} no es id ni un campo indexado, no se "
"puede consultar; se puede consultar por: {fields} (entre paréntesis están "
"las columnas de agrupación de los índices compuestos, que también deben "
"indicarse con FIELD=VALUE al consultar)"

#: hetu/cli/data.py:140
#, python-brace-format
msgid "--index {index} 要同时用 {index}=VALUE 给出查询值"
msgstr ""
"--index {index} requiere indicar también el valor de consulta con "
"{index}=VALUE"

#: hetu/cli/data.py:157
#, python-brace-format
msgid ""
"查询条件 {keys} 对不上组件 {comp} "
"的任何索引：要么只给一个带索引的字段，要么正好给出复合索引的本字段和全部分组列；可查的有：{fields}"
msgstr ""
"Las condiciones de consulta {keys} no coinciden con ningún índice del "
"Component {comp}: o bien se indica un solo campo indexado, o bien se indican"
" exactamente el campo propio del índice compuesto y todas sus columnas de "
"agrupación; se puede consultar por: {fields}"

#: hetu/cli/data.py:166
#, python-brace-format
msgid "查询条件 {keys} 同时匹配了 {matched} 几个索引，请用 --index 指定"
msgstr ""
"Las condiciones de consulta {keys} coinciden con varios índices a la vez "
"({matched}), especifíquelo con --index"

#: hetu/cli/data.py:181
#, python-brace-format
msgid "{index} 是按 {columns} 分组的复合索引，要用 FIELD=VALUE 正好给出这些分组列，收到：{keys}"
msgstr ""
"{index} es un índice compuesto agrupado por {columns}; hay que indicar "
"exactamente esas columnas de agrupación con FIELD=VALUE, recibidas: {keys}"

#: hetu/cli/data.py:186
#, python-brace-format
msgid "{index} 不是复合索引，多给了 {keys}"
msgstr "{index} no es un índice compuesto, se indicaron de más: {keys}"

#: hetu/cli/data.py:390
msgid "读 master（刚写完马上读时用）；默认读 servant"
msgstr ""
"Leer del master (para leer justo después de escribir); por defecto lee del "
"servant"

#: hetu/cli/data.py:392
msgid "只输出这些列，逗号分隔"
msgstr "Mostrar solo estas columnas, separadas por comas"

#: hetu/cli/data.py:414
msgid ""
"按 id 或带索引的字段读一行组件数据（不做 RLS），stdout 输出一行 JSON；不加载 app，schema 取自库里的表 meta"
msgstr ""
"Leer una fila de datos de un Component por id o por un campo indexado (sin "
"RLS), imprime una línea JSON en stdout; no carga la app, el esquema se toma "
"del meta de la tabla en el Backend"

#: hetu/cli/data.py:422
msgid "列出组件、字段与索引（加载 app，不连数据库）"
msgstr ""
"Listar Component, campos e índices (carga la app, no se conecta al Backend)"

#: hetu/cli/data.py:427
msgid "FIELD=VALUE 同时匹配了几个复合索引时，指定按哪个索引查（其余 FIELD=VALUE 是它的分组值）"
msgstr ""
"Cuando FIELD=VALUE coincide con varios índices compuestos, especificar por "
"cuál índice consultar (el resto de FIELD=VALUE son sus valores de "
"agrupación)"

#: hetu/cli/data.py:437
msgid "一个带索引的字段，如 owner=1001；复合索引要同时给出全部分组列，如 name=abc zone=3"
msgstr ""
"Un campo indexado, como owner=1001; para un índice compuesto hay que indicar"
" todas las columnas de agrupación, como name=abc zone=3"

#: hetu/cli/data.py:450
msgid "要给组件名和 FIELD=VALUE（hetu get --list 查看组件）"
msgstr ""
"Se requiere el nombre del Component y FIELD=VALUE (use hetu get --list para "
"ver los Component)"

#: hetu/cli/data.py:469
msgid ""
"按带索引的字段读一个区间的组件数据（不做 RLS），stdout 输出一行 JSON；省略 RIGHT 即精确匹配 LEFT，( / [ 前缀表示开 /"
" 闭区间"
msgstr ""
"Leer un rango de datos de un Component por un campo indexado (sin RLS), "
"imprime una línea JSON en stdout; si se omite RIGHT se hace coincidencia "
"exacta con LEFT; el prefijo ( / [ indica intervalo abierto / cerrado"

#: hetu/cli/data.py:478
msgid "最多返回多少行，默认 10，-1 为不限"
msgstr "Número máximo de filas a devolver, por defecto 10, -1 sin límite"

#: hetu/cli/data.py:480
msgid "降序"
msgstr "Orden descendente"

#: hetu/cli/data.py:486
msgid "复合索引的分组值，每个分组列给一次，如 --group zone=3"
msgstr ""
"Valor de agrupación de un índice compuesto, una vez por cada columna de "
"agrupación, p. ej. --group zone=3"

#: hetu/cli/init.py:325
msgid "❌ 未找到 uv 命令，请先安装 uv：https://docs.astral.sh/uv/"
msgstr ""
"❌ No se encontró el comando uv. Instale uv primero: "
"https://docs.astral.sh/uv/"

#: hetu/cli/init.py:329
#, python-brace-format
msgid "❌ uv {cmd} 执行失败（退出码 {code}）"
msgstr "❌ Falló la ejecución de uv {cmd} (código de salida {code})"

#: hetu/cli/init.py:355
#, python-brace-format
msgid "ℹ️  {path} 已存在，跳过"
msgstr "ℹ️  {path} ya existe, se omite"

#: hetu/cli/init.py:359
#, python-brace-format
msgid "✅ 已创建 {path}"
msgstr "✅ Se creó {path}"

#: hetu/cli/init.py:374
msgid "ℹ️  pyproject.toml 已注册 build/dev 命令，跳过"
msgstr ""
"ℹ️  pyproject.toml ya tiene registrados los comandos build/dev, se omite"

#: hetu/cli/init.py:377
msgid "⚠️  pyproject.toml 已有 build/dev 命令定义，跳过注册，请手动检查"
msgstr ""
"⚠️  pyproject.toml ya contiene definiciones de los comandos build/dev; se "
"omite el registro, revíselo manualmente"

#: hetu/cli/init.py:391
msgid "✅ 已在 pyproject.toml 注册 build/dev 命令"
msgstr "✅ Se registraron los comandos build/dev en pyproject.toml"

#: hetu/cli/init.py:401
#, python-brace-format
msgid "✅ 已将 {entry} 加入 .gitignore"
msgstr "✅ Se añadió {entry} a .gitignore"

#: hetu/cli/init.py:411
msgid "初始化一个新的河图项目"
msgstr "Inicializar un nuevo proyecto hetu"

#: hetu/cli/init.py:416
msgid "项目目录名，省略则在当前目录初始化"
msgstr ""
"Nombre del directorio del proyecto. Si se omite, se inicializa en el "
"directorio actual."

#: hetu/cli/init.py:421
msgid "项目使用的 Python 版本"
msgstr "Versión de Python a utilizar en el proyecto"

#: hetu/cli/init.py:431
msgid "ℹ️  检测到 pyproject.toml，跳过 uv init"
msgstr "ℹ️  Se detectó pyproject.toml, se omite uv init"

#: hetu/cli/init.py:504
msgid "ℹ️  config.yml 已存在，跳过"
msgstr "ℹ️  config.yml ya existe, se omite"

#: hetu/cli/init.py:508
msgid "✅ 已创建 config.yml"
msgstr "✅ Se creó config.yml"

#: hetu/cli/init.py:521
msgid "ℹ️  hetudb 已在依赖中，跳过 uv add"
msgstr "ℹ️  hetudb ya está en las dependencias, se omite uv add"

#: hetu/cli/init.py:527
msgid "🎉 项目已就绪！下一步："
msgstr "🎉 ¡Proyecto listo! Siguientes pasos:"

#: hetu/cli/init.py:531
msgid "# 强制迁移并启动开发服务器（含客户端代码生成）"
msgstr ""
"# Forzar la migración e iniciar el servidor de desarrollo (incluida la "
"generación de código del cliente)"

#: hetu/cli/init.py:533
msgid "# 仅生成客户端 C# 组件代码"
msgstr "# Solo generar el código de componentes C# del cliente"

#: hetu/cli/init.py:534
msgid "# 仅启动服务"
msgstr "# Solo iniciar el servicio"

#: hetu/cli/init.py:536
msgid "提示：默认使用 SQLite 调试数据库，文件会自动创建，无需额外服务。"
msgstr ""
"Nota: Por defecto se utiliza la base de datos de depuración SQLite, el "
"archivo se creará automáticamente, sin necesidad de servicios adicionales."

#: hetu/cli/init.py:537
msgid "      生产环境请在 config.yml 的 BACKENDS 中改用 Redis。"
msgstr ""
"      Para entornos de producción, modifique BACKENDS en config.yml para "
"usar Redis."

#: hetu/cli/init.py:540
#, python-brace-format
msgid "      uv run build 需在 .env.test 设置 {env} 指向客户端工程输出路径。"
msgstr ""
"      uv run build requiere configurar {env} en .env.test para que apunte a "
"la ruta de salida del proyecto de cliente."

#: hetu/cli/init.py:544
#, python-brace-format
msgid "      已写入 .claude/skills/{name}/，供编码 AI 了解 HeTu 用法。"
msgstr ""
"      Se escribió en .claude/skills/{name}/ para que la IA de codificación "
"conozca el uso de HeTu."

#: hetu/cli/migrate.py:37
msgid ""
"在数据库执行Schema升级脚本,如果没有则创建，如果无变更则跳过。同时还会进行临时表的清空。应该在CI/CD流程中，每次启动服务器前执行一次。"
msgstr ""
"Ejecuta los scripts de actualización del esquema en la base de datos. Si no "
"existen, los crea; si no hay cambios, los omite. También limpia las tablas "
"temporales. Debe ejecutarse una vez antes de cada inicio del servidor en el "
"flujo de CI/CD."

#: hetu/cli/migrate.py:44 hetu/cli/start.py:95
msgid "后端数据库地址，默认 redis://127.0.0.1:6379/0"
msgstr ""
"Dirección de la base de datos Backend, por defecto redis://127.0.0.1:6379/0"

#: hetu/cli/migrate.py:48
msgid "河图app的py文件，默认 app.py"
msgstr "Archivo py de la app hetu, por defecto app.py"

#: hetu/cli/migrate.py:54 hetu/cli/start.py:84
msgid "启动app.py中哪个namespace下的System"
msgstr "Qué System bajo qué namespace iniciar en app.py"

#: hetu/cli/migrate.py:57 hetu/cli/start.py:87
msgid "实例名称，每个实例是一个副本"
msgstr "Nombre de la instancia, cada instancia es una réplica"

#: hetu/cli/migrate.py:63
msgid "通过yml配置文件读取后端数据库地址。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"Lee la dirección de la base de datos Backend desde un archivo de "
"configuración yml. Si no se proporciona y no se usan parámetros de línea de "
"comandos, busca sucesivamente la variable de entorno HETU_CONFIG y el "
"config.yml del directorio actual"

#: hetu/cli/migrate.py:72
msgid "自动确认数据备份提示"
msgstr "Confirmar automáticamente el aviso de copia de seguridad de datos."

#: hetu/cli/migrate.py:78
msgid "强制执行升级迁移，丢弃无法迁移的数据。请勿在生产环境使用此选项！"
msgstr ""
"Forzar la migración de actualización, descartando datos que no se puedan "
"migrar. ¡No uses esta opción en entornos de producción!"

#: hetu/cli/migrate.py:85
msgid "跳过重建索引。默认每次升级都按行数据重建持久组件的索引、修掉索引残留，数据量大时较慢"
msgstr ""
"Omite la reconstrucción de índices. Por defecto, en cada actualización se "
"reconstruyen los índices de los Component persistentes a partir de los datos"
" de las filas y se corrigen los índices residuales; es más lento cuando el "
"volumen de datos es grande"

#: hetu/cli/migrate.py:121
#, python-brace-format
msgid ""
"❌ 检测到还有服务器在运行（持有 Worker ID "
"租约：{ids}），请先停服再升级：迁移、清空易失表、重建索引在服务器运行时执行都会写坏数据。服务器是异常退出的，等租约过期（最多 {ttl} "
"秒）后再试。"
msgstr ""
"❌ Se detectaron servidores aún en ejecución (con arrendamiento de Worker ID:"
" {ids}); detén los servidores antes de actualizar: ejecutar la migración, "
"vaciar las tablas volátiles o reconstruir los índices mientras los "
"servidores están en ejecución corrompe los datos. Si los servidores "
"terminaron de forma anómala, espera a que expire el arrendamiento (máximo "
"{ttl} segundos) e inténtalo de nuevo."

#: hetu/cli/migrate.py:129
#, python-brace-format
msgid "   其中 {ids} 是 hetu call / shell 进程，等它们结束即可（异常退出的最多 {ttl} 秒过期）。"
msgstr ""
"   Donde {ids} son los procesos de hetu call / shell; basta con esperar a "
"que terminen (los que terminaron de forma anómala expiran en un máximo de "
"{ttl} segundos)."

#: hetu/cli/migrate.py:147
msgid "⚠️  升级数据库表结构可能会导致数据丢失，请确保已备份数据。确认继续请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Actualizar la estructura de las tablas de la base de datos puede causar "
"pérdida de datos. Asegúrate de tener una copia de seguridad. Para confirmar "
"y continuar, escribe 'y'; para cancelar, escribe cualquier otra tecla y "
"presiona Enter:"

#: hetu/cli/migrate.py:152 hetu/cli/migrate.py:179
msgid "❌  升级迁移已取消。"
msgstr "❌  Migración de actualización cancelada."

#: hetu/cli/migrate.py:169
msgid "❗ Component有数据删除或类型变更，请修改自动生成的迁移脚本，手动处理这些属性。或使用--drop-data参数直接丢弃这些属性。"
msgstr ""
"❗ Hay eliminación de datos o cambios de tipo en Component. Modifica el "
"script de migración generado automáticamente para manejar estos atributos "
"manualmente. O usa el parámetro --drop-data para descartar estos atributos "
"directamente."

#: hetu/cli/migrate.py:176
msgid "⚠️  确认强制迁移请输 y ，取消请输其他键然后回车："
msgstr ""
"⚠️  Para confirmar la migración forzada, escribe 'y'; para cancelar, escribe"
" cualquier otra tecla y presiona Enter:"

#: hetu/cli/migrate.py:183
#, python-brace-format
msgid "⚠️  正在强制迁移 {instance_name} 服所有表结构，可能会丢失数据..."
msgstr ""
"⚠️  Forzando la migración de todas las estructuras de tabla para la "
"instancia {instance_name}. Puede haber pérdida de datos..."

#: hetu/cli/migrate.py:191
#, python-brace-format
msgid "🧹 正在清除 {instance_name} 服易失数据..."
msgstr "🧹 Limpiando datos volátiles para la instancia {instance_name}..."

#: hetu/cli/migrate.py:199
#, python-brace-format
msgid "🔧 正在重建 {instance_name} 服的索引..."
msgstr "🔧 Reconstruyendo los índices de la instancia {instance_name}..."

#: hetu/cli/migrate.py:206
#, python-brace-format
msgid "✅  {instance_name} 服升级迁移完成！"
msgstr ""
"✅  ¡Migración de actualización completada para la instancia {instance_name}!"

#: hetu/cli/migrate.py:210
msgid "🎉  恭喜！所有数据库表结构均已升级完成！"
msgstr ""
"🎉  ¡Felicidades! Todas las estructuras de tabla de la base de datos han sido"
" actualizadas."

#: hetu/cli/shell.py:70
msgid "call 留给以后的 Endpoint 路径（与 Sandbox.call 同义），跑 System 请用 call_system"
msgstr ""
"call está reservado para futuras rutas de Endpoint (sinónimo de "
"Sandbox.call); para ejecutar un System usa call_system"

#: hetu/cli/shell.py:189
msgid "KeyboardInterrupt（Ctrl+D 退出 shell）"
msgstr "KeyboardInterrupt (Ctrl+D para salir del shell)"

#: hetu/cli/shell.py:229
msgid ""
"HeTu shell：预置 app / client / call_system / get / must_get / insert / upsert "
"/ show，range 用 app.range；支持顶层 await，Ctrl+D 退出"
msgstr ""
"HeTu shell: predefinidos app / client / call_system / get / must_get / "
"insert / upsert / show; para range usa app.range; admite await de nivel "
"superior, Ctrl+D para salir"

#: hetu/cli/shell.py:270
msgid "没有要执行的代码：用 -c CODE、脚本文件，或从 stdin 传入；在终端里直接运行 hetu shell 进交互模式"
msgstr ""
"No hay código que ejecutar: usa -c CODE, un archivo de script o pásalo por "
"stdin; ejecuta hetu shell directamente en una terminal para entrar en modo "
"interactivo"

#: hetu/cli/shell.py:318
#, python-brace-format
msgid "⚠️ shell 退出时取消了 {n} 个还在跑的后台任务"
msgstr ""
"⚠️ al salir del shell se cancelaron {n} tareas en segundo plano que seguían "
"en ejecución"

#: hetu/cli/shell.py:348
msgid ""
"进程内连上后端的 Python shell：预置 call_system / get / must_get / insert / upsert / "
"show 与 app.range，支持顶层 await"
msgstr ""
"Python shell en proceso conectado al Backend: con call_system / get / "
"must_get / insert / upsert / show y app.range predefinidos, admite await de "
"nivel superior"

#: hetu/cli/shell.py:353
msgid "执行这段代码"
msgstr "Ejecutar este código"

#: hetu/cli/shell.py:357
msgid "执行但不提交任何写入"
msgstr "Ejecutar sin confirmar ninguna escritura"

#: hetu/cli/shell.py:370
msgid "要执行的脚本，- 为 stdin；都不给且 stdin 是终端时进交互模式"
msgstr ""
"Script que se va a ejecutar, - para stdin; si no se indica ninguno y stdin "
"es una terminal, entra en modo interactivo"

#: hetu/cli/start.py:73
msgid "启动河图服务"
msgstr "Iniciar el servicio Hetu"

#: hetu/cli/start.py:75
msgid "通过命令行启动参数"
msgstr "A través de parámetros de línea de comandos"

#: hetu/cli/start.py:78
msgid "河图app的py文件，默认 /app/app.py"
msgstr "Archivo py de la app de Hetu, por defecto /app/app.py"

#: hetu/cli/start.py:90
msgid "监听的Websocket端口"
msgstr "Puerto Websocket para escuchar"

#: hetu/cli/start.py:100
msgid "工作进程数，可设为 CPU * 1.2，-1为按CPU核心数自动"
msgstr ""
"Número de procesos de trabajo, se puede establecer en CPU * 1.2, -1 para "
"automático según número de núcleos de CPU"

#: hetu/cli/start.py:109
#, python-format
msgid ""
"开启debug模式，这会启动代码热更新，并显示更多的log信息。如果设置为2，则对框架内核也启用debug模式，会开启Python协程的Debug模式，速度慢90%%。"
msgstr ""
"Activar modo debug, esto iniciará la recarga en caliente de código y "
"mostrará más información de log. Si se establece en 2, también se activa el "
"modo debug para el núcleo del framework, lo que habilita el modo Debug de "
"las corrutinas de Python, reduciendo la velocidad en un 90%%."

#: hetu/cli/start.py:119
msgid "证书目录，如果不设置则使用不安全的连接。不建议这里设置，请外加一层反向https代理。填入auto会生成自签https证书。"
msgstr ""
"Directorio de certificados, si no se establece se usa una conexión insegura."
" No se recomienda configurarlo aquí, añade una capa de proxy inverso https "
"externo. Escribir 'auto' generará un certificado https autofirmado."

#: hetu/cli/start.py:127
msgid "默认crypto层的auth_key，用于握手签名校验。留空则不启用。"
msgstr ""
"Clave de autenticación predeterminada de la capa crypto, para verificación "
"de firma en el handshake. Déjalo vacío para desactivar."

#: hetu/cli/start.py:135
msgid ""
"配置文件模板见CONFIG_TEMPLATE.yml。不给且没用命令行参数时，依次找环境变量 HETU_CONFIG、当前目录的 config.yml"
msgstr ""
"La plantilla del archivo de configuración está en CONFIG_TEMPLATE.yml. Si no"
" se proporciona y no se usan parámetros de línea de comandos, se busca en "
"orden la variable de entorno HETU_CONFIG y el config.yml del directorio "
"actual"

#: hetu/cli/start.py:170
msgid "--app_file是必须参数，或者用--config"
msgstr "--app_file es un parámetro obligatorio, o usa --config"

#: hetu/cli/start.py:173
msgid "--namespace是必须参数，或者用--config"
msgstr "--namespace es un parámetro obligatorio, o usa --config"

#: hetu/cli/start.py:176
msgid "--instance是必须参数，或者用--config"
msgstr "--instance es un parámetro obligatorio, o usa --config"

#: hetu/cli/start.py:235
#, python-brace-format
msgid "ℹ️ {name}, {mode}, {workers} 个工作进程, 管理进程 pid: {pid}"
msgstr ""
"ℹ️ {name}, {mode}, {workers} procesos de trabajo, pid del proceso de "
"gestión: {pid}"

#: hetu/cli/start.py:243
#, python-brace-format
msgid "ℹ️ Python {version} 平台 {platform}"
msgstr "ℹ️ Python {version} plataforma {platform}"

#: hetu/cli/start.py:248
#, python-brace-format
