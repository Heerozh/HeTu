msgstr ""
"Options de configuration non reconnues pour le Backend SQLite : {names}"

#: hetu/data/backend/sqlite/client.py:115
#, python-brace-format
msgid "无法打开SQLite库文件：{path}（{err}）"
msgstr ""
"Impossible d'ouvrir le fichier de base de données SQLite : {path} ({err})"

#: hetu/data/backend/sqlite/commit.py:185
#, python-brace-format
