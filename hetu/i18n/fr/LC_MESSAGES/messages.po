msgstr ""
"Impossible d'écrire directement un bool, convertissez-le d'abord en int / "
"str"

#: hetu/data/backend/sqlite/store.py:79
#, python-brace-format
msgid "不能写入类型为 {type_name} 的值"
msgstr "Impossible d'écrire une valeur de type {type_name}"

#: hetu/data/backend/sqlite/store.py:159
#, python-brace-format
