msgstr ""
"Le format de {path} est en version {version}, alors que cette version de "
"HeTu utilise {expected} : supprimez et recréez les données de développement,"
" ou changez de nom de fichier"

#: hetu/data/backend/sqlite/store.py:200
#, python-brace-format
msgid "{path} 是旧 SQL 后端建的库文件，新的 SQLite 后端不兼容：开发数据请删掉重建，或换个文件名"
msgstr ""
"{path} est un fichier de base de données créé par l'ancien Backend SQL, "
"incompatible avec le nouveau Backend SQLite : supprimez et recréez les "
"données de développement, ou changez de nom de fichier"

#: hetu/data/backend/sqlite/store.py:206
#, python-brace-format
msgid "{path} 不是 HeTu 的库文件，不会往里写：请换个文件名"
msgstr ""
"{path} n'est pas un fichier de base de données HeTu, rien n'y sera écrit : "
"veuillez changer de nom de fichier"

