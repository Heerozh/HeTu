#, python-brace-format
msgid "⚠️ [📞Endpoint] 当前连接数据已删除，可能已被踢出，将断开连接。调用：{ex_info}"
msgstr ""
"⚠️ [📞Endpoint] Les données de connexion actuelles ont été supprimées, peut-"
"être une expulsion, la connexion sera interrompue. Appel : {ex_info}"

#: hetu/endpoint/connection.py:306
#, python-brace-format
msgid ""
"⚠️ [📞Endpoint] [非法操作] 发送消息数过多({sent_msgs} in "
"{sent_elapsed}s)，可能是订阅攻击，将断开连接。调用：{info}"
msgstr ""
"⚠️ [📞Endpoint] [Opération illégale] Trop de messages envoyés ({sent_msgs} en"
