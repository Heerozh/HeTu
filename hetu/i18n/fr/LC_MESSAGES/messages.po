msgstr ""
"Lors de la connexion à la base de données Redis {url}, le serveur a renvoyé "
"une erreur : {error}"

#: hetu/data/backend/redis/client.py:338
#, python-brace-format
msgid ""
"⚠️ [💾Redis] 无权限调用数据库{url}的config_set命令，数据订阅将不起效。可手动设置配置文件：notify-keyspace-"
"events={keyspace}"
msgstr ""
"⚠️ [💾Redis] Pas d'autorisation pour appeler la commande config_set sur la "
"base de données {url}, l'abonnement aux données ne fonctionnera pas. Vous "
"pouvez configurer manuellement le fichier : notify-keyspace-"
"events={keyspace}"

#: hetu/data/backend/redis/client.py:366
msgid "is_synced只能在master上调用"
msgstr "is_synced ne peut être appelé que sur le master"

