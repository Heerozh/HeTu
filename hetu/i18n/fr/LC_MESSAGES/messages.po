msgstr ""
"Les noms de tables SQLite sont insensibles à la casse : {table} et le "
"{existing} existant ne diffèrent que par la casse, veuillez renommer le "
"Component (ou l'instance)"

#: hetu/data/backend/sqlite/store.py:354
#, python-brace-format
msgid "SQLite 列名不区分大小写：{table} 里有只差大小写的字段名（{err}），请改名"
msgstr ""
"Les noms de colonnes SQLite sont insensibles à la casse : dans {table}, "
"certains noms de champs ne diffèrent que par la casse ({err}), veuillez les "
"renommer"

#: hetu/data/backend/sqlite/store.py:373
#, python-brace-format
msgid "SQLite 保留了 sqlite_ 开头的表名（不分大小写），建不了行表 {table}：请给实例换个不以 sqlite_ 开头的名字"
msgstr ""
"SQLite réserve les noms de tables commençant par sqlite_ (insensible à la "
"casse), impossible de créer la table de lignes {table} : veuillez donner à "
"l'instance un nom qui ne commence pas par sqlite_"

#: hetu/data/backend/sqlite/store.py:403 hetu/data/backend/sqlite/store.py:424
#, python-brace-format
msgid "HSET 至少要给一个字段：{key}"
msgstr "HSET nécessite au moins un champ : {key}"

