msgstr ""
"⚠️ [💾SQLite] Les notifications postérieures au curseur {cursor} ont été "
"purgées, une relecture est renvoyée une fois aux canaux abonnés"

#: hetu/data/backend/sqlite/mq.py:196
#, python-brace-format
msgid "🔔 [💾SQLite] 收到订阅更新通知: {channel_name}"
msgstr ""
"🔔 [💾SQLite] Notification de mise à jour d'abonnement reçue : {channel_name}"

#: hetu/data/backend/sqlite/mq.py:213
#, python-brace-format
msgid "⚠️ [💾SQLite] 订阅更新通知来不及处理，丢弃了{seconds}秒前的消息共{count}条"
msgstr ""
"⚠️ [💾SQLite] Notification de mise à jour d'abonnement trop tardive pour être"
