msgid "lua_commit脚本没有初始化，请先调用 post_configure"
msgstr ""
"Le script lua_commit n'est pas initialisé, veuillez d'abord appeler "
"post_configure"

#: hetu/data/backend/redis/client.py:595
#: hetu/data/backend/sqlite/client.py:324
msgid "消息队列只能挂在同类后端的连接上"
msgstr ""
"Une file de messages ne peut être rattachée qu'à une connexion d'un Backend "
"de même type"

#: hetu/data/backend/redis/mq.py:110
#, python-brace-format
msgid "⚠️ [💾Redis] 取消订阅 {count} 个频道失败：{err}"
msgstr "⚠️ [💾Redis] Échec du désabonnement de {count} canaux : {err}"

#: hetu/data/backend/redis/mq.py:129
#, python-brace-format
msgid "🔔 [💾Redis] 收到订阅更新通知: {channel_name}"
msgstr ""
"🔔 [💾Redis] Notification de mise à jour d'abonnement reçue : {channel_name}"

#: hetu/data/backend/redis/mq.py:153
#, python-brace-format
msgid ""
"⚠️ [💾Redis] pubsub 连接断了，{count} 个频道在恢复前收不到通知：挂了多个副本的订阅换到别的副本重订，其余的等它重连后重订、补读"
msgstr ""
"⚠️ [💾Redis] La connexion pubsub est rompue, {count} canaux ne recevront "
"aucune notification avant le rétablissement : les abonnements présents sur "
"plusieurs réplicas sont réabonnés sur un autre réplica, les autres attendent"
" la reconnexion pour se réabonner et relire les messages manqués"

#: hetu/data/backend/redis/mq.py:172
#, python-brace-format
msgid "⚠️ [💾Redis] 订阅更新通知来不及处理，丢弃了{seconds}秒前的消息共{count}条"
msgstr ""
"⚠️ [💾Redis] Les notifications de mise à jour d'abonnement n'ont pas pu être "
"traitées à temps, {count} messages datant de {seconds} secondes ont été "
"abandonnés"

#: hetu/data/backend/redis/worker_keeper.py:186
#: hetu/data/backend/redis/worker_keeper.py:234
msgid "无法获取可用的 Worker ID，所有 ID 均被占用。如果有宕机，请等待ID过期重试"
msgstr ""
"Impossible d'obtenir un ID de Worker disponible, tous les ID sont occupés. "
"En cas de panne, veuillez attendre l'expiration de l'ID et réessayer."

#: hetu/data/backend/redis/worker_keeper.py:205
#, python-brace-format
msgid "[❄️ID] 重新使用已分配的 Worker ID: {worker_id} (通过相同进程码 {node_id} )"
msgstr ""
"[❄️ID] Réutilisation de l'ID de Worker déjà attribué : {worker_id} (via le "
"même code de processus {node_id})"

#: hetu/data/backend/redis/worker_keeper.py:275
#, python-brace-format
msgid ""
"[❄️ID] 续约 Worker ID {worker_id} 失败: "
"租约已不属于本进程（可能因本进程长时间卡住导致租约过期后被其他实例接手），继续发号会产生重复雪花ID，将重启Worker..."
msgstr ""
"[❄️ID] Échec du renouvellement du Worker ID {worker_id} : le bail "
"n'appartient plus à ce processus (peut-être parce que ce processus est resté"
" bloqué trop longtemps, que le bail a expiré puis a été repris par une autre"
" instance). Continuer à émettre des numéros produirait des identifiants "
"snowflake en double, redémarrage du Worker..."

#: hetu/data/backend/redis/worker_keeper.py:281
msgid "Worker ID 续约失败，重启Worker..."
msgstr "Échec du renouvellement de l'ID de Worker, redémarrage du Worker..."

#: hetu/data/backend/sqlite/client.py:66
#, python-brace-format
msgid "SQLite 后端的地址要写成 sqlite:///<库文件路径>，比如 sqlite:///./hetu.db，收到：{dsn}"
msgstr ""
"L'adresse du Backend SQLite doit s'écrire sqlite:///<chemin du fichier de "
"base de données>, par exemple sqlite:///./hetu.db ; reçu : {dsn}"

#: hetu/data/backend/sqlite/client.py:74
#, python-brace-format
msgid "SQLite 后端的地址不支持 ?参数，请去掉 ? 及后面的部分：{dsn}"
msgstr ""
"L'adresse du Backend SQLite ne prend pas en charge les paramètres ? ; "
"veuillez supprimer le ? et ce qui le suit : {dsn}"

#: hetu/data/backend/sqlite/client.py:80
#, python-brace-format
